<section class="scheduling-settings" aria-labelledby="scheduling-settings-title">
    <header class="scheduling-settings__page-header">
        <img src="_content/PTDoc.UI/images/settings/scheduling.svg" alt="" aria-hidden="true" />
        <div>
            <h1 id="scheduling-settings-title">Scheduling &amp; Visit Types</h1>
            <p>Configure appointment types, durations, and availability</p>
        </div>
    </header>

    <div class="scheduling-settings__tabs" role="tablist" aria-label="Scheduling and visit type settings">
        @foreach (var tab in Tabs)
        {
            <button
                type="button"
                id="@tab.TabId"
                class="scheduling-settings__tab @(tab.Tab == _activeTab ? "is-active" : string.Empty)"
                role="tab"
                aria-selected="@(tab.Tab == _activeTab ? "true" : "false")"
                aria-controls="@tab.PanelId"
                @onclick="() => SelectTab(tab.Tab)">
                <img src="@tab.IconPath" alt="" aria-hidden="true" />
                <span>@tab.Label</span>
            </button>
        }
    </div>

    <div
        id="@GetPanelId(_activeTab)"
        class="scheduling-settings__tabpanel"
        role="tabpanel"
        aria-labelledby="@GetTabId(_activeTab)"
        tabindex="0">
        @switch (_activeTab)
        {
            case SchedulingTab.VisitTypes:
                @VisitTypesPanel()
                break;
            case SchedulingTab.ScheduleBlocks:
                @ScheduleBlocksPanel()
                break;
            case SchedulingTab.CalendarBehavior:
                @CalendarBehaviorPanel()
                break;
            case SchedulingTab.ClinicHours:
                @ClinicHoursPanels()
                break;
        }

        @QuickAdminTools()

        <footer class="scheduling-settings__action-bar" aria-label="Scheduling settings actions">
            <button type="button" @onclick="ResetToDefaults">
                <img src="_content/PTDoc.UI/images/settings/reset.svg" alt="" aria-hidden="true" />
                <span>Reset to Default</span>
            </button>
            <button type="button" class="scheduling-settings__muted-action" @onclick="CancelChanges">
                <img src="_content/PTDoc.UI/images/settings/cancel.svg" alt="" aria-hidden="true" />
                <span>Cancel</span>
            </button>
            <button type="button" class="scheduling-settings__save-action" @onclick="SaveChanges">
                <img src="_content/PTDoc.UI/images/settings/save.svg" alt="" aria-hidden="true" />
                <span>Save Changes</span>
            </button>
        </footer>
    </div>
</section>

@code {
    private SchedulingTab _activeTab = SchedulingTab.VisitTypes;
    private string _defaultAppointmentDuration = "45 minutes";
    private string _bufferTime = "15 minutes";
    private string _defaultClinicianView = "Week View";
    private string _defaultAdminView = "All-Day View";
    private string _reminderTiming = "24 hours before";
    private string _intakeSentColor = string.Empty;
    private string _intakeIncompleteColor = string.Empty;
    private string _intakeCompleteColor = string.Empty;
    private bool _allowDoubleBooking;
    private bool _autoConfirmAppointments = true;
    private bool _enableClickToCreate = true;
    private bool _showIntakeStatus = true;
    private bool _allowCancelFromWeekView = true;
    private bool _allowRescheduleFromWeekView = true;
    private bool _sendAppointmentReminders = true;

    private static readonly IReadOnlyList<TabDefinition> Tabs =
    [
        new(SchedulingTab.VisitTypes, "Visit Types", "visit-types-tab", "visit-types-panel", "_content/PTDoc.UI/images/settings/scheduling-tab-visit.svg"),
        new(SchedulingTab.ScheduleBlocks, "Schedule Blocks", "schedule-blocks-tab", "schedule-blocks-panel", "_content/PTDoc.UI/images/settings/scheduling-tab-blocks.svg"),
        new(SchedulingTab.CalendarBehavior, "Calendar Behavior", "calendar-behavior-tab", "calendar-behavior-panel", "_content/PTDoc.UI/images/settings/scheduling-tab-behavior.svg"),
        new(SchedulingTab.ClinicHours, "Clinic Hours", "clinic-hours-tab", "clinic-hours-panel", "_content/PTDoc.UI/images/settings/scheduling-tab-hours.svg")
    ];

    private static readonly IReadOnlyList<ScheduledItem> VisitTypes =
    [
        new("Initial Evaluation", "60 min", "Requires Intake"),
        new("Re-Evaluation", "60 min"),
        new("Daily Treatment", "45 min", "PTA Allowed"),
        new("Progress Note", "45 min", "PTA Allowed"),
        new("Discharge", "30 min"),
        new("Follow-Up", "30 min", "PTA Allowed"),
        new("Group Therapy", "60 min", "PTA Allowed"),
        new("Dry Needling", "30 min"),
        new("Telehealth Visit", "30 min", "PTA Allowed"),
        new("Home Health Visit", "60 min", "PTA Allowed"),
        new("Consultation (Non-Billable)", "15 min"),
        new("No Show", "0 min")
    ];

    private static readonly IReadOnlyList<ScheduledItem> ScheduleBlocks =
    [
        new("Lunch Break", "60 min", "Recurring"),
        new("Admin Time", "30 min", "Recurring"),
        new("Team Meeting", "30 min", "Recurring"),
        new("Break", "15 min")
    ];

    private static readonly IReadOnlyList<string> AppointmentDurationOptions = ["30 minutes", "45 minutes", "60 minutes"];
    private static readonly IReadOnlyList<string> BufferTimeOptions = ["0 minutes", "10 minutes", "15 minutes", "30 minutes"];
    private static readonly IReadOnlyList<string> ClinicianViewOptions = ["Day View", "Week View", "Month View"];
    private static readonly IReadOnlyList<string> AdminViewOptions = ["All-Day View", "Week View", "Month View"];
    private static readonly IReadOnlyList<string> ReminderTimingOptions = ["12 hours before", "24 hours before", "48 hours before"];

    private void SelectTab(SchedulingTab tab) => _activeTab = tab;

    private RenderFragment VisitTypesPanel() => @<section class="scheduling-panel" aria-labelledby="visit-types-heading">
        @PanelHeader("visit-types-heading", "Visit Types", "Configure appointment types and durations", "_content/PTDoc.UI/images/settings/scheduling.svg", "Add Visit Type", OpenAddVisitType)
        <div class="scheduled-item-list">
            @foreach (var item in VisitTypes)
            {
                @ScheduledItemRow(item, "visit type")
            }
        </div>
    </section>;

    private RenderFragment ScheduleBlocksPanel() => @<section class="scheduling-panel" aria-labelledby="schedule-blocks-heading">
        @PanelHeader("schedule-blocks-heading", "Schedule Blocks", "Configure schedule blocks for admin, lunch, meetings, etc.", "_content/PTDoc.UI/images/settings/scheduling-blocks.svg", "Add Schedule Block", OpenAddScheduleBlock)
        <div class="scheduled-item-list">
            @foreach (var item in ScheduleBlocks)
            {
                @ScheduledItemRow(item, "schedule block")
            }
        </div>
    </section>;

    private RenderFragment CalendarBehaviorPanel() => @<section class="scheduling-panel scheduling-panel--form" aria-labelledby="calendar-behavior-heading">
        @PanelHeader("calendar-behavior-heading", "Calendar Behavior", "Set default durations and buffer times", "_content/PTDoc.UI/images/settings/scheduling-behavior.svg")

        <div class="scheduling-settings__two-column-fields">
            @SelectField("default-appointment-duration", "Default Appointment Duration", _defaultAppointmentDuration, AppointmentDurationOptions, value => _defaultAppointmentDuration = value)
            @SelectField("buffer-time", "Buffer Time Between Appointments", _bufferTime, BufferTimeOptions, value => _bufferTime = value)
        </div>

        <div class="calendar-setting-list">
            @ToggleSetting("Allow Double Booking", "Permit overlapping appointments for the same clinician", _allowDoubleBooking, () => _allowDoubleBooking = !_allowDoubleBooking)
            @ToggleSetting("Auto-Confirm Appointments", "Automatically confirm new appointments without manual review", _autoConfirmAppointments, () => _autoConfirmAppointments = !_autoConfirmAppointments)
            @ToggleSetting("Enable Click to Create", "Allow users to create appointments by clicking on the calendar", _enableClickToCreate, () => _enableClickToCreate = !_enableClickToCreate)
            @ToggleSetting("Show Intake Status", "Display intake status on appointments", _showIntakeStatus, () => _showIntakeStatus = !_showIntakeStatus)
            @ToggleSetting("Allow Cancel from Week View", "Allow users to cancel appointments from the week view", _allowCancelFromWeekView, () => _allowCancelFromWeekView = !_allowCancelFromWeekView)
            @ToggleSetting("Allow Reschedule from Week View", "Allow users to reschedule appointments from the week view", _allowRescheduleFromWeekView, () => _allowRescheduleFromWeekView = !_allowRescheduleFromWeekView)
        </div>

        <div class="scheduling-settings__two-column-fields">
            @SelectField("default-clinician-view", "Default Clinician View", _defaultClinicianView, ClinicianViewOptions, value => _defaultClinicianView = value)
            @SelectField("default-admin-view", "Default Admin View", _defaultAdminView, AdminViewOptions, value => _defaultAdminView = value)
        </div>

        <div class="scheduling-settings__color-fields">
            @BlankField("intake-sent-color", "Intake Sent Color", _intakeSentColor, value => _intakeSentColor = value)
            @BlankField("intake-incomplete-color", "Intake Incomplete Color", _intakeIncompleteColor, value => _intakeIncompleteColor = value)
            @BlankField("intake-complete-color", "Intake Complete Color", _intakeCompleteColor, value => _intakeCompleteColor = value)
        </div>
    </section>;

    private RenderFragment ClinicHoursPanels() => @<text>
        <section class="scheduling-panel clinic-hours" aria-labelledby="clinic-hours-heading">
            @PanelHeader("clinic-hours-heading", "Clinic Hours", "Set operating hours and break times", "_content/PTDoc.UI/images/settings/scheduling-hours.svg")
            <div class="clinic-hours__labels">
                <span>Clinic Start Time</span>
                <span>Clinic End Time</span>
                <span>Lunch Break Start</span>
                <span>Lunch Break End</span>
            </div>
        </section>

        <section class="scheduling-panel scheduling-panel--form" aria-labelledby="appointment-reminders-heading">
            @PanelHeader("appointment-reminders-heading", "Appointment Reminders", "Configure automatic patient reminders", "_content/PTDoc.UI/images/settings/scheduling-reminders.svg")
            @ToggleSetting("Send Appointment Reminders", "Automatically send reminders to patients", _sendAppointmentReminders, () => _sendAppointmentReminders = !_sendAppointmentReminders)
            @SelectField("send-reminder", "Send Reminder", _reminderTiming, ReminderTimingOptions, value => _reminderTiming = value)
        </section>
    </text>;

    private RenderFragment PanelHeader(string id, string title, string description, string iconPath, string? actionLabel = null, Action? action = null) => @<header class="scheduling-panel__header">
        <div class="scheduling-panel__heading">
            <div class="scheduling-panel__title">
                <img src="@iconPath" alt="" aria-hidden="true" />
                <h2 id="@id">@title</h2>
            </div>
            <p>@description</p>
        </div>
        @if (actionLabel is not null && action is not null)
        {
            <button type="button" class="scheduling-panel__add" @onclick="action">
                <img src="_content/PTDoc.UI/images/settings/scheduling-add.svg" alt="" aria-hidden="true" />
                <span>@actionLabel</span>
            </button>
        }
    </header>;

    private RenderFragment ScheduledItemRow(ScheduledItem item, string itemType) => @<article class="scheduled-item">
        <div class="scheduled-item__copy">
            <strong>@item.Name</strong>
            <div class="scheduled-item__metadata">
                <span class="scheduled-item__duration">
                    <img src="_content/PTDoc.UI/images/settings/scheduling-clock.svg" alt="" aria-hidden="true" />
                    <span>@item.Duration</span>
                </span>
                @if (item.Badge is not null)
                {
                    <span class="scheduled-item__badge">@item.Badge</span>
                }
            </div>
        </div>
        <div class="scheduled-item__actions">
            <button type="button" aria-label="Edit @item.Name @itemType" @onclick="() => EditScheduledItem(item)">
                <img src="_content/PTDoc.UI/images/settings/scheduling-edit.svg" alt="" aria-hidden="true" />
            </button>
            <button type="button" aria-label="Delete @item.Name @itemType" @onclick="() => DeleteScheduledItem(item)">
                <img src="_content/PTDoc.UI/images/settings/scheduling-delete.svg" alt="" aria-hidden="true" />
            </button>
        </div>
    </article>;

    private RenderFragment ToggleSetting(string label, string description, bool isEnabled, Action toggle) => @<div class="calendar-setting-row">
        <div>
            <strong>@label</strong>
            <p>@description</p>
        </div>
        <button
            type="button"
            class="scheduling-switch @(isEnabled ? "is-enabled" : string.Empty)"
            role="switch"
            aria-checked="@(isEnabled ? "true" : "false")"
            aria-label="@label"
            @onclick="toggle">
            <span aria-hidden="true"></span>
        </button>
    </div>;

    private RenderFragment SelectField(string id, string label, string value, IReadOnlyList<string> options, Action<string> valueChanged) => @<div class="scheduling-field">
        <label for="@id">@label</label>
        <select id="@id" value="@value" @onchange="eventArgs => valueChanged(eventArgs.Value?.ToString() ?? string.Empty)">
            @foreach (var option in options)
            {
                <option value="@option">@option</option>
            }
        </select>
    </div>;

    private RenderFragment BlankField(string id, string label, string value, Action<string> valueChanged) => @<div class="scheduling-field">
        <label for="@id">@label</label>
        <input id="@id" type="text" aria-label="@label" value="@value" @oninput="eventArgs => valueChanged(eventArgs.Value?.ToString() ?? string.Empty)" />
    </div>;

    private RenderFragment QuickAdminTools() => @<section class="scheduling-panel quick-admin-tools" aria-labelledby="scheduling-quick-admin-heading">
        <header class="scheduling-panel__header">
            <div class="scheduling-panel__heading">
                <div class="scheduling-panel__title">
                    <img src="_content/PTDoc.UI/images/settings/scheduling-quick-admin.svg" alt="" aria-hidden="true" />
                    <h2 id="scheduling-quick-admin-heading">Quick Admin Tools</h2>
                </div>
                <p>Additional administrative features and settings</p>
            </div>
        </header>
        <div class="quick-admin-tools__items">
            @QuickAdminRow("Auto Check-In Messaging", "Configure automated intake form delivery", "_content/PTDoc.UI/images/settings/quick-message.svg", OpenAutoCheckInMessaging)
            @QuickAdminRow("Kiosk Check-In", "Set up and manage kiosk check-in stations", "_content/PTDoc.UI/images/settings/quick-kiosk.svg", OpenKioskCheckIn)
        </div>
    </section>;

    private RenderFragment QuickAdminRow(string label, string description, string iconPath, Action action) => @<button type="button" class="quick-admin-tools__row" @onclick="action">
        <span class="quick-admin-tools__copy">
            <span class="quick-admin-tools__icon"><img src="@iconPath" alt="" aria-hidden="true" /></span>
            <span><strong>@label</strong><small>@description</small></span>
        </span>
        <img class="quick-admin-tools__chevron" src="_content/PTDoc.UI/images/settings/chevron.svg" alt="" aria-hidden="true" />
    </button>;

    private static string GetTabId(SchedulingTab tab) => Tabs.Single(item => item.Tab == tab).TabId;

    private static string GetPanelId(SchedulingTab tab) => Tabs.Single(item => item.Tab == tab).PanelId;

    private void ResetToDefaults()
    {
        _defaultAppointmentDuration = "45 minutes";
        _bufferTime = "15 minutes";
        _defaultClinicianView = "Week View";
        _defaultAdminView = "All-Day View";
        _reminderTiming = "24 hours before";
        _intakeSentColor = string.Empty;
        _intakeIncompleteColor = string.Empty;
        _intakeCompleteColor = string.Empty;
        _allowDoubleBooking = false;
        _autoConfirmAppointments = true;
        _enableClickToCreate = true;
        _showIntakeStatus = true;
        _allowCancelFromWeekView = true;
        _allowRescheduleFromWeekView = true;
        _sendAppointmentReminders = true;
    }

    private void CancelChanges() => ResetToDefaults();

    private void SaveChanges()
    {
        // TODO: Persist scheduling preferences when an application service contract is available.
    }

    private void OpenAddVisitType()
    {
        // TODO: Connect the visible action to the product-standard visit-type editor.
    }

    private void OpenAddScheduleBlock()
    {
        // TODO: Connect the visible action to the product-standard schedule-block editor.
    }

    private void EditScheduledItem(ScheduledItem item)
    {
        // TODO: Connect row editing once the scheduling settings contract is available.
    }

    private void DeleteScheduledItem(ScheduledItem item)
    {
        // TODO: Connect row deletion once product-standard confirmation behavior is defined.
    }

    private void OpenAutoCheckInMessaging()
    {
        // TODO: Connect Auto Check-In Messaging navigation.
    }

    private void OpenKioskCheckIn()
    {
        // TODO: Connect Kiosk Check-In navigation.
    }

    private enum SchedulingTab
    {
        VisitTypes,
        ScheduleBlocks,
        CalendarBehavior,
        ClinicHours
    }

    private sealed record TabDefinition(
        SchedulingTab Tab,
        string Label,
        string TabId,
        string PanelId,
        string IconPath);

    private sealed record ScheduledItem(string Name, string Duration, string? Badge = null);
}
