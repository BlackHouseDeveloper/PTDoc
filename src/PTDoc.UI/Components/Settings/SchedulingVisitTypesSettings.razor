@using PTDoc.Application.Settings
@using PTDoc.Core.Models
@inject IServiceProvider Services
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IAsyncDisposable

<section class="scheduling-settings" aria-labelledby="scheduling-settings-title" aria-busy="@_isBusy" @ref="_root">
    <header class="scheduling-settings__page-header">
        <img src="_content/PTDoc.UI/images/settings/scheduling.svg" alt="" aria-hidden="true" />
        <div>
            <h1 id="scheduling-settings-title">Scheduling &amp; Visit Types</h1>
            <p>Configure appointment types, durations, and availability</p>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <div class="scheduling-settings__status @(_statusIsError ? "is-error" : "is-success")" role="@(_statusIsError ? "alert" : "status")">@_statusMessage</div>
    }
    @if (!_canMutate)
    {
        <div class="scheduling-settings__status" role="status">Owner access is read-only. An Administrator must change scheduling configuration.</div>
    }

    <div class="scheduling-settings__tabs" role="tablist" aria-label="Scheduling and visit type settings">
        <button
            @ref="_visitTypesTab"
            type="button"
            id="visit-types-tab"
            class="scheduling-settings__tab @(_activeTab == SchedulingTab.VisitTypes ? "is-active" : string.Empty)"
            role="tab"
            aria-selected="@(_activeTab == SchedulingTab.VisitTypes ? "true" : "false")"
            aria-controls="scheduling-settings-panel"
            tabindex="@(_activeTab == SchedulingTab.VisitTypes ? "0" : "-1")"
            @onclick="() => SelectTab(SchedulingTab.VisitTypes)"
            @onkeydown="eventArgs => HandleTabKeyDownAsync(eventArgs, SchedulingTab.VisitTypes)">
            <img src="_content/PTDoc.UI/images/settings/scheduling-tab-visit.svg" alt="" aria-hidden="true" />
            <span>Visit Types</span>
        </button>
        <button
            @ref="_scheduleBlocksTab"
            type="button"
            id="schedule-blocks-tab"
            class="scheduling-settings__tab @(_activeTab == SchedulingTab.ScheduleBlocks ? "is-active" : string.Empty)"
            role="tab"
            aria-selected="@(_activeTab == SchedulingTab.ScheduleBlocks ? "true" : "false")"
            aria-controls="scheduling-settings-panel"
            tabindex="@(_activeTab == SchedulingTab.ScheduleBlocks ? "0" : "-1")"
            @onclick="() => SelectTab(SchedulingTab.ScheduleBlocks)"
            @onkeydown="eventArgs => HandleTabKeyDownAsync(eventArgs, SchedulingTab.ScheduleBlocks)">
            <img src="_content/PTDoc.UI/images/settings/scheduling-tab-blocks.svg" alt="" aria-hidden="true" />
            <span>Schedule Blocks</span>
        </button>
        <button
            @ref="_calendarBehaviorTab"
            type="button"
            id="calendar-behavior-tab"
            class="scheduling-settings__tab @(_activeTab == SchedulingTab.CalendarBehavior ? "is-active" : string.Empty)"
            role="tab"
            aria-selected="@(_activeTab == SchedulingTab.CalendarBehavior ? "true" : "false")"
            aria-controls="scheduling-settings-panel"
            tabindex="@(_activeTab == SchedulingTab.CalendarBehavior ? "0" : "-1")"
            @onclick="() => SelectTab(SchedulingTab.CalendarBehavior)"
            @onkeydown="eventArgs => HandleTabKeyDownAsync(eventArgs, SchedulingTab.CalendarBehavior)">
            <img src="_content/PTDoc.UI/images/settings/scheduling-tab-behavior.svg" alt="" aria-hidden="true" />
            <span>Calendar Behavior</span>
        </button>
        <button
            @ref="_clinicHoursTab"
            type="button"
            id="clinic-hours-tab"
            class="scheduling-settings__tab @(_activeTab == SchedulingTab.ClinicHours ? "is-active" : string.Empty)"
            role="tab"
            aria-selected="@(_activeTab == SchedulingTab.ClinicHours ? "true" : "false")"
            aria-controls="scheduling-settings-panel"
            tabindex="@(_activeTab == SchedulingTab.ClinicHours ? "0" : "-1")"
            @onclick="() => SelectTab(SchedulingTab.ClinicHours)"
            @onkeydown="eventArgs => HandleTabKeyDownAsync(eventArgs, SchedulingTab.ClinicHours)">
            <img src="_content/PTDoc.UI/images/settings/scheduling-tab-hours.svg" alt="" aria-hidden="true" />
            <span>Clinic Hours</span>
        </button>
    </div>

    <div
        id="scheduling-settings-panel"
        class="scheduling-settings__tabpanel"
        role="tabpanel"
        aria-labelledby="@GetTabId(_activeTab)">
        @switch (_activeTab)
        {
            case SchedulingTab.VisitTypes:
                @VisitTypesPanel()
                break;
            case SchedulingTab.ScheduleBlocks:
                @ScheduleBlocksPanel()
                break;
            case SchedulingTab.CalendarBehavior:
                @CalendarBehaviorPanel()
                break;
            case SchedulingTab.ClinicHours:
                @ClinicHoursPanels()
                break;
        }

        @QuickAdminTools()

        <footer class="scheduling-settings__action-bar" aria-label="Scheduling settings actions">
            <button type="button" @onclick="ResetToDefaults" disabled="@ControlsDisabled">
                <img src="_content/PTDoc.UI/images/settings/reset.svg" alt="" aria-hidden="true" />
                <span>Reset to Default</span>
            </button>
            <button type="button" class="scheduling-settings__muted-action" @onclick="CancelChanges" disabled="@_isBusy">
                <img src="_content/PTDoc.UI/images/settings/cancel.svg" alt="" aria-hidden="true" />
                <span>Cancel</span>
            </button>
            <button type="button" class="scheduling-settings__save-action" @onclick="SaveChanges" disabled="@ControlsDisabled">
                <img src="_content/PTDoc.UI/images/settings/save.svg" alt="" aria-hidden="true" />
                <span>Save Changes</span>
            </button>
        </footer>
    </div>

    @if (_editor is not null)
    {
        <div class="scheduling-dialog-backdrop" @onclick="CloseEditor">
            <section class="scheduling-dialog" role="dialog" aria-modal="true" aria-labelledby="scheduling-editor-title" @onclick:stopPropagation="true">
                <h2 id="scheduling-editor-title">@(_editor.Kind == EditorKind.VisitType ? "Visit Type" : "Schedule Block")</h2>
                <label>Name <input value="@_editor.Name" @oninput="e => _editor.Name = e.Value?.ToString() ?? string.Empty" /></label>
                @if (_editor.Kind == EditorKind.VisitType)
                {
                    <label>Stable code <input value="@_editor.Code" @oninput="e => _editor.Code = e.Value?.ToString() ?? string.Empty" /></label>
                    <label>Duration (minutes) <input type="number" min="0" max="480" value="@_editor.DurationMinutes" @oninput="e => _editor.DurationMinutes = ParseInt(e.Value, 0)" /></label>
                    <label><input type="checkbox" checked="@_editor.RequiresIntake" @onchange="e => _editor.RequiresIntake = ParseBool(e.Value)" /> Requires intake</label>
                    <label><input type="checkbox" checked="@_editor.PtaAllowed" @onchange="e => _editor.PtaAllowed = ParseBool(e.Value)" /> PTA allowed</label>
                    <label><input type="checkbox" checked="@_editor.IsBillable" @onchange="e => _editor.IsBillable = ParseBool(e.Value)" /> Billable</label>
                }
                else
                {
                    <label>Reason code <input value="@_editor.ReasonCode" @oninput="e => _editor.ReasonCode = e.Value?.ToString() ?? string.Empty" /></label>
                    <label>Start <input type="time" value="@FormatTime(_editor.StartTime)" @onchange="e => _editor.StartTime = ParseTime(e.Value, new TimeOnly(12, 0))" /></label>
                    <label>End <input type="time" value="@FormatTime(_editor.EndTime)" @onchange="e => _editor.EndTime = ParseTime(e.Value, new TimeOnly(13, 0))" /></label>
                    <label><input type="checkbox" checked="@_editor.IsRecurring" @onchange="e => _editor.IsRecurring = ParseBool(e.Value)" /> Recurring weekdays</label>
                }
                <div class="scheduling-dialog__actions">
                    <button type="button" @onclick="CloseEditor">Cancel</button>
                    <button type="button" class="scheduling-settings__save-action" @onclick="SaveEditor" disabled="@ControlsDisabled">Save</button>
                </div>
            </section>
        </div>
    }

    @if (_pendingDeactivation is not null)
    {
        <div class="scheduling-dialog-backdrop">
            <section class="scheduling-dialog" role="alertdialog" aria-modal="true" aria-labelledby="deactivate-title">
                <h2 id="deactivate-title">Deactivate @_pendingDeactivation.Name?</h2>
                <p>Historical appointments will keep this reference, but it will no longer be available for new scheduling.</p>
                <div class="scheduling-dialog__actions">
                    <button type="button" @onclick="() => _pendingDeactivation = null">Cancel</button>
                    <button type="button" class="scheduling-settings__save-action" @onclick="ConfirmDeactivation" disabled="@ControlsDisabled">Deactivate</button>
                </div>
            </section>
        </div>
    }
</section>

@code {
    private SchedulingTab _activeTab = SchedulingTab.VisitTypes;
    private ElementReference _root;
    private ElementReference _visitTypesTab;
    private ElementReference _scheduleBlocksTab;
    private ElementReference _calendarBehaviorTab;
    private ElementReference _clinicHoursTab;
    private IJSObjectReference? _keyboardModule;
    private string _defaultAppointmentDuration = "45 minutes";
    private string _bufferTime = "15 minutes";
    private string _defaultClinicianView = "Week View";
    private string _defaultAdminView = "All-Day View";
    private string _reminderTiming = "24 hours before";
    private string _intakeSentColor = string.Empty;
    private string _intakeIncompleteColor = string.Empty;
    private string _intakeCompleteColor = string.Empty;
    private bool _allowDoubleBooking;
    private bool _autoConfirmAppointments = true;
    private bool _enableClickToCreate = true;
    private bool _showIntakeStatus = true;
    private bool _allowCancelFromWeekView = true;
    private bool _allowRescheduleFromWeekView = true;
    private bool _sendAppointmentReminders = true;
    private bool _isBusy;
    private bool _canMutate = true;
    private bool _statusIsError;
    private string? _statusMessage;
    private string _clinicTimeZoneId = "America/Los_Angeles";
    private long _clinicVersion;
    private long _preferencesVersion;
    private ISchedulingAdministrationService? _schedulingService;
    private EditorDraft? _editor;
    private ScheduledItem? _pendingDeactivation;
    private List<ClinicHourDraft> _clinicHours = CreateDefaultHours();
    private SchedulingSnapshot _snapshot = SchedulingSnapshot.Default;
    private bool ControlsDisabled => _isBusy || !_canMutate;

    private static readonly TabDefinition[] Tabs =
    [
        new(SchedulingTab.VisitTypes, "visit-types-tab"),
        new(SchedulingTab.ScheduleBlocks, "schedule-blocks-tab"),
        new(SchedulingTab.CalendarBehavior, "calendar-behavior-tab"),
        new(SchedulingTab.ClinicHours, "clinic-hours-tab")
    ];

    private List<ScheduledItem> _visitTypes =
    [
        .. SchedulingDefaults.VisitTypes.Select(item => ScheduledItem.FromVisitType(new VisitTypeDto(
            Guid.Empty, item.Code, item.Name, item.DurationMinutes, item.RequiresIntake,
            item.PtaAllowed, item.IsBillable, true, item.DisplayOrder, 0)))
    ];

    private List<ScheduledItem> _scheduleBlocks =
    [
        new(Guid.Empty, EditorKind.ScheduleBlock, "Lunch Break", "60 min", "Recurring", true, 0),
        new(Guid.Empty, EditorKind.ScheduleBlock, "Admin Time", "30 min", "Recurring", true, 0),
        new(Guid.Empty, EditorKind.ScheduleBlock, "Team Meeting", "30 min", "Recurring", true, 0),
        new(Guid.Empty, EditorKind.ScheduleBlock, "Break", "15 min", null, true, 0)
    ];

    private static readonly IReadOnlyList<string> AppointmentDurationOptions = ["30 minutes", "45 minutes", "60 minutes"];
    private static readonly IReadOnlyList<string> BufferTimeOptions = ["0 minutes", "10 minutes", "15 minutes", "30 minutes"];
    private static readonly IReadOnlyList<string> ClinicianViewOptions = ["Day View", "Week View", "Month View"];
    private static readonly IReadOnlyList<string> AdminViewOptions = ["All-Day View", "Week View", "Month View"];
    private static readonly IReadOnlyList<string> ReminderTimingOptions = ["12 hours before", "24 hours before", "48 hours before"];

    protected override async Task OnInitializedAsync()
    {
        if (Services.GetService(typeof(Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider))
            is Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider authenticationStateProvider)
        {
            var authenticationState = await authenticationStateProvider.GetAuthenticationStateAsync();
            _canMutate = authenticationState.User.IsInRole(PTDoc.Application.Services.Roles.Admin);
        }

        _schedulingService = Services.GetService(typeof(ISchedulingAdministrationService)) as ISchedulingAdministrationService;
        if (_schedulingService is null)
        {
            CaptureSnapshot();
            return;
        }

        _isBusy = true;
        try
        {
            var visitsTask = _schedulingService.GetVisitTypesAsync(Guid.Empty, true);
            var blocksTask = _schedulingService.GetScheduleBlocksAsync(Guid.Empty);
            var preferencesTask = _schedulingService.GetPreferencesAsync(Guid.Empty);
            var hoursTask = _schedulingService.GetClinicHoursAsync(Guid.Empty);
            await Task.WhenAll(visitsTask, blocksTask, preferencesTask, hoursTask);

            _visitTypes = (await visitsTask).Select(ScheduledItem.FromVisitType).ToList();
            _scheduleBlocks = (await blocksTask).Select(ScheduledItem.FromBlock).ToList();
            ApplyPreferences(await preferencesTask);
            ApplyClinicHours(await hoursTask);
            CaptureSnapshot();
        }
        catch (Exception)
        {
            ShowStatus("Scheduling settings could not be loaded. Documented defaults are shown for retry.", true);
            CaptureSnapshot();
        }
        finally
        {
            _isBusy = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _keyboardModule = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/PTDoc.UI/js/settings-keyboard.js");
            await _keyboardModule.InvokeVoidAsync("attachKeyboardGuards", _root);
        }
        catch (Exception)
        {
            // Blazor handlers still provide selection when interop is unavailable during
            // prerender, component tests, or circuit teardown.
        }
    }

    private void SelectTab(SchedulingTab tab) => _activeTab = tab;

    private async Task HandleTabKeyDownAsync(KeyboardEventArgs eventArgs, SchedulingTab currentTab)
    {
        var currentIndex = Array.FindIndex(Tabs, tab => tab.Tab == currentTab);
        if (currentIndex < 0)
        {
            return;
        }

        SchedulingTab? targetTab = eventArgs.Key switch
        {
            "ArrowRight" => Tabs[(currentIndex + 1) % Tabs.Length].Tab,
            "ArrowLeft" => Tabs[(currentIndex - 1 + Tabs.Length) % Tabs.Length].Tab,
            "Home" => Tabs[0].Tab,
            "End" => Tabs[^1].Tab,
            _ => null
        };

        if (targetTab is null)
        {
            return;
        }

        SelectTab(targetTab.Value);
        await GetTabReference(targetTab.Value).FocusAsync();
    }

    private ElementReference GetTabReference(SchedulingTab tab) => tab switch
    {
        SchedulingTab.VisitTypes => _visitTypesTab,
        SchedulingTab.ScheduleBlocks => _scheduleBlocksTab,
        SchedulingTab.CalendarBehavior => _calendarBehaviorTab,
        SchedulingTab.ClinicHours => _clinicHoursTab,
        _ => throw new ArgumentOutOfRangeException(nameof(tab), tab, null)
    };

    private RenderFragment VisitTypesPanel() => @<section class="scheduling-panel" aria-labelledby="visit-types-heading">
        @PanelHeader("visit-types-heading", "Visit Types", "Configure appointment types and durations", "_content/PTDoc.UI/images/settings/scheduling.svg", "Add Visit Type", OpenAddVisitType)
        <div class="scheduled-item-list">
            @foreach (var item in _visitTypes.Where(item => item.IsActive))
            {
                @ScheduledItemRow(item, "visit type")
            }
        </div>
    </section>;

    private RenderFragment ScheduleBlocksPanel() => @<section class="scheduling-panel" aria-labelledby="schedule-blocks-heading">
        @PanelHeader("schedule-blocks-heading", "Schedule Blocks", "Configure schedule blocks for admin, lunch, meetings, etc.", "_content/PTDoc.UI/images/settings/scheduling-blocks.svg", "Add Schedule Block", OpenAddScheduleBlock)
        <div class="scheduled-item-list">
            @foreach (var item in _scheduleBlocks.Where(item => item.IsActive))
            {
                @ScheduledItemRow(item, "schedule block")
            }
        </div>
    </section>;

    private RenderFragment CalendarBehaviorPanel() => @<section class="scheduling-panel scheduling-panel--form" aria-labelledby="calendar-behavior-heading">
        @PanelHeader("calendar-behavior-heading", "Calendar Behavior", "Set default durations and buffer times", "_content/PTDoc.UI/images/settings/scheduling-behavior.svg")

        <div class="scheduling-settings__two-column-fields">
            @SelectField("default-appointment-duration", "Default Appointment Duration", _defaultAppointmentDuration, AppointmentDurationOptions, value => _defaultAppointmentDuration = value)
            @SelectField("buffer-time", "Buffer Time Between Appointments", _bufferTime, BufferTimeOptions, value => _bufferTime = value)
        </div>

        <div class="calendar-setting-list">
            @ToggleSetting("Allow Double Booking", "Permit overlapping appointments for the same clinician", _allowDoubleBooking, () => _allowDoubleBooking = !_allowDoubleBooking)
            @ToggleSetting("Auto-Confirm Appointments", "Automatically confirm new appointments without manual review", _autoConfirmAppointments, () => _autoConfirmAppointments = !_autoConfirmAppointments)
            @ToggleSetting("Enable Click to Create", "Allow users to create appointments by clicking on the calendar", _enableClickToCreate, () => _enableClickToCreate = !_enableClickToCreate)
            @ToggleSetting("Show Intake Status", "Display intake status on appointments", _showIntakeStatus, () => _showIntakeStatus = !_showIntakeStatus)
            @ToggleSetting("Allow Cancel from Week View", "Allow users to cancel appointments from the week view", _allowCancelFromWeekView, () => _allowCancelFromWeekView = !_allowCancelFromWeekView)
            @ToggleSetting("Allow Reschedule from Week View", "Allow users to reschedule appointments from the week view", _allowRescheduleFromWeekView, () => _allowRescheduleFromWeekView = !_allowRescheduleFromWeekView)
        </div>

        <div class="scheduling-settings__two-column-fields">
            @SelectField("default-clinician-view", "Default Clinician View", _defaultClinicianView, ClinicianViewOptions, value => _defaultClinicianView = value)
            @SelectField("default-admin-view", "Default Admin View", _defaultAdminView, AdminViewOptions, value => _defaultAdminView = value)
        </div>

        <div class="scheduling-settings__color-fields">
            @BlankField("intake-sent-color", "Intake Sent Color", _intakeSentColor, value => _intakeSentColor = value)
            @BlankField("intake-incomplete-color", "Intake Incomplete Color", _intakeIncompleteColor, value => _intakeIncompleteColor = value)
            @BlankField("intake-complete-color", "Intake Complete Color", _intakeCompleteColor, value => _intakeCompleteColor = value)
        </div>
    </section>;

    private RenderFragment ClinicHoursPanels() => @<text>
        <section class="scheduling-panel clinic-hours" aria-labelledby="clinic-hours-heading">
            @PanelHeader("clinic-hours-heading", "Clinic Hours", "Set operating hours and break times", "_content/PTDoc.UI/images/settings/scheduling-hours.svg")
            <div class="clinic-hours__timezone">
                <label for="clinic-time-zone">Clinic time zone</label>
                <input id="clinic-time-zone" value="@_clinicTimeZoneId" disabled="@ControlsDisabled" @oninput="e => _clinicTimeZoneId = e.Value?.ToString() ?? string.Empty" />
            </div>
            <div class="clinic-hours__rows">
                @foreach (var hour in _clinicHours.OrderBy(item => item.DayOfWeek))
                {
                    <div class="clinic-hours__row">
                        <label><input type="checkbox" checked="@hour.IsOpen" disabled="@ControlsDisabled" @onchange="e => hour.IsOpen = ParseBool(e.Value)" /> @hour.DayOfWeek</label>
                        <label>Start <input type="time" disabled="@(ControlsDisabled || !hour.IsOpen)" value="@FormatNullableTime(hour.StartLocalTime)" @onchange="e => hour.StartLocalTime = ParseNullableTime(e.Value)" /></label>
                        <label>End <input type="time" disabled="@(ControlsDisabled || !hour.IsOpen)" value="@FormatNullableTime(hour.EndLocalTime)" @onchange="e => hour.EndLocalTime = ParseNullableTime(e.Value)" /></label>
                        <label>Lunch start <input type="time" disabled="@(ControlsDisabled || !hour.IsOpen)" value="@FormatNullableTime(hour.LunchStartLocalTime)" @onchange="e => hour.LunchStartLocalTime = ParseNullableTime(e.Value)" /></label>
                        <label>Lunch end <input type="time" disabled="@(ControlsDisabled || !hour.IsOpen)" value="@FormatNullableTime(hour.LunchEndLocalTime)" @onchange="e => hour.LunchEndLocalTime = ParseNullableTime(e.Value)" /></label>
                    </div>
                }
            </div>
        </section>

        <section class="scheduling-panel scheduling-panel--form" aria-labelledby="appointment-reminders-heading">
            @PanelHeader("appointment-reminders-heading", "Appointment Reminders", "Configure automatic patient reminders", "_content/PTDoc.UI/images/settings/scheduling-reminders.svg")
            @ToggleSetting("Send Appointment Reminders", "Automatically send reminders to patients", _sendAppointmentReminders, () => _sendAppointmentReminders = !_sendAppointmentReminders)
            @SelectField("send-reminder", "Send Reminder", _reminderTiming, ReminderTimingOptions, value => _reminderTiming = value)
        </section>
    </text>;

    private RenderFragment PanelHeader(string id, string title, string description, string iconPath, string? actionLabel = null, Action? action = null) => @<header class="scheduling-panel__header">
        <div class="scheduling-panel__heading">
            <div class="scheduling-panel__title">
                <img src="@iconPath" alt="" aria-hidden="true" />
                <h2 id="@id">@title</h2>
            </div>
            <p>@description</p>
        </div>
        @if (actionLabel is not null && action is not null)
        {
            <button type="button" class="scheduling-panel__add" @onclick="action" disabled="@ControlsDisabled">
                <img src="_content/PTDoc.UI/images/settings/scheduling-add.svg" alt="" aria-hidden="true" />
                <span>@actionLabel</span>
            </button>
        }
    </header>;

    private RenderFragment ScheduledItemRow(ScheduledItem item, string itemType) => @<article class="scheduled-item">
        <div class="scheduled-item__copy">
            <strong>@item.Name</strong>
            <div class="scheduled-item__metadata">
                <span class="scheduled-item__duration">
                    <img src="_content/PTDoc.UI/images/settings/scheduling-clock.svg" alt="" aria-hidden="true" />
                    <span>@item.Duration</span>
                </span>
                @if (item.Badge is not null)
                {
                    <span class="scheduled-item__badge">@item.Badge</span>
                }
            </div>
        </div>
        <div class="scheduled-item__actions">
            <button type="button" aria-label="Edit @item.Name @itemType" @onclick="() => EditScheduledItem(item)" disabled="@ControlsDisabled">
                <img src="_content/PTDoc.UI/images/settings/scheduling-edit.svg" alt="" aria-hidden="true" />
            </button>
            <button type="button" aria-label="Delete @item.Name @itemType" @onclick="() => DeleteScheduledItem(item)" disabled="@ControlsDisabled">
                <img src="_content/PTDoc.UI/images/settings/scheduling-delete.svg" alt="" aria-hidden="true" />
            </button>
        </div>
    </article>;

    private RenderFragment ToggleSetting(string label, string description, bool isEnabled, Action toggle) => @<div class="calendar-setting-row">
        <div>
            <strong>@label</strong>
            <p>@description</p>
        </div>
        <button
            type="button"
            class="scheduling-switch @(isEnabled ? "is-enabled" : string.Empty)"
            role="switch"
            aria-checked="@(isEnabled ? "true" : "false")"
            aria-label="@label"
            disabled="@ControlsDisabled"
            @onclick="toggle">
            <span aria-hidden="true"></span>
        </button>
    </div>;

    private RenderFragment SelectField(string id, string label, string value, IReadOnlyList<string> options, Action<string> valueChanged) => @<div class="scheduling-field">
        <label for="@id">@label</label>
        <select id="@id" value="@value" disabled="@ControlsDisabled" @onchange="eventArgs => valueChanged(eventArgs.Value?.ToString() ?? string.Empty)">
            @foreach (var option in options)
            {
                <option value="@option">@option</option>
            }
        </select>
    </div>;

    private RenderFragment BlankField(string id, string label, string value, Action<string> valueChanged) => @<div class="scheduling-field">
        <label for="@id">@label</label>
        <input id="@id" type="text" aria-label="@label" value="@value" disabled="@ControlsDisabled" @oninput="eventArgs => valueChanged(eventArgs.Value?.ToString() ?? string.Empty)" />
    </div>;

    private RenderFragment QuickAdminTools() => @<section class="scheduling-panel quick-admin-tools" aria-labelledby="scheduling-quick-admin-heading">
        <header class="scheduling-panel__header">
            <div class="scheduling-panel__heading">
                <div class="scheduling-panel__title">
                    <img src="_content/PTDoc.UI/images/settings/scheduling-quick-admin.svg" alt="" aria-hidden="true" />
                    <h2 id="scheduling-quick-admin-heading">Quick Admin Tools</h2>
                </div>
                <p>Additional administrative features and settings</p>
            </div>
        </header>
        <div class="quick-admin-tools__items">
            @QuickAdminRow("Auto Check-In Messaging", "Configure automated intake form delivery", "_content/PTDoc.UI/images/settings/quick-message.svg", OpenAutoCheckInMessaging)
            @QuickAdminRow("Kiosk Check-In", "Set up and manage kiosk check-in stations", "_content/PTDoc.UI/images/settings/quick-kiosk.svg", OpenKioskCheckIn)
        </div>
    </section>;

    private RenderFragment QuickAdminRow(string label, string description, string iconPath, Action action) => @<button type="button" class="quick-admin-tools__row" @onclick="action">
        <span class="quick-admin-tools__copy">
            <span class="quick-admin-tools__icon"><img src="@iconPath" alt="" aria-hidden="true" /></span>
            <span><strong>@label</strong><small>@description</small></span>
        </span>
        <img class="quick-admin-tools__chevron" src="_content/PTDoc.UI/images/settings/chevron.svg" alt="" aria-hidden="true" />
    </button>;

    private static string GetTabId(SchedulingTab tab) => Tabs.Single(item => item.Tab == tab).TabId;

    private void ResetToDefaults()
    {
        if (!_canMutate) return;
        _defaultAppointmentDuration = "45 minutes";
        _bufferTime = "15 minutes";
        _defaultClinicianView = "Week View";
        _defaultAdminView = "All-Day View";
        _reminderTiming = "24 hours before";
        _intakeSentColor = string.Empty;
        _intakeIncompleteColor = string.Empty;
        _intakeCompleteColor = string.Empty;
        _allowDoubleBooking = false;
        _autoConfirmAppointments = true;
        _enableClickToCreate = true;
        _showIntakeStatus = true;
        _allowCancelFromWeekView = true;
        _allowRescheduleFromWeekView = true;
        _sendAppointmentReminders = true;
        _clinicTimeZoneId = "America/Los_Angeles";
        var defaults = CreateDefaultHours().ToDictionary(item => item.DayOfWeek);
        foreach (var hour in _clinicHours)
        {
            var canonical = defaults[hour.DayOfWeek];
            hour.IsOpen = canonical.IsOpen;
            hour.StartLocalTime = canonical.StartLocalTime;
            hour.EndLocalTime = canonical.EndLocalTime;
            hour.LunchStartLocalTime = canonical.LunchStartLocalTime;
            hour.LunchEndLocalTime = canonical.LunchEndLocalTime;
        }
        ShowStatus("Canonical defaults applied locally. Select Save Changes to persist them.", false);
    }

    private void CancelChanges()
    {
        _snapshot.Restore(this);
        ShowStatus("Unsaved scheduling changes were discarded.", false);
    }

    private async Task SaveChanges()
    {
        if (!_canMutate) return;
        if (_schedulingService is null)
        {
            CaptureSnapshot();
            ShowStatus("Scheduling values updated locally.", false);
            return;
        }

        _isBusy = true;
        try
        {
            var preferencesRequest = new UpdateSchedulingPreferencesRequest(
                ParseLeadingInt(_defaultAppointmentDuration, 45),
                ParseLeadingInt(_bufferTime, 15),
                _allowDoubleBooking,
                _autoConfirmAppointments,
                _enableClickToCreate,
                _showIntakeStatus,
                _allowCancelFromWeekView,
                _allowRescheduleFromWeekView,
                NormalizeView(_defaultClinicianView),
                NormalizeView(_defaultAdminView),
                _intakeSentColor,
                _intakeIncompleteColor,
                _intakeCompleteColor,
                _sendAppointmentReminders,
                ParseLeadingInt(_reminderTiming, 24),
                _preferencesVersion);
            var preferencesResult = await _schedulingService.UpdatePreferencesAsync(
                Guid.Empty, preferencesRequest, Guid.Empty, string.Empty);
            if (!preferencesResult.Succeeded || preferencesResult.Value is null)
            {
                ShowOperationError(preferencesResult.Status, preferencesResult.ValidationErrors);
                return;
            }

            _preferencesVersion = preferencesResult.Value.Version;
            var hoursRequest = new UpdateClinicHoursRequest(
                _clinicTimeZoneId,
                _clinicVersion,
                _clinicHours.Select(hour => hour.ToRequest()).ToArray());
            var hoursResult = await _schedulingService.UpdateClinicHoursAsync(
                Guid.Empty, hoursRequest, Guid.Empty, string.Empty);
            if (!hoursResult.Succeeded || hoursResult.Value is null)
            {
                ShowOperationError(hoursResult.Status, hoursResult.ValidationErrors);
                return;
            }

            ApplyClinicHours(hoursResult.Value);
            CaptureSnapshot();
            ShowStatus("Scheduling preferences and clinic hours saved.", false);
        }
        catch (Exception)
        {
            ShowStatus("Scheduling settings could not be saved. Your draft remains available to retry.", true);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void OpenAddVisitType()
    {
        if (_canMutate) _editor = EditorDraft.NewVisitType();
    }

    private void OpenAddScheduleBlock()
    {
        if (_canMutate) _editor = EditorDraft.NewBlock();
    }

    private void EditScheduledItem(ScheduledItem item)
    {
        if (!_canMutate) return;
        _editor = item.Kind == EditorKind.VisitType
            ? EditorDraft.FromVisitType(_visitTypes.Single(value => value.Id == item.Id))
            : EditorDraft.FromBlock(_scheduleBlocks.Single(value => value.Id == item.Id));
    }

    private void DeleteScheduledItem(ScheduledItem item)
    {
        if (!_canMutate) return;
        _pendingDeactivation = item;
    }

    private void OpenAutoCheckInMessaging() => Navigation.NavigateTo("/settings/auto-check-in");

    private void OpenKioskCheckIn() => Navigation.NavigateTo("/settings/kiosk");

    private void CloseEditor() => _editor = null;

    private async Task SaveEditor()
    {
        if (_editor is null || !_canMutate)
        {
            return;
        }

        if (_schedulingService is null)
        {
            ShowStatus("The editor requires the Settings API.", true);
            return;
        }

        _isBusy = true;
        try
        {
            if (_editor.Kind == EditorKind.VisitType)
            {
                var request = new SaveVisitTypeRequest(
                    _editor.Code, _editor.Name, _editor.DurationMinutes,
                    _editor.RequiresIntake, _editor.PtaAllowed, _editor.IsBillable,
                    true, _editor.DisplayOrder, _editor.Id == Guid.Empty ? null : _editor.Version);
                var result = _editor.Id == Guid.Empty
                    ? await _schedulingService.CreateVisitTypeAsync(Guid.Empty, request, Guid.Empty, string.Empty)
                    : await _schedulingService.UpdateVisitTypeAsync(Guid.Empty, _editor.Id, request, Guid.Empty, string.Empty);
                if (!result.Succeeded || result.Value is null)
                {
                    ShowOperationError(result.Status, result.ValidationErrors);
                    return;
                }
                Upsert(_visitTypes, ScheduledItem.FromVisitType(result.Value));
            }
            else
            {
                var request = new SaveScheduleBlockRequest(
                    null, _editor.Name, _editor.ReasonCode, WeekdayFlags.Weekdays,
                    _editor.StartTime, _editor.EndTime, DateOnly.FromDateTime(DateTime.Today), null,
                    _editor.IsRecurring, true, _editor.Id == Guid.Empty ? null : _editor.Version);
                var result = _editor.Id == Guid.Empty
                    ? await _schedulingService.CreateScheduleBlockAsync(Guid.Empty, request, Guid.Empty, string.Empty)
                    : await _schedulingService.UpdateScheduleBlockAsync(Guid.Empty, _editor.Id, request, Guid.Empty, string.Empty);
                if (!result.Succeeded || result.Value is null)
                {
                    ShowOperationError(result.Status, result.ValidationErrors);
                    return;
                }
                Upsert(_scheduleBlocks, ScheduledItem.FromBlock(result.Value));
            }

            _editor = null;
            ShowStatus("Scheduling item saved.", false);
        }
        catch (Exception)
        {
            ShowStatus("The scheduling item could not be saved. Your editor values remain available.", true);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task ConfirmDeactivation()
    {
        var item = _pendingDeactivation;
        if (item is null || _schedulingService is null || !_canMutate)
        {
            return;
        }

        _isBusy = true;
        try
        {
            if (item.Kind == EditorKind.VisitType)
            {
                var result = await _schedulingService.DeactivateVisitTypeAsync(Guid.Empty, item.Id, item.Version, Guid.Empty, string.Empty);
                if (!result.Succeeded || result.Value is null) { ShowOperationError(result.Status, result.ValidationErrors); return; }
                Upsert(_visitTypes, ScheduledItem.FromVisitType(result.Value));
            }
            else
            {
                var result = await _schedulingService.DeactivateScheduleBlockAsync(Guid.Empty, item.Id, item.Version, Guid.Empty, string.Empty);
                if (!result.Succeeded || result.Value is null) { ShowOperationError(result.Status, result.ValidationErrors); return; }
                Upsert(_scheduleBlocks, ScheduledItem.FromBlock(result.Value));
            }
            _pendingDeactivation = null;
            ShowStatus("Scheduling item deactivated.", false);
        }
        catch (Exception)
        {
            ShowStatus("The scheduling item could not be deactivated.", true);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void ApplyPreferences(SchedulingPreferencesDto preferences)
    {
        _defaultAppointmentDuration = $"{preferences.DefaultAppointmentDurationMinutes} minutes";
        _bufferTime = $"{preferences.AppointmentBufferMinutes} minutes";
        _allowDoubleBooking = preferences.AllowDoubleBooking;
        _autoConfirmAppointments = preferences.AutoConfirmAppointments;
        _enableClickToCreate = preferences.EnableClickToCreate;
        _showIntakeStatus = preferences.ShowIntakeStatus;
        _allowCancelFromWeekView = preferences.AllowCancelFromWeekView;
        _allowRescheduleFromWeekView = preferences.AllowRescheduleFromWeekView;
        _defaultClinicianView = DisplayView(preferences.DefaultClinicianView);
        _defaultAdminView = DisplayView(preferences.DefaultAdminView);
        _intakeSentColor = preferences.IntakeSentColor ?? string.Empty;
        _intakeIncompleteColor = preferences.IntakeIncompleteColor ?? string.Empty;
        _intakeCompleteColor = preferences.IntakeCompleteColor ?? string.Empty;
        _sendAppointmentReminders = preferences.SendAppointmentReminders;
        _reminderTiming = $"{preferences.ReminderLeadHours} hours before";
        _preferencesVersion = preferences.Version;
    }

    private void ApplyClinicHours(ClinicHoursDto clinicHours)
    {
        _clinicTimeZoneId = clinicHours.TimeZoneId;
        _clinicVersion = clinicHours.ClinicVersion;
        _clinicHours = clinicHours.Hours.Count == 0
            ? CreateDefaultHours()
            : clinicHours.Hours.Select(ClinicHourDraft.FromDto).ToList();
    }

    private void CaptureSnapshot() => _snapshot = SchedulingSnapshot.Capture(this);

    private void ShowOperationError(SettingsOperationStatus status, IReadOnlyDictionary<string, string[]>? validationErrors)
    {
        var validationMessage = validationErrors?.Values.SelectMany(messages => messages).FirstOrDefault();
        ShowStatus(status switch
        {
            SettingsOperationStatus.Conflict => "These settings changed in another session. Reload before retrying; your draft has not been discarded.",
            SettingsOperationStatus.Forbidden => "Your account has read-only access to scheduling settings.",
            SettingsOperationStatus.ValidationFailed => validationMessage ?? "One or more scheduling values are invalid.",
            _ => "The scheduling request could not be completed."
        }, true);
    }

    private void ShowStatus(string message, bool isError)
    {
        _statusMessage = message;
        _statusIsError = isError;
    }

    private static void Upsert(List<ScheduledItem> items, ScheduledItem updated)
    {
        var index = items.FindIndex(item => item.Id == updated.Id);
        if (index < 0) items.Add(updated); else items[index] = updated;
    }

    private static int ParseLeadingInt(string value, int fallback) =>
        int.TryParse(value.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault(), out var parsed) ? parsed : fallback;

    private static int ParseInt(object? value, int fallback) => int.TryParse(value?.ToString(), out var parsed) ? parsed : fallback;
    private static bool ParseBool(object? value) => value is bool boolean ? boolean : bool.TryParse(value?.ToString(), out var parsed) && parsed;
    private static TimeOnly ParseTime(object? value, TimeOnly fallback) => TimeOnly.TryParse(value?.ToString(), out var parsed) ? parsed : fallback;
    private static TimeOnly? ParseNullableTime(object? value) => TimeOnly.TryParse(value?.ToString(), out var parsed) ? parsed : null;
    private static string FormatTime(TimeOnly value) => value.ToString("HH:mm");
    private static string FormatNullableTime(TimeOnly? value) => value?.ToString("HH:mm") ?? string.Empty;
    private static string NormalizeView(string value) => value.Replace(" View", string.Empty).Replace("-", string.Empty);
    private static string DisplayView(string value) => value switch { "AllDay" => "All-Day View", _ => $"{value} View" };

    private static List<ClinicHourDraft> CreateDefaultHours() => SchedulingDefaults.WeeklyHours
        .Select(item => new ClinicHourDraft
        {
            DayOfWeek = item.Day,
            IsOpen = item.IsOpen,
            StartLocalTime = item.IsOpen ? new TimeOnly(8, 0) : null,
            EndLocalTime = item.IsOpen ? new TimeOnly(17, 0) : null,
            LunchStartLocalTime = item.IsOpen ? new TimeOnly(12, 0) : null,
            LunchEndLocalTime = item.IsOpen ? new TimeOnly(13, 0) : null
        }).ToList();

    private enum SchedulingTab
    {
        VisitTypes,
        ScheduleBlocks,
        CalendarBehavior,
        ClinicHours
    }

    private enum EditorKind
    {
        VisitType,
        ScheduleBlock
    }

    private sealed record TabDefinition(
        SchedulingTab Tab,
        string TabId);

    private sealed record ScheduledItem(
        Guid Id,
        EditorKind Kind,
        string Name,
        string Duration,
        string? Badge,
        bool IsActive,
        long Version,
        VisitTypeDto? VisitType = null,
        ScheduleBlockDto? Block = null)
    {
        public static ScheduledItem FromVisitType(VisitTypeDto item) => new(
            item.Id, EditorKind.VisitType, item.Name, $"{item.DurationMinutes} min",
            item.RequiresIntake ? "Requires Intake" : item.PtaAllowed ? "PTA Allowed" : null,
            item.IsActive, item.Version, item, null);

        public static ScheduledItem FromBlock(ScheduleBlockDto item)
        {
            var duration = (int)(item.EndLocalTime - item.StartLocalTime).TotalMinutes;
            return new ScheduledItem(item.Id, EditorKind.ScheduleBlock, item.Name, $"{duration} min",
                item.IsRecurring ? "Recurring" : null, item.IsActive, item.Version, null, item);
        }
    }

    private sealed class EditorDraft
    {
        public Guid Id { get; set; }
        public EditorKind Kind { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Code { get; set; } = string.Empty;
        public int DurationMinutes { get; set; } = 45;
        public bool RequiresIntake { get; set; }
        public bool PtaAllowed { get; set; }
        public bool IsBillable { get; set; } = true;
        public int DisplayOrder { get; set; }
        public string ReasonCode { get; set; } = "administrative";
        public TimeOnly StartTime { get; set; } = new(12, 0);
        public TimeOnly EndTime { get; set; } = new(13, 0);
        public bool IsRecurring { get; set; } = true;
        public long Version { get; set; }

        public static EditorDraft NewVisitType() => new() { Kind = EditorKind.VisitType };
        public static EditorDraft NewBlock() => new() { Kind = EditorKind.ScheduleBlock };

        public static EditorDraft FromVisitType(ScheduledItem item)
        {
            var source = item.VisitType!;
            return new EditorDraft
            {
                Id = source.Id, Kind = EditorKind.VisitType, Name = source.Name, Code = source.Code,
                DurationMinutes = source.DurationMinutes, RequiresIntake = source.RequiresIntake,
                PtaAllowed = source.PtaAllowed, IsBillable = source.IsBillable,
                DisplayOrder = source.DisplayOrder, Version = source.Version
            };
        }

        public static EditorDraft FromBlock(ScheduledItem item)
        {
            var source = item.Block!;
            return new EditorDraft
            {
                Id = source.Id, Kind = EditorKind.ScheduleBlock, Name = source.Name,
                ReasonCode = source.ReasonCode, StartTime = source.StartLocalTime,
                EndTime = source.EndLocalTime, IsRecurring = source.IsRecurring, Version = source.Version
            };
        }
    }

    private sealed class ClinicHourDraft
    {
        public DayOfWeek DayOfWeek { get; set; }
        public bool IsOpen { get; set; }
        public TimeOnly? StartLocalTime { get; set; }
        public TimeOnly? EndLocalTime { get; set; }
        public TimeOnly? LunchStartLocalTime { get; set; }
        public TimeOnly? LunchEndLocalTime { get; set; }
        public long Version { get; set; }

        public SaveClinicBusinessHourRequest ToRequest() => new(
            DayOfWeek, IsOpen, StartLocalTime, EndLocalTime, LunchStartLocalTime, LunchEndLocalTime, Version);

        public ClinicHourDraft Clone() => (ClinicHourDraft)MemberwiseClone();

        public static ClinicHourDraft FromDto(ClinicBusinessHourDto item) => new()
        {
            DayOfWeek = item.DayOfWeek, IsOpen = item.IsOpen, StartLocalTime = item.StartLocalTime,
            EndLocalTime = item.EndLocalTime, LunchStartLocalTime = item.LunchStartLocalTime,
            LunchEndLocalTime = item.LunchEndLocalTime, Version = item.Version
        };
    }

    private sealed record SchedulingSnapshot(
        string DefaultDuration,
        string Buffer,
        string ClinicianView,
        string AdminView,
        string ReminderTiming,
        string IntakeSentColor,
        string IntakeIncompleteColor,
        string IntakeCompleteColor,
        bool AllowDoubleBooking,
        bool AutoConfirm,
        bool ClickToCreate,
        bool ShowIntakeStatus,
        bool AllowCancel,
        bool AllowReschedule,
        bool SendReminders,
        string TimeZoneId,
        long ClinicVersion,
        long PreferencesVersion,
        IReadOnlyList<ClinicHourDraft> Hours)
    {
        public static SchedulingSnapshot Default { get; } = new(
            "45 minutes", "15 minutes", "Week View", "All-Day View", "24 hours before",
            string.Empty, string.Empty, string.Empty, false, true, true, true, true, true, true,
            "America/Los_Angeles", 0, 0, CreateDefaultHours());

        public static SchedulingSnapshot Capture(SchedulingVisitTypesSettings owner) => new(
            owner._defaultAppointmentDuration, owner._bufferTime, owner._defaultClinicianView,
            owner._defaultAdminView, owner._reminderTiming, owner._intakeSentColor,
            owner._intakeIncompleteColor, owner._intakeCompleteColor, owner._allowDoubleBooking,
            owner._autoConfirmAppointments, owner._enableClickToCreate, owner._showIntakeStatus,
            owner._allowCancelFromWeekView, owner._allowRescheduleFromWeekView,
            owner._sendAppointmentReminders, owner._clinicTimeZoneId, owner._clinicVersion,
            owner._preferencesVersion, owner._clinicHours.Select(item => item.Clone()).ToArray());

        public void Restore(SchedulingVisitTypesSettings owner)
        {
            owner._defaultAppointmentDuration = DefaultDuration;
            owner._bufferTime = Buffer;
            owner._defaultClinicianView = ClinicianView;
            owner._defaultAdminView = AdminView;
            owner._reminderTiming = ReminderTiming;
            owner._intakeSentColor = IntakeSentColor;
            owner._intakeIncompleteColor = IntakeIncompleteColor;
            owner._intakeCompleteColor = IntakeCompleteColor;
            owner._allowDoubleBooking = AllowDoubleBooking;
            owner._autoConfirmAppointments = AutoConfirm;
            owner._enableClickToCreate = ClickToCreate;
            owner._showIntakeStatus = ShowIntakeStatus;
            owner._allowCancelFromWeekView = AllowCancel;
            owner._allowRescheduleFromWeekView = AllowReschedule;
            owner._sendAppointmentReminders = SendReminders;
            owner._clinicTimeZoneId = TimeZoneId;
            owner._clinicVersion = ClinicVersion;
            owner._preferencesVersion = PreferencesVersion;
            owner._clinicHours = Hours.Select(item => item.Clone()).ToList();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_keyboardModule is null)
        {
            return;
        }

        try
        {
            await _keyboardModule.InvokeVoidAsync("detachKeyboardGuards", _root);
            await _keyboardModule.DisposeAsync();
        }
        catch
        {
            // Ignore interop disposal failures during circuit teardown.
        }
    }
}
