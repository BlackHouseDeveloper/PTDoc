    }

    private async Task HandleTabKeyDownAsync(KeyboardEventArgs eventArgs, SettingsTab currentTab)
    {
        SettingsTab? targetTab = eventArgs.Key switch
        {
            "ArrowRight" => currentTab == SettingsTab.RolePermissions
                ? SettingsTab.SecuritySettings
                : SettingsTab.RolePermissions,
            "ArrowLeft" => currentTab == SettingsTab.RolePermissions
                ? SettingsTab.SecuritySettings
                : SettingsTab.RolePermissions,
            "Home" => SettingsTab.RolePermissions,
            "End" => SettingsTab.SecuritySettings,
            _ => null
        };

        if (targetTab is null)
        {
            return;
        }

        SelectTab(targetTab.Value);
        await GetTabReference(targetTab.Value).FocusAsync();
    }

    private ElementReference GetTabReference(SettingsTab tab) => tab switch
    {
        SettingsTab.RolePermissions => _rolePermissionsTab,
        SettingsTab.SecuritySettings => _securitySettingsTab,
        _ => throw new ArgumentOutOfRangeException(nameof(tab), tab, null)
    };

    private void SelectRole(string roleName)
    {
        _selectedRole = roleName;
        _cloneSourceRole = string.Empty;
        // TODO: Load role list from application data source.
        // TODO: Load permissions for selected role.
    }

    private static void SetPermissionLevel(PermissionDefinition permission, string level)
    {
        permission.SelectedLevel = level;
        // TODO: Persist permission changes.
        // TODO: Calculate permission-summary counts dynamically when role data is connected.
    }

    private static async Task HandlePermissionLevelKeyDownAsync(
        KeyboardEventArgs eventArgs,
        PermissionDefinition permission,
        int currentIndex)
    {
        var targetIndex = eventArgs.Key switch
        {
            "ArrowRight" or "ArrowDown" => (currentIndex + 1) % permission.AvailableLevels.Count,
            "ArrowLeft" or "ArrowUp" => (currentIndex - 1 + permission.AvailableLevels.Count) % permission.AvailableLevels.Count,
            "Home" => 0,
            "End" => permission.AvailableLevels.Count - 1,
            _ => -1
        };

        if (targetIndex < 0)
        {
            return;
        }

        SetPermissionLevel(permission, permission.AvailableLevels[targetIndex]);
        await permission.GetLevelButton(targetIndex).FocusAsync();
    }

