    private RenderFragment QuickAdminTools() => @<text>
        <section class="settings-panel quick-admin" aria-labelledby="quick-admin-title">
            <header class="settings-panel__header">
                <h2 id="quick-admin-title">Quick Admin Tools</h2>
                <p>Additional administrative features and settings</p>
            </header>
            <div class="quick-admin__items">
                <button type="button" @onclick="OpenAutoCheckInMessaging">
                    <span class="quick-admin__copy">
                        <span class="quick-admin__icon"><img src="_content/PTDoc.UI/images/settings/quick-message.svg" alt="" aria-hidden="true" /></span>
