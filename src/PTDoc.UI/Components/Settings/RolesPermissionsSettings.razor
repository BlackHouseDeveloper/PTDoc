    private enum SettingsTab
    {
        RolePermissions,
        SecuritySettings
    }

    private sealed record RoleDefinition(string Name, string DisplayName, string Description, string DotClass, bool IsReadOnly);

    private sealed record PermissionCategory(
        string TitleId,
        string Title,
        string IconPath,
        IReadOnlyList<PermissionDefinition> Permissions);

    private sealed class PermissionDefinition(
        CapabilityKey key,
        string name,
        string description,
        string selectedLevel,
        IReadOnlyList<string> availableLevels,
        bool isRecommended = false)
    {
        public CapabilityKey Key { get; } = key;

        public string Name { get; } = name;

        public string Description { get; } = description;

        public string SelectedLevel { get; set; } = selectedLevel;

        public IReadOnlyList<string> AvailableLevels { get; } = availableLevels;

        public bool IsRecommended { get; } = isRecommended;

        public ElementReference FirstLevelButton { get; set; }

        public ElementReference SecondLevelButton { get; set; }

        public ElementReference GetLevelButton(int index) => index switch
        {
            0 => FirstLevelButton,
            1 => SecondLevelButton,
            _ => throw new ArgumentOutOfRangeException(nameof(index), index, null)
        };

        public long Version { get; set; }

        public PermissionLevel LockedMinimum { get; set; }

        public bool IsSupported { get; set; } = true;
    }

    private sealed record SecuritySnapshot(
        bool RequireMfa,
        bool RequirePinChange,
        string MinimumPinLength,
        string InactivityMinutes,
        bool AllowRoleCustomization,
        bool RestrictScheduleAccess,
        long Version)
    {
        public static SecuritySnapshot Default { get; } = new(false, true, "8", "15", true, false, 0);

        public SecurityPolicyDto ToDto() => new(
            RequireMfa ? MfaEnforcementMode.GracePeriod : MfaEnforcementMode.Off,
            RequireMfa ? DateTime.UtcNow.AddDays(14) : null,
            RequirePinChange,
            int.TryParse(MinimumPinLength, out var minimum) ? minimum : 8,
            int.TryParse(InactivityMinutes, out var timeout) ? timeout : 15,
            AllowRoleCustomization,
            RestrictScheduleAccess,
            AuthorizationRolloutMode.Static,
            true,
            Version);
    }

    public async ValueTask DisposeAsync()
    {
        if (_keyboardModule is null)
        {
            return;
        }

        try
        {
            await _keyboardModule.InvokeVoidAsync("detachKeyboardGuards", _root);
            await _keyboardModule.DisposeAsync();
        }
        catch
        {
            // Ignore interop disposal failures during circuit teardown.
        }
    }
}
