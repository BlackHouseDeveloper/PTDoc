                new("Add CPT Codes", "Add billing codes to clinical notes", "Edit", ["None", "Edit"]),
                new("Submit Insurance Claims", "Process and submit claims to payers", "None", ["None", "Full"]),
                new("Manage Payer Information", "Add/edit insurance companies and contracts", "None", ["None", "Full"]),
                new("View Billing Reports", "Access financial reports and revenue analytics", "None", ["None", "View"])
            ]),
        new(
            "messaging-title",
            "Messaging",
            "_content/PTDoc.UI/images/settings/messaging.svg",
            [
                new("Internal Staff Messaging", "Send messages to other staff members", "Edit", ["None", "Edit"]),
                new("Message Patients", "Send HIPAA-compliant messages to patients", "Edit", ["None", "Edit"]),
                new("Broadcast Messages", "Send announcements to all staff or patients", "None", ["None", "Full"])
            ]),
        new(
            "reporting-title",
            "Reporting",
            "_content/PTDoc.UI/images/settings/reporting.svg",
