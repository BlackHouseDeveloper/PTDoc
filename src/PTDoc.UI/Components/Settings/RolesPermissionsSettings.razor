@using PTDoc.Application.Settings
@using PTDoc.Core.Models
@inject IServiceProvider Services
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IAsyncDisposable

<section class="roles-permissions" aria-labelledby="roles-permissions-title" aria-busy="@_isBusy" @ref="_root">
    <header class="roles-permissions__header">
        <img src="_content/PTDoc.UI/images/settings/role-selector.svg" alt="" aria-hidden="true" />
        <div>
            <h1 id="roles-permissions-title">Roles &amp; Permissions</h1>
            <p>Manage user roles, access levels, and permission sets</p>
        </div>
    </header>

    <div class="roles-permissions__tabs" role="tablist" aria-label="Roles and security settings">
        <button
            @ref="_rolePermissionsTab"
            type="button"
            id="role-permissions-tab"
            class="roles-permissions__tab @(_activeTab == SettingsTab.RolePermissions ? "is-active" : string.Empty)"
            role="tab"
            aria-selected="@(_activeTab == SettingsTab.RolePermissions ? "true" : "false")"
            aria-controls="roles-settings-panel"
            tabindex="@(_activeTab == SettingsTab.RolePermissions ? "0" : "-1")"
            @onclick="() => SelectTab(SettingsTab.RolePermissions)"
            @onkeydown="eventArgs => HandleTabKeyDownAsync(eventArgs, SettingsTab.RolePermissions)">
            <img src="_content/PTDoc.UI/images/settings/roles-tab.svg" alt="" aria-hidden="true" />
            <span>Role Permissions</span>
        </button>
        <button
            @ref="_securitySettingsTab"
            type="button"
            id="security-settings-tab"
            class="roles-permissions__tab @(_activeTab == SettingsTab.SecuritySettings ? "is-active" : string.Empty)"
            role="tab"
            aria-selected="@(_activeTab == SettingsTab.SecuritySettings ? "true" : "false")"
            aria-controls="roles-settings-panel"
            tabindex="@(_activeTab == SettingsTab.SecuritySettings ? "0" : "-1")"
            @onclick="() => SelectTab(SettingsTab.SecuritySettings)"
            @onkeydown="eventArgs => HandleTabKeyDownAsync(eventArgs, SettingsTab.SecuritySettings)">
            <img src="_content/PTDoc.UI/images/settings/security-tab.svg" alt="" aria-hidden="true" />
            <span>Security Settings</span>
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <div class="roles-permissions__status @(_statusIsError ? "is-error" : "is-success")" role="@(_statusIsError ? "alert" : "status")">
            @_statusMessage
        </div>
    }

    @if (!_canMutate)
    {
        <div class="roles-permissions__status" role="status">Owner access is read-only. An Administrator must make permission or security-policy changes.</div>
    }

    @if (_activeTab == SettingsTab.RolePermissions)
    {
        <div
            id="roles-settings-panel"
            class="roles-permissions__tabpanel"
            role="tabpanel"
            aria-labelledby="role-permissions-tab">
            <aside class="permission-guidance" aria-labelledby="permission-guidance-title">
                <img class="permission-guidance__icon" src="_content/PTDoc.UI/images/settings/guidance-info.svg" alt="" aria-hidden="true" />
                <div>
                    <h2 id="permission-guidance-title">How to Use the Permission Matrix</h2>
                    <ul>
                        <li><strong>None:</strong> No access to this feature</li>
                        <li><strong>View:</strong> Read-only access (can see but not modify)</li>
                        <li><strong>Edit:</strong> Can create and modify (standard user access)</li>
                        <li><strong>Full:</strong> Complete control including delete and admin actions</li>
                        <li class="permission-guidance__status">
                            <img src="_content/PTDoc.UI/images/settings/guidance-locked.svg" alt="" aria-hidden="true" />
                            <span>Locked permissions are system-required and cannot be changed</span>
                        </li>
                        <li class="permission-guidance__status">
                            <img src="_content/PTDoc.UI/images/settings/guidance-recommended.svg" alt="" aria-hidden="true" />
                            <span>Recommended permissions are suggested for optimal workflow</span>
                        </li>
                    </ul>
                </div>
            </aside>

            <section class="settings-panel role-selector" aria-labelledby="role-selector-title">
                <header class="settings-panel__header">
                    <div class="settings-panel__title">
                        <img src="_content/PTDoc.UI/images/settings/role-selector.svg" alt="" aria-hidden="true" />
                        <h2 id="role-selector-title">Select Role to Configure</h2>
                    </div>
                    <p>Choose a role to view and edit its permissions</p>
                </header>

                <div class="role-selector__grid">
                    @foreach (var role in Roles)
                    {
                        <button
                            type="button"
                            class="role-card @(role.Name == _selectedRole ? "is-selected" : string.Empty)"
                            aria-pressed="@(role.Name == _selectedRole ? "true" : "false")"
                            disabled="@_isBusy"
                            @onclick="() => SelectRole(role.Name)">
                            <span class="role-card__identity">
                                <span class="role-card__dot @role.DotClass" aria-hidden="true"></span>
                                <span class="role-card__name">@role.DisplayName</span>
                            </span>
                            <span class="role-card__description">@role.Description</span>
                        </button>
                    }
                </div>
            </section>

            <section class="clone-permissions" aria-labelledby="clone-permissions-title">
                <img class="clone-permissions__icon" src="_content/PTDoc.UI/images/settings/clone.svg" alt="" aria-hidden="true" />
                <div class="clone-permissions__copy">
                    <h2 id="clone-permissions-title">Clone Permissions</h2>
                    <p>Copy permissions from another role to @SelectedRoleDisplayName</p>
                </div>
                <div class="clone-permissions__actions">
                    <label class="roles-permissions__sr-only" for="clone-role-select">Source role</label>
                    <select id="clone-role-select" @bind="_cloneSourceRole" disabled="@(_isBusy || !_canMutate || SelectedRoleIsReadOnly)">
                        <option value=""></option>
                        @foreach (var role in Roles.Where(role => role.Name != _selectedRole))
                        {
                            <option value="@role.Name">@role.DisplayName</option>
                        }
                    </select>
                    <button type="button" @onclick="ClonePermissions" disabled="@(_isBusy || !_canMutate || SelectedRoleIsReadOnly || string.IsNullOrWhiteSpace(_cloneSourceRole))">Clone</button>
                </div>
            </section>

            @foreach (var category in _permissionCategories)
            {
                <section class="settings-panel permission-category" aria-labelledby="@category.TitleId">
                    <header class="settings-panel__header settings-panel__header--compact">
                        <div class="settings-panel__title">
                            <img src="@category.IconPath" alt="" aria-hidden="true" />
                            <h2 id="@category.TitleId">@category.Title</h2>
                        </div>
                    </header>

                    <div class="permission-category__rows">
                        @foreach (var permission in category.Permissions)
                        {
                            <div class="permission-row">
                                <div class="permission-row__copy">
                                    <div class="permission-row__label">
                                        <span>@permission.Name</span>
                                        @if (permission.IsRecommended)
                                        {
                                            <img src="_content/PTDoc.UI/images/settings/permission-recommended.svg" alt="" aria-hidden="true" />
                                            <span class="roles-permissions__sr-only">Recommended permission</span>
                                        }
                                        <img src="_content/PTDoc.UI/images/settings/permission-info.svg" alt="" aria-hidden="true" />
                                    </div>
                                    <p>@permission.Description</p>
                                </div>
                                <div class="permission-row__options" role="radiogroup" aria-label="@($"{permission.Name} permission")">
                                    @{
                                        var firstLevel = permission.AvailableLevels[0];
                                        var secondLevel = permission.AvailableLevels[1];
                                        <button
                                            @ref="permission.FirstLevelButton"
                                            type="button"
                                            class="permission-level @(permission.SelectedLevel == firstLevel ? "is-selected" : string.Empty)"
                                            role="radio"
                                            aria-checked="@(permission.SelectedLevel == firstLevel ? "true" : "false")"
                                            aria-label="@($"{permission.Name}: {firstLevel}")"
                                            tabindex="@(permission.SelectedLevel == firstLevel ? "0" : "-1")"
                                            disabled="@(_isBusy || !_canMutate || SelectedRoleIsReadOnly || !permission.IsSupported || permission.LockedMinimum > PermissionLevel.None)"
                                            @onclick="async () => await SetPermissionLevel(permission, firstLevel)"
                                            @onkeydown="eventArgs => HandlePermissionLevelKeyDownAsync(eventArgs, permission, 0)">
                                            @firstLevel
                                        </button>
                                        <button
                                            @ref="permission.SecondLevelButton"
                                            type="button"
                                            class="permission-level @(permission.SelectedLevel == secondLevel ? "is-selected" : string.Empty)"
                                            role="radio"
                                            aria-checked="@(permission.SelectedLevel == secondLevel ? "true" : "false")"
                                            aria-label="@($"{permission.Name}: {secondLevel}")"
                                            tabindex="@(permission.SelectedLevel == secondLevel ? "0" : "-1")"
                                            disabled="@(_isBusy || !_canMutate || SelectedRoleIsReadOnly || !permission.IsSupported || permission.LockedMinimum > PermissionLevel.None)"
                                            @onclick="async () => await SetPermissionLevel(permission, secondLevel)"
                                            @onkeydown="eventArgs => HandlePermissionLevelKeyDownAsync(eventArgs, permission, 1)">
                                            @secondLevel
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </section>
            }

            <section class="permission-summary" aria-labelledby="permission-summary-title">
                <header class="permission-summary__header">
                    <img src="_content/PTDoc.UI/images/settings/summary.svg" alt="" aria-hidden="true" />
                    <h2 id="permission-summary-title">Permission Summary for @SelectedRoleDisplayName</h2>
                </header>
                <div class="permission-summary__metrics">
                    <div><strong>@PermissionCount(PermissionLevel.Full)</strong><span>Full Access</span></div>
                    <div><strong>@PermissionCount(PermissionLevel.Edit)</strong><span>Edit Access</span></div>
                    <div><strong>@PermissionCount(PermissionLevel.View)</strong><span>View Only</span></div>
                    <div><strong>@PermissionCount(PermissionLevel.None)</strong><span>No Access</span></div>
                </div>
            </section>

            @QuickAdminTools()
        </div>
    }
    else
    {
        <div
            id="roles-settings-panel"
            class="roles-permissions__tabpanel"
            role="tabpanel"
            aria-labelledby="security-settings-tab">
            <section class="settings-panel security-card" aria-labelledby="security-requirements-title">
                <header class="settings-panel__header">
                    <div class="settings-panel__title">
                        <img src="_content/PTDoc.UI/images/settings/security-requirements.svg" alt="" aria-hidden="true" />
                        <h2 id="security-requirements-title">Security Requirements</h2>
                    </div>
                    <p>Configure authentication and security policies</p>
                </header>
                <div class="security-card__rows">
                    @SecurityToggle("Require Multi-Factor Authentication", "All users must enroll in TOTP before the effective date", _requireMfa, ToggleMfa)
                    @SecurityToggle("Require PIN Change on First Login", "Force new users to create their own PIN", _requirePinChange, TogglePinChange)
                    @SecurityInput("auto-lockout-time", "Session Inactivity Timeout", "Lock sessions after 5–60 minutes of inactivity", _autoLockoutTime, value => _autoLockoutTime = value)
                    @SecurityInput("minimum-pin-length", "Minimum PIN Length", "Require 8–12 numeric digits at the next PIN change", _minimumPinLength, value => _minimumPinLength = value)
                </div>
            </section>

            <section class="settings-panel security-card" aria-labelledby="role-management-title">
                <header class="settings-panel__header">
                    <div class="settings-panel__title">
                        <img src="_content/PTDoc.UI/images/settings/role-management.svg" alt="" aria-hidden="true" />
                        <h2 id="role-management-title">Role Management</h2>
                    </div>
                    <p>Configure role capabilities and customization options</p>
                </header>
                <div class="security-card__rows security-card__rows--compact">
                    @SecurityToggle("Allow Role Customization", "Enable admins to customize permissions for clinical roles", _allowRoleCustomization, ToggleRoleCustomization)
                    <div class="security-setting-row">
                        <div><strong>Security Audit Log</strong><p>Mandatory auditing of security and permission changes</p></div>
                        <span aria-label="Security Audit Log enabled and locked">Enabled · Locked</span>
                    </div>
                    <button type="button" class="manage-roles-row" @onclick="RegenerateRecoveryCodes">
                        <span class="manage-roles-row__copy">
                            <img src="_content/PTDoc.UI/images/settings/security-requirements.svg" alt="" aria-hidden="true" />
                            <span>
                                <strong>Regenerate My Recovery Codes</strong>
                                <small>Verify with TOTP and invalidate your previous recovery-code set</small>
                            </span>
                        </span>
                        <span class="manage-roles-row__action">Regenerate</span>
                    </button>
                    <button type="button" class="manage-roles-row" @onclick="GoToRoles">
                        <span class="manage-roles-row__copy">
                            <img src="_content/PTDoc.UI/images/settings/manage-roles.svg" alt="" aria-hidden="true" />
                            <span>
                                <strong>Manage Individual Roles</strong>
                                <small>View and edit detailed role permissions</small>
                            </span>
                        </span>
                        <span class="manage-roles-row__action">Go to Roles</span>
                    </button>
                </div>
            </section>

            <section class="settings-panel security-card" aria-labelledby="access-control-title">
                <header class="settings-panel__header">
                    <div class="settings-panel__title">
                        <img src="_content/PTDoc.UI/images/settings/access-control.svg" alt="" aria-hidden="true" />
                        <h2 id="access-control-title">Access Control</h2>
                    </div>
                    <p>Control what users can see and access</p>
                </header>
                <div class="security-card__rows security-card__rows--compact">
                    @SecurityToggle("Restrict Schedule Access", "Limit clinicians to view only their own schedule", _restrictScheduleAccess, ToggleScheduleAccess)
                    <aside class="hipaa-callout" aria-labelledby="hipaa-compliance-title">
                        <img src="_content/PTDoc.UI/images/settings/hipaa-warning.svg" alt="" aria-hidden="true" />
                        <div>
                            <h3 id="hipaa-compliance-title">HIPAA Compliance</h3>
                            <p>This preview illustrates controls required for HIPAA-conscious operations. Audit retention and enforcement require backend policy integration; changes here are not yet persisted.</p>
                        </div>
                    </aside>
                </div>
            </section>

            @QuickAdminTools()

            <div class="security-action-bar" aria-label="Security settings actions">
                <button type="button" @onclick="ResetSecuritySettings" disabled="@(_isBusy || !_canMutate)">
                    <img src="_content/PTDoc.UI/images/settings/reset.svg" alt="" aria-hidden="true" />
                    <span>Reset to Default</span>
                </button>
                <button type="button" @onclick="CancelSecurityChanges" disabled="@_isBusy">
                    <img src="_content/PTDoc.UI/images/settings/cancel.svg" alt="" aria-hidden="true" />
                    <span>Cancel</span>
                </button>
                <button type="button" class="security-action-bar__save" @onclick="SaveSecurityChanges" disabled="@(_isBusy || !_canMutate)">
                    <img src="_content/PTDoc.UI/images/settings/save.svg" alt="" aria-hidden="true" />
                    <span>Save Changes</span>
                </button>
            </div>
        </div>
    }
</section>

@code {
    private SettingsTab _activeTab = SettingsTab.RolePermissions;
    private ElementReference _root;
    private ElementReference _rolePermissionsTab;
    private ElementReference _securitySettingsTab;
    private IJSObjectReference? _keyboardModule;
    private string _selectedRole = "PT";
    private string _cloneSourceRole = string.Empty;
    private bool _requireMfa;
    private bool _requirePinChange = true;
    private bool _allowRoleCustomization = true;
    private bool _restrictScheduleAccess;
    private string _autoLockoutTime = "15";
    private string _minimumPinLength = "8";
    private bool _isBusy;
    private bool _canMutate = true;
    private bool _statusIsError;
    private string? _statusMessage;
    private long _securityVersion;
    private SecuritySnapshot _securitySnapshot = SecuritySnapshot.Default;
    private IRolePermissionAdministrationService? _roleService;
    private ISecurityPolicyAdministrationService? _securityService;
    private readonly Dictionary<string, RolePermissionSet> _rolePermissionSets = new(StringComparer.Ordinal);

    private IReadOnlyList<RoleDefinition> Roles { get; set; } =
    [
        new("Admin", "Administrator", "Full recovery administration", "role-card__dot--manager", false),
        new("Owner", "Owner / Executive", "Read-only operational access", "role-card__dot--owner", true),
        new("PracticeManager", "Practice Manager", "Manage clinic operations and staff", "role-card__dot--manager", false),
        new("PT", "PT / DPT", "Licensed physical therapist", "role-card__dot--pt", false),
        new("PTA", "PTA", "Physical therapist assistant", "role-card__dot--pta", false),
        new("Aide", "Therapy Aide / Rehab Tech", "Support staff for therapy sessions", "role-card__dot--aide", false),
        new("FrontDesk", "Front Desk / Patient Care Coordinator", "Patient intake and scheduling", "role-card__dot--front-desk", false),
        new("Billing", "Billing Specialist", "Handle billing and insurance", "role-card__dot--billing", false),
        new("Patient", "Patient", "Patient portal access only", "role-card__dot--patient", true)
    ];

    private IReadOnlyList<PermissionCategory> _permissionCategories = CreatePermissionCategories();

    private bool SelectedRoleIsReadOnly => Roles.FirstOrDefault(role => role.Name == _selectedRole)?.IsReadOnly ?? false;
    private string SelectedRoleDisplayName => Roles.FirstOrDefault(role => role.Name == _selectedRole)?.DisplayName ?? _selectedRole;

    protected override async Task OnInitializedAsync()
    {
        if (Services.GetService(typeof(Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider))
            is Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider authenticationStateProvider)
        {
            var authenticationState = await authenticationStateProvider.GetAuthenticationStateAsync();
            _canMutate = authenticationState.User.IsInRole(PTDoc.Application.Services.Roles.Admin);
        }

        _roleService = Services.GetService(typeof(IRolePermissionAdministrationService)) as IRolePermissionAdministrationService;
        _securityService = Services.GetService(typeof(ISecurityPolicyAdministrationService)) as ISecurityPolicyAdministrationService;
        if (_roleService is null || _securityService is null)
        {
            return;
        }

        _isBusy = true;
        try
        {
            var rolesTask = _roleService.GetAsync(Guid.Empty);
            var securityTask = _securityService.GetAsync(Guid.Empty);
            await Task.WhenAll(rolesTask, securityTask);
            ApplyRoles(await rolesTask);
            ApplySecurity(await securityTask);
        }
        catch (Exception)
        {
            ShowStatus("Settings could not be loaded. The documented defaults are shown; retry after the API is available.", true);
        }
        finally
        {
            _isBusy = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _keyboardModule = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/PTDoc.UI/js/settings-keyboard.js");
            await _keyboardModule.InvokeVoidAsync("attachKeyboardGuards", _root);
        }
        catch (Exception)
        {
            // Blazor handlers still provide selection when interop is unavailable during
            // prerender, component tests, or circuit teardown.
        }
    }

    private void SelectTab(SettingsTab tab)
    {
        _activeTab = tab;
    }

    private async Task HandleTabKeyDownAsync(KeyboardEventArgs eventArgs, SettingsTab currentTab)
    {
        SettingsTab? targetTab = eventArgs.Key switch
        {
            "ArrowRight" => currentTab == SettingsTab.RolePermissions
                ? SettingsTab.SecuritySettings
                : SettingsTab.RolePermissions,
            "ArrowLeft" => currentTab == SettingsTab.RolePermissions
                ? SettingsTab.SecuritySettings
                : SettingsTab.RolePermissions,
            "Home" => SettingsTab.RolePermissions,
            "End" => SettingsTab.SecuritySettings,
            _ => null
        };

        if (targetTab is null)
        {
            return;
        }

        SelectTab(targetTab.Value);
        await GetTabReference(targetTab.Value).FocusAsync();
    }

    private ElementReference GetTabReference(SettingsTab tab) => tab switch
    {
        SettingsTab.RolePermissions => _rolePermissionsTab,
        SettingsTab.SecuritySettings => _securitySettingsTab,
        _ => throw new ArgumentOutOfRangeException(nameof(tab), tab, null)
    };

    private void SelectRole(string roleName)
    {
        _selectedRole = roleName;
        _cloneSourceRole = string.Empty;
        ApplySelectedRolePermissions();
    }

    private async Task SetPermissionLevel(PermissionDefinition permission, string level)
    {
        if (_isBusy || !_canMutate || SelectedRoleIsReadOnly || !permission.IsSupported ||
            !Enum.TryParse<PermissionLevel>(level, out var parsedLevel))
        {
            return;
        }

        var previousLevel = permission.SelectedLevel;
        permission.SelectedLevel = level;
        if (_roleService is null)
        {
            return;
        }

        _isBusy = true;
        _statusMessage = null;
        try
        {
            var result = await _roleService.UpdateAsync(
                Guid.Empty,
                _selectedRole,
                new UpdateRolePermissionsRequest([new PermissionUpdate(permission.Key, parsedLevel, permission.Version)]),
                Guid.Empty,
                string.Empty);
            if (!result.Succeeded || result.Value is null)
            {
                permission.SelectedLevel = previousLevel;
                ShowOperationError(result.Status, result.ValidationErrors);
                return;
            }

            _rolePermissionSets[_selectedRole] = result.Value;
            ApplySelectedRolePermissions();
            ShowStatus("Permission saved.", false);
        }
        catch (Exception)
        {
            permission.SelectedLevel = previousLevel;
            ShowStatus("The permission could not be saved. The previous value was restored.", true);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task HandlePermissionLevelKeyDownAsync(
        KeyboardEventArgs eventArgs,
        PermissionDefinition permission,
        int currentIndex)
    {
        var targetIndex = eventArgs.Key switch
        {
            "ArrowRight" or "ArrowDown" => (currentIndex + 1) % permission.AvailableLevels.Count,
            "ArrowLeft" or "ArrowUp" => (currentIndex - 1 + permission.AvailableLevels.Count) % permission.AvailableLevels.Count,
            "Home" => 0,
            "End" => permission.AvailableLevels.Count - 1,
            _ => -1
        };

        if (targetIndex < 0)
        {
            return;
        }

        await SetPermissionLevel(permission, permission.AvailableLevels[targetIndex]);
        await permission.GetLevelButton(targetIndex).FocusAsync();
    }

    private async Task ClonePermissions()
    {
        if (_roleService is null || !_canMutate || string.IsNullOrWhiteSpace(_cloneSourceRole) || SelectedRoleIsReadOnly)
        {
            return;
        }

        _isBusy = true;
        try
        {
            var result = await _roleService.CloneAsync(
                Guid.Empty,
                _selectedRole,
                new CloneRolePermissionsRequest(_cloneSourceRole),
                Guid.Empty,
                string.Empty);
            if (!result.Succeeded || result.Value is null)
            {
                ShowOperationError(result.Status, result.ValidationErrors);
                return;
            }

            _rolePermissionSets[_selectedRole] = result.Value;
            ApplySelectedRolePermissions();
            _cloneSourceRole = string.Empty;
            ShowStatus("Editable permissions were cloned; locked permissions were preserved.", false);
        }
        catch (Exception)
        {
            ShowStatus("Permissions could not be cloned. No local values were changed.", true);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void ToggleMfa() => _requireMfa = !_requireMfa;

    private void TogglePinChange() => _requirePinChange = !_requirePinChange;

    private void ToggleRoleCustomization() => _allowRoleCustomization = !_allowRoleCustomization;

    private void ToggleScheduleAccess() => _restrictScheduleAccess = !_restrictScheduleAccess;

    private async Task GoToRoles()
    {
        _activeTab = SettingsTab.RolePermissions;
        await Task.Yield();
        await _rolePermissionsTab.FocusAsync();
    }

    private void OpenAutoCheckInMessaging() => Navigation.NavigateTo("/settings/auto-check-in");

    private void OpenKioskCheckIn() => Navigation.NavigateTo("/settings/kiosk");

    private void RegenerateRecoveryCodes() => Navigation.NavigateTo(
        "/authentication-step-up?mode=recovery-codes&returnUrl=%2Fsettings");

    private void ResetSecuritySettings()
    {
        ApplySecurity(SecurityPolicyDefaults, updateSnapshot: false);
        _securityVersion = _securitySnapshot.Version;
        ShowStatus("Canonical defaults applied locally. Select Save Changes to persist them.", false);
    }

    private void CancelSecurityChanges()
    {
        ApplySecurity(_securitySnapshot.ToDto());
        ShowStatus("Unsaved security changes were discarded.", false);
    }

    private async Task SaveSecurityChanges()
    {
        if (!_canMutate) return;
        if (!int.TryParse(_autoLockoutTime, out var inactivityMinutes) ||
            !int.TryParse(_minimumPinLength, out var minimumPinLength))
        {
            ShowStatus("Session timeout and minimum PIN length must be whole numbers.", true);
            return;
        }

        if (_securityService is null)
        {
            _securitySnapshot = CaptureSecurity();
            ShowStatus("Security defaults updated locally.", false);
            return;
        }

        _isBusy = true;
        try
        {
            var result = await _securityService.UpdateAsync(
                Guid.Empty,
                new UpdateSecurityPolicyRequest(
                    _requireMfa ? MfaEnforcementMode.GracePeriod : MfaEnforcementMode.Off,
                    _requireMfa ? DateTime.UtcNow.AddDays(14) : null,
                    _requirePinChange,
                    minimumPinLength,
                    inactivityMinutes,
                    _allowRoleCustomization,
                    _restrictScheduleAccess,
                    AuthorizationRolloutMode.Static,
                    _securityVersion),
                Guid.Empty,
                string.Empty);
            if (!result.Succeeded || result.Value is null)
            {
                ShowOperationError(result.Status, result.ValidationErrors);
                return;
            }

            ApplySecurity(result.Value);
            ShowStatus("Security policy saved.", false);
        }
        catch (Exception)
        {
            ShowStatus("Security settings could not be saved. Your draft is still available to retry.", true);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void ApplyRoles(RolePermissionsResponse response)
    {
        _rolePermissionSets.Clear();
        foreach (var role in response.Roles)
        {
            _rolePermissionSets[role.RoleKey] = role;
        }

        Roles = response.Roles.Select(role => new RoleDefinition(
            role.RoleKey,
            role.DisplayName,
            GetRoleDescription(role.RoleKey),
            GetRoleDotClass(role.RoleKey),
            role.IsReadOnly)).ToArray();
        if (!_rolePermissionSets.ContainsKey(_selectedRole))
        {
            _selectedRole = response.Roles.FirstOrDefault()?.RoleKey ?? "PT";
        }
        ApplySelectedRolePermissions();
    }

    private void ApplySelectedRolePermissions()
    {
        if (!_rolePermissionSets.TryGetValue(_selectedRole, out var role))
        {
            return;
        }

        var byKey = role.Permissions.ToDictionary(item => item.CapabilityKey);
        foreach (var permission in _permissionCategories.SelectMany(category => category.Permissions))
        {
            if (!byKey.TryGetValue(permission.Key, out var persisted))
            {
                continue;
            }

            permission.SelectedLevel = persisted.Level.ToString();
            permission.Version = persisted.Version;
            permission.LockedMinimum = persisted.LockedMinimum;
            permission.IsSupported = persisted.IsSupported;
        }
    }

    private int PermissionCount(PermissionLevel level) => _permissionCategories
        .SelectMany(category => category.Permissions)
        .Count(permission => Enum.TryParse<PermissionLevel>(permission.SelectedLevel, out var selected) && selected == level);

    private void ApplySecurity(SecurityPolicyDto policy, bool updateSnapshot = true)
    {
        _requireMfa = policy.MfaEnforcementMode != MfaEnforcementMode.Off;
        _requirePinChange = policy.RequirePinChangeOnFirstLogin;
        _minimumPinLength = policy.MinimumPinLength.ToString();
        _autoLockoutTime = policy.SessionInactivityMinutes.ToString();
        _allowRoleCustomization = policy.AllowRoleCustomization;
        _restrictScheduleAccess = policy.RestrictCliniciansToOwnSchedules;
        _securityVersion = policy.Version;
        if (updateSnapshot)
        {
            _securitySnapshot = CaptureSecurity();
        }
    }

    private SecuritySnapshot CaptureSecurity() => new(
        _requireMfa,
        _requirePinChange,
        _minimumPinLength,
        _autoLockoutTime,
        _allowRoleCustomization,
        _restrictScheduleAccess,
        _securityVersion);

    private void ShowOperationError(SettingsOperationStatus status, IReadOnlyDictionary<string, string[]>? validationErrors)
    {
        var validationMessage = validationErrors?.Values.SelectMany(messages => messages).FirstOrDefault();
        ShowStatus(status switch
        {
            SettingsOperationStatus.Conflict => "These settings changed in another session. Reload before retrying so your draft is not discarded.",
            SettingsOperationStatus.Forbidden => "Your account has read-only access to these settings.",
            SettingsOperationStatus.ValidationFailed => validationMessage ?? "One or more settings are invalid.",
            _ => "The Settings request could not be completed."
        }, true);
    }

    private void ShowStatus(string message, bool isError)
    {
        _statusMessage = message;
        _statusIsError = isError;
    }

    private static string GetRoleDescription(string roleKey) => roleKey switch
    {
        "Admin" => "Full recovery administration",
        "Owner" => "Read-only operational access",
        "PracticeManager" => "Manage clinic operations and staff",
        "PT" => "Licensed physical therapist",
        "PTA" => "Physical therapist assistant",
        "Aide" => "Support staff for therapy sessions",
        "FrontDesk" => "Patient intake and scheduling",
        "Billing" => "Handle billing and insurance",
        _ => "Patient portal access only"
    };

    private static string GetRoleDotClass(string roleKey) => roleKey switch
    {
        "Admin" or "PracticeManager" => "role-card__dot--manager",
        "Owner" => "role-card__dot--owner",
        "PT" => "role-card__dot--pt",
        "PTA" => "role-card__dot--pta",
        "Aide" => "role-card__dot--aide",
        "FrontDesk" => "role-card__dot--front-desk",
        "Billing" => "role-card__dot--billing",
        _ => "role-card__dot--patient"
    };

    private static SecurityPolicyDto SecurityPolicyDefaults => new(
        MfaEnforcementMode.Off, null, true, 8, 15, true, false,
        AuthorizationRolloutMode.Static, true, 0);

