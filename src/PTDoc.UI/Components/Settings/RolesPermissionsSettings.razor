            [
                new("View Own Schedule", "See personal appointments and availability", "View", ["None", "View"]),
                new("View All Schedules", "See schedules for all clinicians", "View", ["None", "View"]),
                new("Create Appointments", "Book new patient appointments", "Edit", ["None", "Edit"]),
                new("Modify Appointments", "Reschedule or cancel appointments", "Edit", ["None", "Edit"]),
