                id="@id"
                type="text"
                inputmode="numeric"
                value="@value"
                @oninput="eventArgs => valueChanged(eventArgs.Value?.ToString() ?? string.Empty)" />
        </div>
    </text>;

    private static IReadOnlyList<PermissionCategory> CreatePermissionCategories() =>
