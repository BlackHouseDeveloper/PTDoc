<section class="roles-permissions" aria-labelledby="roles-permissions-title">
    <header class="roles-permissions__header">
        <img src="_content/PTDoc.UI/images/settings/role-selector.svg" alt="" aria-hidden="true" />
        <div>
            <h1 id="roles-permissions-title">Roles &amp; Permissions</h1>
            <p>Manage user roles, access levels, and permission sets</p>
        </div>
    </header>

    <div class="roles-permissions__tabs" role="tablist" aria-label="Roles and security settings">
        <button
            @ref="_rolePermissionsTab"
            type="button"
            id="role-permissions-tab"
            class="roles-permissions__tab @(_activeTab == SettingsTab.RolePermissions ? "is-active" : string.Empty)"
            role="tab"
            aria-selected="@(_activeTab == SettingsTab.RolePermissions ? "true" : "false")"
            aria-controls="roles-settings-panel"
            tabindex="@(_activeTab == SettingsTab.RolePermissions ? "0" : "-1")"
            @onclick="() => SelectTab(SettingsTab.RolePermissions)"
            @onkeydown="eventArgs => HandleTabKeyDownAsync(eventArgs, SettingsTab.RolePermissions)">
            <img src="_content/PTDoc.UI/images/settings/roles-tab.svg" alt="" aria-hidden="true" />
            <span>Role Permissions</span>
        </button>
        <button
            @ref="_securitySettingsTab"
            type="button"
            id="security-settings-tab"
            class="roles-permissions__tab @(_activeTab == SettingsTab.SecuritySettings ? "is-active" : string.Empty)"
            role="tab"
            aria-selected="@(_activeTab == SettingsTab.SecuritySettings ? "true" : "false")"
            aria-controls="roles-settings-panel"
            tabindex="@(_activeTab == SettingsTab.SecuritySettings ? "0" : "-1")"
            @onclick="() => SelectTab(SettingsTab.SecuritySettings)"
            @onkeydown="eventArgs => HandleTabKeyDownAsync(eventArgs, SettingsTab.SecuritySettings)">
            <img src="_content/PTDoc.UI/images/settings/security-tab.svg" alt="" aria-hidden="true" />
            <span>Security Settings</span>
        </button>
    </div>

    @if (_activeTab == SettingsTab.RolePermissions)
    {
        <div
            id="roles-settings-panel"
            class="roles-permissions__tabpanel"
            role="tabpanel"
            aria-labelledby="role-permissions-tab">
            <aside class="permission-guidance" aria-labelledby="permission-guidance-title">
                <img class="permission-guidance__icon" src="_content/PTDoc.UI/images/settings/guidance-info.svg" alt="" aria-hidden="true" />
                <div>
                    <h2 id="permission-guidance-title">How to Use the Permission Matrix</h2>
                    <ul>
                        <li><strong>None:</strong> No access to this feature</li>
                        <li><strong>View:</strong> Read-only access (can see but not modify)</li>
                        <li><strong>Edit:</strong> Can create and modify (standard user access)</li>
                        <li><strong>Full:</strong> Complete control including delete and admin actions</li>
                        <li class="permission-guidance__status">
                            <img src="_content/PTDoc.UI/images/settings/guidance-locked.svg" alt="" aria-hidden="true" />
                            <span>Locked permissions are system-required and cannot be changed</span>
                        </li>
                        <li class="permission-guidance__status">
                            <img src="_content/PTDoc.UI/images/settings/guidance-recommended.svg" alt="" aria-hidden="true" />
                            <span>Recommended permissions are suggested for optimal workflow</span>
                        </li>
                    </ul>
                </div>
            </aside>

            <section class="settings-panel role-selector" aria-labelledby="role-selector-title">
                <header class="settings-panel__header">
                    <div class="settings-panel__title">
                        <img src="_content/PTDoc.UI/images/settings/role-selector.svg" alt="" aria-hidden="true" />
                        <h2 id="role-selector-title">Select Role to Configure</h2>
                    </div>
                    <p>Choose a role to view and edit its permissions</p>
                </header>

                <div class="role-selector__grid">
                    @foreach (var role in Roles)
                    {
                        <button
                            type="button"
                            class="role-card @(role.Name == _selectedRole ? "is-selected" : string.Empty)"
                            aria-pressed="@(role.Name == _selectedRole ? "true" : "false")"
                            @onclick="() => SelectRole(role.Name)">
                            <span class="role-card__identity">
                                <span class="role-card__dot @role.DotClass" aria-hidden="true"></span>
                                <span class="role-card__name">@role.Name</span>
                            </span>
                            <span class="role-card__description">@role.Description</span>
                        </button>
                    }
                </div>
            </section>

            <section class="clone-permissions" aria-labelledby="clone-permissions-title">
                <img class="clone-permissions__icon" src="_content/PTDoc.UI/images/settings/clone.svg" alt="" aria-hidden="true" />
                <div class="clone-permissions__copy">
                    <h2 id="clone-permissions-title">Clone Permissions</h2>
                    <p>Copy permissions from another role to @_selectedRole</p>
                </div>
                <div class="clone-permissions__actions">
                    <label class="roles-permissions__sr-only" for="clone-role-select">Source role</label>
                    <select id="clone-role-select" @bind="_cloneSourceRole">
                        <option value=""></option>
                        @foreach (var role in Roles.Where(role => role.Name != _selectedRole))
                        {
                            <option value="@role.Name">@role.Name</option>
                        }
                    </select>
                    <button type="button" @onclick="ClonePermissions">Clone</button>
                </div>
            </section>

            @foreach (var category in _permissionCategories)
            {
                <section class="settings-panel permission-category" aria-labelledby="@category.TitleId">
                    <header class="settings-panel__header settings-panel__header--compact">
                        <div class="settings-panel__title">
                            <img src="@category.IconPath" alt="" aria-hidden="true" />
                            <h2 id="@category.TitleId">@category.Title</h2>
                        </div>
                    </header>

                    <div class="permission-category__rows">
                        @foreach (var permission in category.Permissions)
                        {
                            <div class="permission-row">
                                <div class="permission-row__copy">
                                    <div class="permission-row__label">
                                        <span>@permission.Name</span>
                                        @if (permission.IsRecommended)
                                        {
                                            <img src="_content/PTDoc.UI/images/settings/permission-recommended.svg" alt="" aria-hidden="true" />
                                            <span class="roles-permissions__sr-only">Recommended permission</span>
                                        }
                                        <img src="_content/PTDoc.UI/images/settings/permission-info.svg" alt="" aria-hidden="true" />
                                    </div>
                                    <p>@permission.Description</p>
                                </div>
                                <div class="permission-row__options" role="radiogroup" aria-label="@($"{permission.Name} permission")">
                                    @{
                                        var firstLevel = permission.AvailableLevels[0];
                                        var secondLevel = permission.AvailableLevels[1];
                                        <button
                                            @ref="permission.FirstLevelButton"
                                            type="button"
                                            class="permission-level @(permission.SelectedLevel == firstLevel ? "is-selected" : string.Empty)"
                                            role="radio"
                                            aria-checked="@(permission.SelectedLevel == firstLevel ? "true" : "false")"
                                            aria-label="@($"{permission.Name}: {firstLevel}")"
                                            tabindex="@(permission.SelectedLevel == firstLevel ? "0" : "-1")"
                                            @onclick="() => SetPermissionLevel(permission, firstLevel)"
                                            @onkeydown="eventArgs => HandlePermissionLevelKeyDownAsync(eventArgs, permission, 0)">
                                            @firstLevel
                                        </button>
                                        <button
                                            @ref="permission.SecondLevelButton"
                                            type="button"
                                            class="permission-level @(permission.SelectedLevel == secondLevel ? "is-selected" : string.Empty)"
                                            role="radio"
                                            aria-checked="@(permission.SelectedLevel == secondLevel ? "true" : "false")"
                                            aria-label="@($"{permission.Name}: {secondLevel}")"
                                            tabindex="@(permission.SelectedLevel == secondLevel ? "0" : "-1")"
                                            @onclick="() => SetPermissionLevel(permission, secondLevel)"
                                            @onkeydown="eventArgs => HandlePermissionLevelKeyDownAsync(eventArgs, permission, 1)">
                                            @secondLevel
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </section>
            }

            <section class="permission-summary" aria-labelledby="permission-summary-title">
                <header class="permission-summary__header">
                    <img src="_content/PTDoc.UI/images/settings/summary.svg" alt="" aria-hidden="true" />
                    <h2 id="permission-summary-title">Permission Summary for PT / DPT</h2>
                </header>
                <div class="permission-summary__metrics">
                    <div><strong>2</strong><span>Full Access</span></div>
                    <div><strong>7</strong><span>Edit Access</span></div>
                    <div><strong>6</strong><span>View Only</span></div>
                    <div><strong>15</strong><span>No Access</span></div>
                </div>
            </section>

            @QuickAdminTools()
        </div>
    }
    else
    {
        <div
            id="roles-settings-panel"
            class="roles-permissions__tabpanel"
            role="tabpanel"
            aria-labelledby="security-settings-tab">
            <section class="settings-panel security-card" aria-labelledby="security-requirements-title">
                <header class="settings-panel__header">
                    <div class="settings-panel__title">
                        <img src="_content/PTDoc.UI/images/settings/security-requirements.svg" alt="" aria-hidden="true" />
                        <h2 id="security-requirements-title">Security Requirements</h2>
                    </div>
                    <p>Configure authentication and security policies</p>
                </header>
                <div class="security-card__rows">
                    @SecurityToggle("Require Multi-Factor Authentication", "All users must enable 2FA for account access", _requireMfa, ToggleMfa)
                    @SecurityToggle("Require PIN Change on First Login", "Force new users to create their own PIN", _requirePinChange, TogglePinChange)
                    @SecurityInput("auto-lockout-time", "Auto-Lockout Time", "Automatically lock session after inactivity", _autoLockoutTime, value => _autoLockoutTime = value)
                    @SecurityInput("password-expiration", "Password Expiration", "Require password reset every X days", _passwordExpiration, value => _passwordExpiration = value)
                    @SecurityInput("minimum-password-length", "Minimum Password Length", "Enforce minimum character count for passwords", _minimumPasswordLength, value => _minimumPasswordLength = value)
                </div>
            </section>

            <section class="settings-panel security-card" aria-labelledby="role-management-title">
                <header class="settings-panel__header">
                    <div class="settings-panel__title">
                        <img src="_content/PTDoc.UI/images/settings/role-management.svg" alt="" aria-hidden="true" />
                        <h2 id="role-management-title">Role Management</h2>
                    </div>
                    <p>Configure role capabilities and customization options</p>
                </header>
                <div class="security-card__rows security-card__rows--compact">
                    @SecurityToggle("Allow Role Customization", "Enable admins to customize permissions for clinical roles", _allowRoleCustomization, ToggleRoleCustomization)
                    @SecurityToggle("Enable Audit Log", "Track all permission changes and role assignments", _enableAuditLog, ToggleAuditLog)
                    <button type="button" class="manage-roles-row" @onclick="GoToRoles">
                        <span class="manage-roles-row__copy">
                            <img src="_content/PTDoc.UI/images/settings/manage-roles.svg" alt="" aria-hidden="true" />
                            <span>
                                <strong>Manage Individual Roles</strong>
                                <small>View and edit detailed role permissions</small>
                            </span>
                        </span>
                        <span class="manage-roles-row__action">Go to Roles</span>
                    </button>
                </div>
            </section>

            <section class="settings-panel security-card" aria-labelledby="access-control-title">
                <header class="settings-panel__header">
                    <div class="settings-panel__title">
                        <img src="_content/PTDoc.UI/images/settings/access-control.svg" alt="" aria-hidden="true" />
                        <h2 id="access-control-title">Access Control</h2>
                    </div>
                    <p>Control what users can see and access</p>
                </header>
                <div class="security-card__rows security-card__rows--compact">
                    @SecurityToggle("Restrict Schedule Access", "Limit clinicians to view only their own schedule", _restrictScheduleAccess, ToggleScheduleAccess)
                    <aside class="hipaa-callout" aria-labelledby="hipaa-compliance-title">
                        <img src="_content/PTDoc.UI/images/settings/hipaa-warning.svg" alt="" aria-hidden="true" />
                        <div>
                            <h3 id="hipaa-compliance-title">HIPAA Compliance</h3>
                            <p>This preview illustrates controls required for HIPAA-conscious operations. Audit retention and enforcement require backend policy integration; changes here are not yet persisted.</p>
                        </div>
                    </aside>
                </div>
            </section>

            @QuickAdminTools()

            <div class="security-action-bar" aria-label="Security settings actions">
                <button type="button" @onclick="ResetSecuritySettings">
                    <img src="_content/PTDoc.UI/images/settings/reset.svg" alt="" aria-hidden="true" />
                    <span>Reset to Default</span>
                </button>
                <button type="button" @onclick="CancelSecurityChanges">
                    <img src="_content/PTDoc.UI/images/settings/cancel.svg" alt="" aria-hidden="true" />
                    <span>Cancel</span>
                </button>
                <button type="button" class="security-action-bar__save" @onclick="SaveSecurityChanges">
                    <img src="_content/PTDoc.UI/images/settings/save.svg" alt="" aria-hidden="true" />
                    <span>Save Changes</span>
                </button>
            </div>
        </div>
    }
</section>

@code {
    private SettingsTab _activeTab = SettingsTab.RolePermissions;
    private ElementReference _rolePermissionsTab;
    private ElementReference _securitySettingsTab;
    private string _selectedRole = "PT / DPT";
    private string _cloneSourceRole = string.Empty;
    private bool _requireMfa = true;
    private bool _requirePinChange = true;
    private bool _allowRoleCustomization = true;
    private bool _enableAuditLog = true;
    private bool _restrictScheduleAccess;
