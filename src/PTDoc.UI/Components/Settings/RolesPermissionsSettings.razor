        new("PT / DPT", "Licensed physical therapist", "role-card__dot--pt"),
        new("PTA", "Physical therapist assistant", "role-card__dot--pta"),
        new("Therapy Aide / Rehab Tech", "Support staff for therapy sessions", "role-card__dot--aide"),
        new("Front Desk / Patient Care Coordinator", "Patient intake and scheduling", "role-card__dot--front-desk"),
        new("Billing Specialist", "Handle billing and insurance", "role-card__dot--billing"),
        new("Patient", "Patient portal access only", "role-card__dot--patient")
    ];

    private readonly IReadOnlyList<PermissionCategory> _permissionCategories = CreatePermissionCategories();

    private void SelectTab(SettingsTab tab)
