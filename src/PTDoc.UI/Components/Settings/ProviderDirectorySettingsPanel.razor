@using PTDoc.Application.Providers
@inject IProviderDirectoryService ProviderDirectory
@inject IToastService ToastService

<section class="settings-section-card provider-admin" aria-labelledby="provider-directory-title">
    <header class="settings-section-header provider-admin__header">
        <div><h1 id="provider-directory-title">Provider Directory</h1><p>Review external provider candidates and maintain the clinic-approved referral directory.</p></div>
        <button type="button" class="btn btn-outline" @onclick="LoadAsync" disabled="@isBusy">Refresh</button>
    </header>

    @if (!string.IsNullOrWhiteSpace(error)) { <div class="provider-admin__state provider-admin__state--error" role="alert">@error</div> }

    <div class="provider-admin__toolbar">
        <label><span>Search providers</span><input class="form-control" @bind="search" @bind:event="oninput" placeholder="Name, organization, or NPI" /></label>
        <button type="button" class="btn btn-primary" @onclick="LoadAsync" disabled="@isBusy">Search</button>
        <button type="button" class="btn btn-outline" @onclick="ToggleCreate" disabled="@isBusy">@(showCreate ? "Close form" : "Submit provider")</button>
    </div>

    @if (showCreate)
    {
        <section class="provider-admin__editor" aria-labelledby="submit-provider-title">
            <h2 id="submit-provider-title">@(editingProviderId.HasValue ? "Edit provider" : "Submit provider candidate")</h2>
            <div class="provider-admin__form-grid">
                <label><span>First name</span><input class="form-control" @bind="draft.FirstName" @bind:event="oninput" /></label>
                <label><span>Last name</span><input class="form-control" @bind="draft.LastName" @bind:event="oninput" /></label>
                <label><span>Credentials</span><input class="form-control" @bind="draft.Credentials" @bind:event="oninput" /></label>
                <label><span>NPI</span><input class="form-control" inputmode="numeric" maxlength="10" @bind="draft.Npi" @bind:event="oninput" /></label>
                <label><span>Specialty</span><input class="form-control" @bind="draft.Specialty" @bind:event="oninput" /></label>
                <label><span>Organization</span><input class="form-control" @bind="draft.OrganizationName" @bind:event="oninput" /></label>
                <label><span>Phone</span><input class="form-control" type="tel" @bind="draft.Phone" @bind:event="oninput" /></label>
                <label><span>Fax</span><input class="form-control" type="tel" maxlength="30" @bind="draft.Fax" @bind:event="oninput" /></label>
            </div>
            <button type="button" class="btn btn-primary" @onclick="SubmitAsync" disabled="@isBusy">@(editingProviderId.HasValue ? "Save changes" : "Submit for approval")</button>
            <button type="button" class="btn btn-outline" @onclick="CloseEditor" disabled="@isBusy">Cancel</button>
        </section>
    }

    @if (deletingProvider is not null)
    {
        <section class="provider-admin__editor" aria-labelledby="delete-provider-title">
            <h2 id="delete-provider-title">Delete @deletingProvider.DisplayName from the directory?</h2>
            <p>This removes the provider from future selection. Existing patient links and saved clinical records remain available.</p>
            <button type="button" class="btn btn-primary" @onclick="DeleteAsync" disabled="@isBusy">Delete from directory</button>
            <button type="button" class="btn btn-outline" @onclick="() => deletingProvider = null" disabled="@isBusy">Keep provider</button>
        </section>
    }

    @if (isLoading) { <div class="provider-admin__state" role="status">Loading provider directory…</div> }
    else
    {
        <section aria-labelledby="pending-providers-title">
            <h2 id="pending-providers-title">Pending approval <span class="provider-admin__count">@pending.Count</span></h2>
            @if (pending.Count == 0) { <p class="provider-admin__state">No provider candidates are awaiting review.</p> }
            else
            {
                <div class="provider-admin__list">
                    @foreach (var provider in pending)
                    {
                        <article class="provider-admin__row">
                            <div><strong>@provider.DisplayName</strong><span>@FormatMeta(provider)</span>
                                @if (provider.PossibleDuplicates.Count > 0)
                                {
                                    <span class="provider-admin__warning">Possible duplicate — review before approval</span>
                                    @foreach (var duplicate in provider.PossibleDuplicates)
                                    {
                                        <span>@duplicate.DisplayName (@duplicate.Reason · @duplicate.Status)</span>
                                        @if (duplicate.Status == ProviderDirectoryStatus.Active)
                                        {
                                            <button type="button" class="btn btn-outline" @onclick="() => MergeAsync(provider.Id, duplicate.Id)" disabled="@isBusy">Merge into @duplicate.DisplayName</button>
                                        }
                                    }
                                }
                            </div>
                            <div class="provider-admin__actions">
                                <button type="button" class="btn btn-outline" @onclick="() => EditProvider(provider)" disabled="@isBusy">Edit</button>
                                <button type="button" class="btn btn-outline" @onclick="() => RequestDelete(provider)" disabled="@isBusy">Delete</button>
                                @if (!RequiresNpiMerge(provider))
                                {
                                    <button type="button" class="btn btn-primary" @onclick="() => ApproveAsync(provider.Id, provider.PossibleDuplicates.Count > 0)" disabled="@isBusy">@(provider.PossibleDuplicates.Count > 0 ? "Approve as separate" : "Approve")</button>
                                }
                                <button type="button" class="btn btn-outline" @onclick="() => RejectAsync(provider.Id)" disabled="@isBusy">Reject</button>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>

        <section aria-labelledby="active-providers-title">
            <h2 id="active-providers-title">Active directory <span class="provider-admin__count">@active.Count</span></h2>
            @if (active.Count == 0) { <p class="provider-admin__state">No active providers match this search.</p> }
            else
            {
                <div class="provider-admin__list">
                    @foreach (var provider in active)
                    {
                        <article class="provider-admin__row"><div><strong>@provider.DisplayName</strong><span>@FormatMeta(provider)</span></div><div class="provider-admin__actions"><button type="button" class="btn btn-outline" @onclick="() => EditProvider(provider)" disabled="@isBusy">Edit</button><button type="button" class="btn btn-outline" @onclick="() => RequestDelete(provider)" disabled="@isBusy">Delete</button></div></article>
                    }
                </div>
            }
        </section>
    }
</section>

@code {
    private List<ProviderDirectoryEntryDto> pending=[]; private List<ProviderDirectoryEntryDto> active=[];
    private Guid? editingProviderId;
    private ProviderDirectoryEntryDto? deletingProvider;
    private UpdateProviderCandidateRequest draft=new(); private string search=string.Empty; private string? error; private bool isLoading=true; private bool isBusy; private bool showCreate;
    protected override Task OnInitializedAsync()=>LoadAsync();
    private async Task LoadAsync(){isLoading=true;error=null;try{var pendingTask=ProviderDirectory.SearchForAdministrationAsync(search,ProviderDirectoryStatus.Pending,100,default);var activeTask=ProviderDirectory.SearchForAdministrationAsync(search,ProviderDirectoryStatus.Active,100,default);await Task.WhenAll(pendingTask,activeTask);pending=[..pendingTask.Result];active=[..activeTask.Result];}catch(Exception ex){error=ex.Message;}finally{isLoading=false;}}
    private void ToggleCreate()
    {
        if (showCreate) CloseEditor();
        else { draft = new(); editingProviderId = null; showCreate = true; error = null; deletingProvider = null; }
    }

    private void CloseEditor() { showCreate = false; editingProviderId = null; draft = new(); error = null; }

    private void EditProvider(ProviderDirectoryEntryDto provider)
    {
        editingProviderId = provider.Id;
        draft = new()
        {
            FirstName = provider.FirstName, LastName = provider.LastName, Credentials = provider.Credentials,
            Npi = provider.Npi, Specialty = provider.Specialty, TaxonomyCode = provider.TaxonomyCode,
            OrganizationName = provider.OrganizationName, Phone = provider.Phone, Fax = provider.Fax,
            Email = provider.Email, AddressLine1 = provider.AddressLine1, AddressLine2 = provider.AddressLine2,
            City = provider.City, State = provider.State, ZipCode = provider.ZipCode,
            SubmissionSource = provider.SubmissionSource, ExpectedLastModifiedUtc = provider.LastModifiedUtc
        };
        showCreate = true;
        deletingProvider = null;
        error = null;
    }

    private async Task SubmitAsync()
    {
        if (isBusy) return;
        if (string.IsNullOrWhiteSpace(draft.FirstName) || string.IsNullOrWhiteSpace(draft.LastName))
        { error = "First and last name are required."; return; }
        isBusy = true;
        error = null;
        try
        {
            if (editingProviderId.HasValue)
            {
                await ProviderDirectory.UpdateForAdministrationAsync(editingProviderId.Value, draft, default);
                ToastService.ShowSuccess("Provider changes saved.");
            }
            else
            {
                await ProviderDirectory.SubmitAsync(draft, default);
                ToastService.ShowSuccess("Provider candidate submitted for approval.");
            }
            CloseEditor();
            await LoadAsync();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { isBusy = false; }
    }

    private void RequestDelete(ProviderDirectoryEntryDto provider)
    {
        CloseEditor();
        deletingProvider = provider;
    }

    private async Task DeleteAsync()
    {
        if (isBusy || deletingProvider is null) return;
        isBusy = true;
        error = null;
        try
        {
            await ProviderDirectory.ArchiveAsync(deletingProvider.Id, new()
            {
                ExpectedLastModifiedUtc = deletingProvider.LastModifiedUtc,
                Reason = "Removed from future selection in provider directory settings."
            }, default);
            deletingProvider = null;
            ToastService.ShowSuccess("Provider removed from future selection. Historical records are preserved.");
            await LoadAsync();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { isBusy = false; }
    }

    private Task ApproveAsync(Guid id,bool confirmDuplicate)=>DecideAsync(id,true,confirmDuplicate);private Task RejectAsync(Guid id)=>DecideAsync(id,false,false);
    private async Task DecideAsync(Guid id,bool approve,bool confirmDuplicate){isBusy=true;try{if(approve)await ProviderDirectory.ApproveAsync(id,new(){ConfirmDuplicate=confirmDuplicate,Reason=confirmDuplicate?"Confirmed as a separate provider during duplicate review.":null},default);else await ProviderDirectory.RejectAsync(id,new(){Reason="Rejected during directory review."},default);ToastService.ShowSuccess(approve?"Provider approved.":"Provider candidate rejected.");await LoadAsync();}catch(Exception ex){error=ex.Message;}finally{isBusy=false;}}
    private async Task MergeAsync(Guid candidateId,Guid targetId){isBusy=true;try{await ProviderDirectory.ApproveAsync(candidateId,new(){MergeIntoProviderId=targetId,Reason="Merged during duplicate review."},default);ToastService.ShowSuccess("Provider candidate merged.");await LoadAsync();}catch(Exception ex){error=ex.Message;}finally{isBusy=false;}}
    private static bool RequiresNpiMerge(ProviderDirectoryEntryDto provider)=>provider.PossibleDuplicates.Any(duplicate=>duplicate.Status==ProviderDirectoryStatus.Active&&duplicate.Reason=="Exact NPI match");
    private static string FormatMeta(ProviderDirectoryEntryDto p)=>string.Join(" · ",new[]{p.OrganizationName,p.Specialty,string.IsNullOrWhiteSpace(p.Npi)?null:$"NPI {p.Npi}"}.Where(v=>!string.IsNullOrWhiteSpace(v)));
}
