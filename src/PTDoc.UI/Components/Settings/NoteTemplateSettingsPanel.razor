@using PTDoc.Application.NoteTemplates
@inject INoteTemplateAdministrationService Templates
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IToastService ToastService

<section class="settings-section-card template-admin" aria-labelledby="template-admin-title">
    <header class="settings-section-header template-admin__header"><div><h1 id="template-admin-title">Documentation Templates</h1><p>Configure tenant note layouts with immutable, clinically approved versions.</p></div><button type="button" class="btn btn-outline" @onclick="LoadAsync" disabled="@isBusy">Refresh</button></header>
    @if(!string.IsNullOrWhiteSpace(error)){<div class="template-admin__state template-admin__state--error" role="alert">@error</div>}
    @if(isLoading){<div class="template-admin__state" role="status">Loading note templates…</div>}
    else if(isPtApprover){
        <section aria-labelledby="clinical-approval-title"><h2 id="clinical-approval-title">Clinical template governance</h2><p>Review pending configurations and manage published versions. Compliance hard stops cannot be disabled here.</p>
        @if(summaries.Count==0){<div class="template-admin__state">No tenant templates are available for clinical review.</div>}else{<div class="template-admin__list">@foreach(var item in summaries){<button type="button" class="template-admin__row template-admin__row--button" @onclick="()=>OpenAsync(item)"><span><strong>@item.Name</strong><small>@Label(item.NoteType,item.Variant)</small></span><span class="template-admin__badge">@(item.LatestStatus?.ToString()??"Baseline")</span></button>}</div>}</section>
    }else{
        <section class="template-admin__create" aria-labelledby="new-template-title"><h2 id="new-template-title">Create tenant draft</h2><div class="template-admin__form-grid"><label><span>Name</span><input class="form-control" @bind="newName" /></label><label><span>Note type</span><select class="form-select" @bind="newType">@foreach(var type in Enum.GetValues<NoteType>()){<option value="@type">@type</option>}</select></label><label><span>Variant</span><select class="form-select" @bind="newVariant"><option value="@NoteTemplateVariant.Standard">Standard</option>@if(newType==NoteType.Evaluation){<option value="@NoteTemplateVariant.ReEvaluation">Re-evaluation</option>}@if(newType==NoteType.Daily){<option value="@NoteTemplateVariant.DryNeedling">Dry Needling</option>}</select></label></div><button type="button" class="btn btn-primary" @onclick="CreateAsync" disabled="@isBusy">Create from baseline</button></section>
        <section aria-labelledby="tenant-templates-title"><h2 id="tenant-templates-title">Tenant templates</h2>@if(summaries.Count==0){<div class="template-admin__state">No tenant templates yet. Packaged baseline templates remain active.</div>}else{<div class="template-admin__list">@foreach(var item in summaries){<button type="button" class="template-admin__row template-admin__row--button" @onclick="()=>OpenAsync(item)"><span><strong>@item.Name</strong><small>@Label(item.NoteType,item.Variant)</small></span><span class="template-admin__badge">@(item.LatestStatus?.ToString()??"Baseline")</span></button>}</div>}</section>
    }

    @if(selected is not null){<section class="template-admin__editor" aria-labelledby="template-editor-title"><div class="template-admin__editor-header"><div><h2 id="template-editor-title">@(isPtApprover?"Clinical preview":"Template builder")</h2><p>Version @selected.VersionNumber · @selected.Status</p></div><button type="button" class="btn btn-outline" @onclick="CloseEditor">Close</button></div>
        @if(validationSummary is not null){<div class="template-admin__validation" role="status" aria-live="polite"><strong>@(validationSummary.IsValid?"Template is valid":"Template requires changes")</strong>@foreach(var validationError in validationSummary.Errors){<span class="template-admin__validation-error">@validationError</span>}@foreach(var warning in validationSummary.Warnings){<span>@warning</span>}</div>}
        @if(versionHistory.Count>0){<aside class="template-admin__history" aria-label="Version history"><strong>Version history</strong>@foreach(var version in versionHistory){<button type="button" class="btn btn-outline" @onclick="()=>OpenVersionAsync(version.Id)">Version @version.VersionNumber · @version.Status</button>}</aside>}
        @if(publishedComparison is not null&&publishedComparison.Id!=selected.Id){<div class="template-admin__state">Compared with published version @publishedComparison.VersionNumber: @DescribeComparison(selected.Schema,publishedComparison.Schema)</div>}
        <div class="template-admin__preview" aria-label="Template sections">
        @foreach(var section in selected.Schema.Sections.OrderBy(s=>s.Order)){
            <article class="template-admin__section"><div class="template-admin__section-heading">@if(isPtApprover||selected.Status==NoteTemplateVersionStatus.Published){<div><strong>@(section.Label)</strong><small>@(section.Key) · @(section.RendererKey) · Order @(section.Order)</small></div>}else{<label><span>Section label</span><input class="form-control" @bind="section.Label" /></label><label><span>Order</span><input class="form-control" type="number" @bind="section.Order" /></label><label class="template-admin__check"><input type="checkbox" @bind="section.IsVisible" /><span>Visible</span></label>} </div>
                @if(section.Fields.Count==0){<p class="template-admin__empty">Existing specialized section component</p>}else{<div class="template-admin__fields">@foreach(var field in section.Fields.OrderBy(f=>f.Order)){<div class="template-admin__field">@if(isPtApprover||selected.Status==NoteTemplateVersionStatus.Published){<span><strong>@field.Label</strong><small>@field.BindingKey · @field.RendererKey @(field.IsRequired?"· Required":"")</small></span>@if(field.Choices.Count>0){<small>Choices: @string.Join(", ",field.Choices.OrderBy(choice=>choice.Order).Select(choice=>choice.Label))</small>}@if(field.VisibilityConditions.Count>0){<small>Conditional visibility: @field.VisibilityConditions.Count rule(s)</small>}}else{<label><span>Field label</span><input class="form-control" @bind="field.Label" /></label><label><span>Binding</span><input class="form-control" @bind="field.BindingKey" /></label><label><span>Renderer</span><select class="form-select" @bind="field.RendererKey"><option>text</option><option>textarea</option><option>number</option><option>date</option><option>select</option><option>multi-select</option><option>checkbox</option></select></label><label><span>Help text</span><input class="form-control" @bind="field.HelpText" /></label><label><span>Default value</span><input class="form-control" @bind="field.DefaultValue" /></label><label><span>Choice source</span><select class="form-select" @bind="field.ChoiceSourceKey"><option value="">Static / none</option><option>body-regions</option><option>functional-limitations</option><option>assistive-devices</option><option>comorbidities</option><option>special-tests</option><option>outcome-measures</option><option>treatment-interventions</option><option>cpt</option><option>icd10</option></select></label><label><span>Order</span><input class="form-control" type="number" @bind="field.Order" /></label><label class="template-admin__check"><input type="checkbox" @bind="field.IsVisible" /><span>Visible</span></label><label class="template-admin__check"><input type="checkbox" @bind="field.IsRequired" /><span>Required</span></label><div class="template-admin__nested"><strong>Static choices</strong>@foreach(var choice in field.Choices.OrderBy(choice=>choice.Order)){<label><span>Label</span><input class="form-control" @bind="choice.Label" /></label><label><span>Value</span><input class="form-control" @bind="choice.Value" /></label><button type="button" class="btn btn-outline" @onclick="()=>field.Choices.Remove(choice)">Remove choice</button>}<button type="button" class="btn btn-outline" @onclick="()=>AddChoice(field)">Add choice</button></div><div class="template-admin__nested"><strong>Visibility rules</strong>@foreach(var condition in field.VisibilityConditions){<label><span>Source binding</span><input class="form-control" @bind="condition.SourceBindingKey" /></label><label><span>Operator</span><select class="form-select" @bind="condition.Operator">@foreach(var op in Enum.GetValues<NoteTemplateConditionOperator>()){<option value="@op">@op</option>}</select></label><label><span>Expected value</span><input class="form-control" @bind="condition.ExpectedValue" /></label><button type="button" class="btn btn-outline" @onclick="()=>field.VisibilityConditions.Remove(condition)">Remove rule</button>}<button type="button" class="btn btn-outline" @onclick="()=>AddCondition(field)">Add visibility rule</button></div><button type="button" class="btn btn-outline" @onclick="()=>section.Fields.Remove(field)">Remove field</button>}</div>}</div>}
                @if(!isPtApprover&&(selected.Status==NoteTemplateVersionStatus.Draft||selected.Status==NoteTemplateVersionStatus.Rejected)){<button type="button" class="btn btn-outline" @onclick="()=>AddField(section)">Add field</button>}
            </article>}
        </div>
        <div class="template-admin__actions">@if(!isPtApprover){<button type="button" class="btn btn-outline" @onclick="ValidateSelectedAsync" disabled="@isBusy">Validate template</button>}@if(isPtApprover&&selected.Status==NoteTemplateVersionStatus.PendingClinicalApproval){<label class="template-admin__comment"><span>Clinical review comment</span><textarea class="form-control" @bind="reviewComment"></textarea></label><button type="button" class="btn btn-primary" @onclick="PublishAsync" disabled="@isBusy">Publish version</button><button type="button" class="btn btn-outline" @onclick="RejectAsync" disabled="@isBusy">Return for changes</button>}else if(isPtApprover&&selected.Status==NoteTemplateVersionStatus.Published){<label class="template-admin__comment"><span>Retirement reason</span><textarea class="form-control" @bind="reviewComment"></textarea></label><button type="button" class="btn btn-outline" @onclick="RetireAsync" disabled="@isBusy">Retire published version</button>}else if(!isPtApprover&&(selected.Status==NoteTemplateVersionStatus.Draft||selected.Status==NoteTemplateVersionStatus.Rejected)){<button type="button" class="btn btn-outline" @onclick="SaveAsync" disabled="@isBusy">Save draft</button><button type="button" class="btn btn-primary" @onclick="SubmitAsync" disabled="@isBusy">Submit for clinical approval</button>}else if(!isPtApprover){<button type="button" class="btn btn-outline" @onclick="CloneSelectedAsync" disabled="@isBusy">Clone as new draft</button>}</div>
    </section>}
</section>

@code{
    private List<NoteTemplateSummaryDto> summaries=[];private List<NoteTemplateVersionDto> versionHistory=[];private NoteTemplateVersionDto? selected;private NoteTemplateVersionDto? publishedComparison;private NoteTemplateSummaryDto? selectedSummary;private NoteTemplateValidationResult? validationSummary;private NoteType selectedNoteType;private NoteTemplateVariant selectedVariant;private bool isPtApprover;private bool isLoading=true;private bool isBusy;private string? error;private string newName="Standard template";private NoteType newType=NoteType.Evaluation;private NoteTemplateVariant newVariant=NoteTemplateVariant.Standard;private string? reviewComment;
    protected override async Task OnInitializedAsync(){var state=await AuthenticationStateProvider.GetAuthenticationStateAsync();isPtApprover=state.User.IsInRole(Roles.PT)&&!state.User.IsInRole(Roles.Admin)&&!state.User.IsInRole(Roles.Owner);await LoadAsync();}
    private async Task LoadAsync(){isLoading=true;error=null;try{summaries=[..(isPtApprover?await Templates.ListForClinicalReviewAsync(null,null,default):await Templates.ListAsync(null,null,default))];}catch(Exception ex){error=ex.Message;}finally{isLoading=false;}}
    private async Task CreateAsync(){if(string.IsNullOrWhiteSpace(newName)){error="Template name is required.";return;}isBusy=true;try{selected=await Templates.CreateDraftAsync(new(){Name=newName,NoteType=newType,Variant=newVariant},default);selectedNoteType=newType;selectedVariant=newVariant;validationSummary=null;ToastService.ShowSuccess("Template draft created.");await LoadAsync();}catch(Exception ex){error=ex.Message;}finally{isBusy=false;}}
    private async Task OpenAsync(NoteTemplateSummaryDto item){if(!item.LatestVersionId.HasValue)return;isBusy=true;try{selectedSummary=item;selectedNoteType=item.NoteType;selectedVariant=item.Variant;versionHistory=[..await Templates.ListVersionsAsync(item.Id,default)];selected=versionHistory.FirstOrDefault(version=>version.Id==item.LatestVersionId.Value);publishedComparison=item.ActiveVersionId.HasValue?versionHistory.FirstOrDefault(version=>version.Id==item.ActiveVersionId.Value):null;reviewComment=null;validationSummary=null;}catch(Exception ex){error=ex.Message;}finally{isBusy=false;}}
    private async Task OpenVersionAsync(Guid id){selected=await Templates.GetVersionAsync(id,default);}
    private async Task CloneSelectedAsync(){if(selected is null||selectedSummary is null)return;isBusy=true;try{selected=await Templates.CreateDraftAsync(new(){Name=selectedSummary.Name,NoteType=selectedSummary.NoteType,Variant=selectedSummary.Variant,CloneVersionId=selected.Id},default);ToastService.ShowSuccess("New draft cloned from the selected version.");await LoadAsync();}catch(Exception ex){error=ex.Message;}finally{isBusy=false;}}
    private void AddField(NoteTemplateSectionDefinition section){var next=section.Fields.Count==0?10:section.Fields.Max(f=>f.Order)+10;section.Fields.Add(new(){Key=$"field-{Guid.NewGuid():N}",Label="New field",BindingKey="subjective.chiefComplaint",RendererKey="textarea",Order=next});}
    private static void AddChoice(NoteTemplateFieldDefinition field){var next=field.Choices.Count==0?10:field.Choices.Max(choice=>choice.Order)+10;field.Choices.Add(new(){Label="New choice",Value=$"choice-{Guid.NewGuid():N}",Order=next});}
    private static void AddCondition(NoteTemplateFieldDefinition field)=>field.VisibilityConditions.Add(new(){SourceBindingKey="subjective.chiefComplaint",Operator=NoteTemplateConditionOperator.IsNotEmpty});
    private async Task ValidateSelectedAsync(){if(selected is null)return;isBusy=true;error=null;try{validationSummary=await Templates.ValidateAsync(selectedNoteType,selectedVariant,selected.Schema,default);}catch(Exception ex){error=ex.Message;}finally{isBusy=false;}}
    private async Task SaveAsync(){if(selected is null)return;await ValidateSelectedAsync();if(validationSummary?.IsValid!=true)return;isBusy=true;error=null;try{selected=await Templates.UpdateDraftAsync(selected.Id,new(){Schema=selected.Schema,ExpectedLastModifiedUtc=selected.LastModifiedUtc},default);ToastService.ShowSuccess("Template draft saved.");}catch(Exception ex){error=ex.Message;}finally{isBusy=false;}}
    private async Task SubmitAsync(){if(selected is null)return;await SaveAsync();if(validationSummary?.IsValid!=true||!string.IsNullOrWhiteSpace(error))return;isBusy=true;try{selected=await Templates.SubmitAsync(selected.Id,default);ToastService.ShowSuccess("Template submitted for clinical approval.");await LoadAsync();}catch(Exception ex){error=ex.Message;}finally{isBusy=false;}}
    private async Task PublishAsync(){if(selected is null)return;isBusy=true;try{selected=await Templates.PublishAsync(selected.Id,new(){Comment=reviewComment},default);ToastService.ShowSuccess("Template version published.");await LoadAsync();}catch(Exception ex){error=ex.Message;}finally{isBusy=false;}}
    private async Task RejectAsync(){if(selected is null)return;isBusy=true;try{selected=await Templates.RejectAsync(selected.Id,new(){Comment=reviewComment},default);ToastService.ShowSuccess("Template returned for changes.");await LoadAsync();}catch(Exception ex){error=ex.Message;}finally{isBusy=false;}}
    private async Task RetireAsync(){if(selected is null)return;isBusy=true;try{selected=await Templates.RetireAsync(selected.Id,new(){Comment=reviewComment},default);ToastService.ShowSuccess("Template version retired. New notes will use the packaged compatibility template until another version is published.");await LoadAsync();}catch(Exception ex){error=ex.Message;}finally{isBusy=false;}}
    private static string DescribeComparison(NoteTemplateSchemaDefinition candidate,NoteTemplateSchemaDefinition published){var currentSections=candidate.Sections.ToDictionary(section=>section.Key,StringComparer.OrdinalIgnoreCase);var priorSections=published.Sections.ToDictionary(section=>section.Key,StringComparer.OrdinalIgnoreCase);var added=currentSections.Keys.Except(priorSections.Keys,StringComparer.OrdinalIgnoreCase).Count();var removed=priorSections.Keys.Except(currentSections.Keys,StringComparer.OrdinalIgnoreCase).Count();var sectionChanges=currentSections.Keys.Intersect(priorSections.Keys,StringComparer.OrdinalIgnoreCase).Count(key=>{var current=currentSections[key];var prior=priorSections[key];return current.Label!=prior.Label||current.Order!=prior.Order||current.IsVisible!=prior.IsVisible;});var currentFields=candidate.Sections.SelectMany(section=>section.Fields.Select(field=>(Key:$"{section.Key}.{field.Key}",Field:field))).ToDictionary(item=>item.Key,item=>item.Field,StringComparer.OrdinalIgnoreCase);var priorFields=published.Sections.SelectMany(section=>section.Fields.Select(field=>(Key:$"{section.Key}.{field.Key}",Field:field))).ToDictionary(item=>item.Key,item=>item.Field,StringComparer.OrdinalIgnoreCase);var fieldChanges=currentFields.Keys.Union(priorFields.Keys,StringComparer.OrdinalIgnoreCase).Count(key=>!currentFields.TryGetValue(key,out var current)||!priorFields.TryGetValue(key,out var prior)||current.Label!=prior.Label||current.BindingKey!=prior.BindingKey||current.RendererKey!=prior.RendererKey||current.Order!=prior.Order||current.IsVisible!=prior.IsVisible||current.IsRequired!=prior.IsRequired);return $"{added} section(s) added, {removed} removed, {sectionChanges} section setting(s) changed, and {fieldChanges} field definition(s) changed.";}
    private void CloseEditor(){selected=null;selectedSummary=null;versionHistory=[];publishedComparison=null;validationSummary=null;}private static string Label(NoteType type,NoteTemplateVariant variant)=>variant==NoteTemplateVariant.Standard?type.ToString():$"{type} · {variant}";
}
