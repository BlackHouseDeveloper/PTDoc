@namespace PTDoc.UI.Components.Notes.Workspace
@using Microsoft.JSInterop
@using PTDoc.Application.Services
@using PTDoc.Core.Models
@implements IAsyncDisposable
@inject INoteHandoffService Handoffs
@inject IJSRuntime JS

<button type="button" class="btn btn--secondary" disabled="@_busy" @onclick="OpenAsync">@(_pending is null ? "Send to clinician" : "Resume send to clinician")</button>
@if (!string.IsNullOrEmpty(_message) && !_open)
{
    <p role="status">@_message</p>
}
@if (_open)
{
    <div class="modal-overlay handoff-overlay">
        <section id="@_modalId" class="handoff-dialog" role="dialog" aria-modal="true" aria-labelledby="@(_modalId + "-title")" tabindex="-1">
            <h2 id="@(_modalId + "-title")">Send to clinician</h2>
            <p>Send this note for collaboration or reassign responsibility. Existing edit permissions stay in place. The PT signs shared treatment; signed notes remain read-only.</p>
            @if (_context is not null)
            {
                <p><strong>Responsible clinician:</strong> @(_context.ResponsibleClinician?.Name ?? "Unassigned")</p>
                <label for="@(_modalId + "-kind")">Purpose</label>
                <select id="@(_modalId + "-kind")" @bind="_kind" disabled="@(_busy || _pending is not null || _reloadRequired)">
                    <option value="@NoteHandoffKind.Collaboration">Collaboration — keep responsibility</option>
                    <option value="@NoteHandoffKind.Reassignment">Reassignment — change responsibility</option>
                </select>
                <label for="@(_modalId + "-recipient")">Recipient</label>
                <select id="@(_modalId + "-recipient")" @bind="_recipient" disabled="@(_busy || _pending is not null || _reloadRequired)">
                    <option value="@Guid.Empty">Select clinician</option>
                    @foreach (var recipient in _context.Recipients)
                    {
                        <option value="@recipient.Id">@recipient.Name (@recipient.Role)</option>
                    }
                </select>
                @if (_context.Recipients.Count == 0)
                {
                    <p>No eligible clinician in the opposite role is available in this clinic.</p>
                }
                @if (_recipient != Guid.Empty)
                {
                    <p class="handoff-review">@(_kind == NoteHandoffKind.Collaboration ? "Collaborate with" : "Reassign responsibility to") <strong>@_context.Recipients.FirstOrDefault(r => r.Id == _recipient)?.Name</strong>. They will receive one in-app notification linked to this note.</p>
                }
            }
            @if (!string.IsNullOrEmpty(_message))
            {
                <p role="alert">@_message</p>
            }
            <div class="handoff-actions">
                <button type="button" class="btn btn--secondary" disabled="@_busy" @onclick="CloseAsync">Close</button>
                @if (_reloadRequired || _context is null)
                {
                    <button type="button" class="btn btn--secondary" disabled="@_busy" @onclick="ReloadAsync">Reload handoff</button>
                }
                else
                {
                    <button type="button" class="btn btn--primary" disabled="@(_busy || _recipient == Guid.Empty)" @onclick="SendAsync">@(_busy ? "Sending…" : _pending is null ? "Confirm send" : "Retry same send")</button>
                }
            </div>
        </section>
    </div>
}

@code {
    [Parameter, EditorRequired] public Guid NoteId { get; set; }
    [Parameter] public Func<Task<bool>>? BeforeOpen { get; set; }
    private readonly string _modalId = $"note-handoff-{Guid.NewGuid():N}";
    private NoteHandoffContext? _context;
    private SendNoteHandoffRequest? _pending;
    private Guid _recipient;
    private NoteHandoffKind _kind;
    private bool _open, _busy, _registered, _reloadRequired, _disposed;
    private string? _message;
    private IJSObjectReference? _module;
    private DotNetObjectReference<NoteHandoffDialog>? _reference;

    private async Task OpenAsync()
    {
        if (_busy) return;
        if (_pending is not null) { _open = true; return; }
        _busy = true;
        try
        {
            if (BeforeOpen is not null && !await BeforeOpen())
            { _message = "Save the note successfully before sending it."; return; }
            _open = true;
            await LoadAsync();
        }
        catch (Exception) { _message = "Unable to prepare the handoff. Try again after the note is saved."; }
        finally { _busy = false; }
    }
    private async Task ReloadAsync()
    {
        if (_busy) return;
        _busy = true;
        try { await LoadAsync(); }
        catch (Exception) { _message = "Unable to load the handoff. Try again."; }
        finally { _busy = false; }
    }
    private async Task LoadAsync()
    {
        var result = await Handoffs.GetAsync(NoteId);
        if (_disposed) return;
        _context = result.Value;
        _pending = null;
        _recipient = Guid.Empty;
        _reloadRequired = false;
        _message = result.Status == NoteHandoffStatus.Succeeded ? null : Error(result.Status);
    }
    private async Task SendAsync()
    {
        if (_busy || _context is null || _recipient == Guid.Empty || _reloadRequired) return;
        _pending ??= new(Guid.NewGuid(), _recipient, _kind, _context.NoteVersionUtc, _context.Sequence);
        _busy = true;
        try
        {
            var result = await Handoffs.SendAsync(NoteId, _pending);
            if (_disposed) return;
            if (result.Status == NoteHandoffStatus.Succeeded)
            {
                _pending = null;
                _message = "Note sent. The recipient has one in-app notification.";
                await UnregisterAsync();
                _open = false;
            }
            else
            {
                _message = Error(result.Status);
                _reloadRequired = true;
                _pending = null; // Server definitively declined this command; reload before a new command.
            }
        }
        catch (Exception)
        {
            _message = "Send result unknown. Retry the same send to check its result without duplicating it. Keep this page open.";
        }
        finally { _busy = false; }
    }
    private static string Error(NoteHandoffStatus status) => status switch
    {
        NoteHandoffStatus.Conflict => "The note or handoff changed. Reload the handoff and review the recipient before sending again.",
        NoteHandoffStatus.Forbidden => "You or the recipient no longer have permission to send this note.",
        NoteHandoffStatus.NotFound => "This note is no longer available in your clinic.",
        _ => "Unable to send this handoff. Reload and review your selection."
    };
    [JSInvokable]
    public async Task CloseFromJs()
    {
        await CloseAsync();
        if (!_disposed) await InvokeAsync(StateHasChanged);
    }
    private async Task CloseAsync()
    {
        if (_busy) return;
        await UnregisterAsync(); // Restore background focus/inert state before removing the dialog.
        _open = false;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_open || _registered) return;
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/PTDoc.UI/js/modal.js");
            _reference ??= DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("registerEscapeHandler", _modalId, _reference);
            _registered = true;
        }
        catch (JSException) { }
        catch (InvalidOperationException) { }
    }
    private async Task UnregisterAsync()
    {
        if (!_registered || _module is null) return;
        try { await _module.InvokeVoidAsync("unregisterEscapeHandler", _modalId); }
        catch (JSException) { }
        _registered = false;
    }
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        await UnregisterAsync();
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); } catch (JSException) { }
        }
        _reference?.Dispose();
    }
}
