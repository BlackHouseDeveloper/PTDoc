    private async Task<EditableNarrativeAcceptResult> HandleClinicalSummaryAcceptedAsync(string acceptedText)
    {
        if (!CanAcceptNarrative(NoteNarrativePurpose.SoapSummary)) return EditableNarrativeAcceptResult.Fail("The note changed. Generate a new suggestion.");
        var context = _narrativeContextKey;
        try
        {
            if (NoteId != Guid.Empty)
            {
                var acceptance = await NoteWorkspaceService.AcceptAiSuggestionAsync(
                    NoteId,
                    section: "plan",
                    generatedText: acceptedText,
                    generationType: "ClinicalSummary");

                if (!acceptance.Success)
                {
                    _errorMessage = acceptance.ErrorMessage ?? "Unable to accept AI-generated summary content.";
                    ToastService.ShowError(_errorMessage, "AI acceptance failed");
                    await InvokeAsync(StateHasChanged);
                    return EditableNarrativeAcceptResult.Fail(_errorMessage);
                }
            }

            if (context != _narrativeContextKey || !CanAcceptNarrative(NoteNarrativePurpose.SoapSummary))
                return EditableNarrativeAcceptResult.Fail("The note changed. Generate a new suggestion.");
            await SetAndNotify(vm =>
        {
            vm.ClinicalSummary = acceptedText;
            vm.AcceptedNarrativeProvenance[nameof(PlanVm.ClinicalSummary)] = _pendingNarratives[NoteNarrativePurpose.SoapSummary].ToProvenance();
        });
            _errorMessage = null;
            ToastService.ShowSuccess("AI clinical summary accepted. Save the note to keep it.", "AI content accepted");
            await InvokeAsync(StateHasChanged);
            return EditableNarrativeAcceptResult.Ok();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Clinical summary acceptance failed for note {NoteId}", NoteId);
            _errorMessage = "Unable to accept AI-generated summary content.";
            ToastService.ShowError(_errorMessage, "AI acceptance failed");
            await InvokeAsync(StateHasChanged);
            return EditableNarrativeAcceptResult.Fail(_errorMessage);
        }
    }

    private Task HandleClinicalSummaryDiscardedAsync()
    {
        _errorMessage = null;
        return Task.CompletedTask;
    }

    private async Task<bool> ShowPlanSuggestionAsync(
        EditableNarrativeBox? narrativeBox,
        string suggestion,
        string sectionName,
        string unavailableMessage)
    {
        if (TreatAiReviewBoxAsUnavailable || narrativeBox is null)
        {
            Logger.LogWarning(
                "Plan AI generation succeeded for {SectionName} on note {NoteId}, but the review box reference was unavailable.",
                sectionName,
                NoteId);
            _errorMessage = unavailableMessage;
            return false;
        }

        await narrativeBox.LoadAiSuggestionAsync(suggestion);
        return true;
    }

    private static bool HasConcreteBodyPart(string? bodyPart) =>
        !string.IsNullOrWhiteSpace(bodyPart)
        && !string.Equals(bodyPart.Trim(), "Other", StringComparison.OrdinalIgnoreCase);

    public void Dispose()
    {
        _narrativeEpoch++;
        _narrativeCts?.Cancel();
        _narrativeCts?.Dispose();
        _cptSearchCts?.Cancel();
        _cptSearchCts?.Dispose();
    }

    private static BodyPart ParseBodyPart(string? value) =>
        Enum.TryParse<BodyPart>(value, ignoreCase: true, out var parsed) ? parsed : BodyPart.Other;
}
