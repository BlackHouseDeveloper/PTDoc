    private static string FormatInterventionForHep(GeneralInterventionEntry entry)
    {
        var parts = new List<string> { entry.Name.Trim() };
        if (!string.IsNullOrWhiteSpace(entry.CptCode))
        {
            parts.Add($"CPT {entry.CptCode.Trim()}");
        }

        if (!string.IsNullOrWhiteSpace(entry.AssistanceLevel))
        {
            parts.Add(entry.AssistanceLevel.Trim());
        }

        if (!string.IsNullOrWhiteSpace(entry.Cueing))
        {
            parts.Add(entry.Cueing.Trim());
        }

        return string.Join(" - ", parts);
    }

    private Task HandleAiSuggestDischargeAsync() => GenerateNarrativeAsync(NoteNarrativePurpose.DischargeRecommendations, () => _dischargePlanningBox, "discharge planning");
    private Task HandleAiSuggestFollowUpAsync() => GenerateNarrativeAsync(NoteNarrativePurpose.NextVisitPlan, () => _followUpBox, "follow-up instructions");
    private Task HandleGenerateSummaryAsync() => GenerateNarrativeAsync(NoteNarrativePurpose.SoapSummary, () => _clinicalSummaryBox, "clinical summary");

    private async Task GenerateNarrativeAsync(NoteNarrativePurpose purpose, Func<EditableNarrativeBox?> box, string label)
    {
        if (IsPlanGenerationDisabled) return;
        var epoch = ++_narrativeEpoch;
        var source = new NoteNarrativeRequest(NoteId, SourceLastModifiedUtc!.Value, purpose);
        _narrativeCts?.Cancel(); _narrativeCts?.Dispose(); _narrativeCts = new();
        var token = _narrativeCts.Token;
        _isGeneratingDischarge = purpose == NoteNarrativePurpose.DischargeRecommendations;
        _isGeneratingFollowUp = purpose == NoteNarrativePurpose.NextVisitPlan;
        _isGeneratingSummary = purpose == NoteNarrativePurpose.SoapSummary;
        _errorMessage = null;
        try
        {
            var result = await NarrativeClient.GenerateAsync(source, token);
            if (token.IsCancellationRequested || epoch != _narrativeEpoch || IsNoteSigned || IsReadOnly || HasUnsavedChanges) return;
            if (!result.Success)
            {
                _errorMessage = result.ErrorMessage ?? "Unable to generate this section. You can edit manually.";
                ToastService.ShowError(_errorMessage, "AI generation failed"); return;
            }
            if (result.NoteId != NoteId || result.Purpose != purpose || result.SourceLastModifiedUtc != SourceLastModifiedUtc)
            { _errorMessage = "The suggestion belongs to a different note version. Save and generate again."; return; }
            var failure = $"Unable to open AI review for {(purpose == NoteNarrativePurpose.SoapSummary ? "the " : "")}{label}. Please try again.";
            if (!await ShowPlanSuggestionAsync(box(), result.GeneratedText, label, failure))
            { ToastService.ShowError(_errorMessage ?? failure, "AI generation failed"); return; }
            _pendingNarratives[purpose] = result;
            ToastService.ShowSuccess("Suggestion generated. Review and accept it before saving.", "AI generation complete");
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch
        {
            if (epoch == _narrativeEpoch)
            { _errorMessage = "Unable to generate this section. You can continue editing manually."; ToastService.ShowError(_errorMessage, "AI generation failed"); }
        }
        finally
        {
            if (epoch == _narrativeEpoch) _isGeneratingDischarge = _isGeneratingFollowUp = _isGeneratingSummary = false;
        }
    }

    private bool CanAcceptNarrative(NoteNarrativePurpose purpose) => !IsReadOnly && !IsNoteSigned && !HasUnsavedChanges
        && _pendingNarratives.TryGetValue(purpose, out var pending) && pending.NoteId == NoteId
        && pending.SourceLastModifiedUtc == SourceLastModifiedUtc;

    private async Task<EditableNarrativeAcceptResult> HandleDischargeAcceptedAsync(string acceptedText)
    {
        if (!CanAcceptNarrative(NoteNarrativePurpose.DischargeRecommendations)) return EditableNarrativeAcceptResult.Fail("The note changed. Generate a new suggestion.");
        await SetAndNotify(vm =>
        {
            vm.DischargePlanningNotes = acceptedText;
            vm.AcceptedNarrativeProvenance[nameof(PlanVm.DischargePlanningNotes)] = _pendingNarratives[NoteNarrativePurpose.DischargeRecommendations].ToProvenance();
        });
        _errorMessage = null;
        await InvokeAsync(StateHasChanged);
        return EditableNarrativeAcceptResult.Ok();
    }

