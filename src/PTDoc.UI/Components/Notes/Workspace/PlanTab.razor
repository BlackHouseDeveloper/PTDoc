@namespace PTDoc.UI.Components.Notes.Workspace
@using PTDoc.Application.AI
@using PTDoc.Application.Compliance
@using PTDoc.Application.Notes.Workspace
@using PTDoc.Core.Models
@using PTDoc.UI.Components.Notes.Models
@using UiCptCodeEntry = PTDoc.UI.Components.Notes.Models.CptCodeEntry
@implements IDisposable

@inject INoteNarrativeClient NarrativeClient
@inject PTDoc.UI.Services.INoteWorkspaceService NoteWorkspaceService
@inject ILogger<PlanTab> Logger
@inject IToastService ToastService

@* PlanTab: CPT codes, treatment plan, additional planning, clinical summary.
   Per Blueprint: CPT quick-pick grid, frequency/duration required fields, AI-assisted
   discharge planning, follow-up instructions, and final clinical summary.
*@

<div class="plan-tab" data-testid="plan-tab">
    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <p class="pt-card__poc-placeholder" role="alert">@_errorMessage</p>
    }

    @if (ShowInterventionAuthoring)
    {
    <!-- 1. CPT Codes -->
    <div class="pt-card" data-testid="cpt-codes-card">
        <div class="pt-card__header">
            <div>
                <h3 class="pt-card__title">CPT Procedure Codes</h3>
                <p class="pt-card__subtitle">Search the source-backed CPT catalog or use product-default quick picks</p>
            </div>
        </div>

        @if (!IsReadOnly)
        {
            <div class="pt-card__field">
                <label class="pt-card__field-label" for="cpt-search-input">Search CPT Codes</label>
                <input id="cpt-search-input"
                       type="search"
                       class="pt-card__search-input"
                       placeholder="Search by CPT code or description"
                       value="@_cptSearchQuery"
                       @oninput="HandleCptSearchChangedAsync"
                       data-testid="cpt-search-input" />
            </div>

            @if (_isSearchingCpt)
            {
                <p class="pt-card__search-status" role="status">Searching CPT codes…</p>
            }
            else if (!string.IsNullOrWhiteSpace(_cptLookupError))
            {
                <p class="pt-card__search-status pt-card__search-status--error" role="alert">@_cptLookupError</p>
            }
            else if (_cptResults.Count > 0)
            {
                <div class="pt-card__search-results" data-testid="cpt-search-results">
                    @foreach (var result in _cptResults)
                    {
                        var isSelected = Vm.SelectedCptCodes.Any(code => string.Equals(code.Code, result.Code, StringComparison.OrdinalIgnoreCase));
                        <button type="button"
                                class="pt-card__search-result @(isSelected ? "pt-card__search-result--selected" : "")"
                                disabled="@IsReadOnly"
                                @onclick="() => AddCptCodeAsync(result)"
                                data-testid="cpt-search-result">
                            <span class="pt-card__search-result-code">@result.Code</span>
                            <span class="pt-card__search-result-desc">@result.Description</span>
                            @if (result.SuggestedModifiers.Count > 0)
                            {
                                <span class="pt-card__search-result-hint">Suggested: @string.Join(", ", result.SuggestedModifiers)</span>
                            }
                        </button>
                    }
                </div>
            }
        }

        <!-- Product-default quick picks; lookup search remains the canonical CPT source. -->
        <p class="pt-card__field-label">Quick-pick CPT shortcuts</p>
        <div class="pt-card__cpt-grid">
            @foreach (var quickPick in _quickPickCptCodes)
            {
                var alreadySelected = Vm.SelectedCptCodes.Any(c => CodesMatch(c.Code, quickPick.Code));
                <button type="button"
                        class="pt-card__cpt-tile @(alreadySelected ? "pt-card__cpt-tile--active" : "")"
                        disabled="@IsReadOnly"
                        aria-pressed="@(alreadySelected ? "true" : "false")"
                        @onclick="() => ToggleCptQuickPickAsync(quickPick)"
                        data-testid="cpt-quick-pick">
                    <span class="pt-card__cpt-code">@quickPick.Code</span>
                    <span class="pt-card__cpt-name">@quickPick.ShortName</span>
                    <span class="pt-card__cpt-unit">@quickPick.DefaultUnits min</span>
                </button>
            }
        </div>

        <!-- Selected codes list -->
        @if (Vm.SelectedCptCodes.Count == 0)
        {
            <div class="pt-card__cpt-empty">
                <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
                    <rect x="4" y="4" width="20" height="24" rx="2" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M9 10h10M9 14h10M9 18h6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
                <p>No CPT codes selected — search the catalog or choose a quick pick above to add one.</p>
            </div>
        }
        else
        {
            <div class="pt-card__cpt-selected-header">
                <span class="pt-card__field-label">Selected Codes</span>
                <span class="pt-card__badge">@Vm.SelectedCptCodes.Count selected</span>
            </div>
            @if (GetBillingAdvisories().Count > 0)
            {
                <div class="pt-card__advisory-list" role="status" aria-live="polite">
                    @foreach (var advisory in GetBillingAdvisories())
                    {
                        <p class="pt-card__advisory-item">@advisory</p>
                    }
                </div>
            }
            <ul class="pt-card__cpt-list">
                @foreach (var entry in Vm.SelectedCptCodes)
                {
                    <li class="pt-card__cpt-row">
                        <div class="pt-card__cpt-main">
                            <div class="pt-card__cpt-row-header">
                                <div class="pt-card__cpt-summary">
                                    <span class="pt-card__cpt-code">@entry.Code</span>
                                    <span class="pt-card__cpt-desc">@entry.Description</span>
                                </div>
                                @if (!IsReadOnly)
                                {
                                    <button type="button" class="pt-card__remove-btn"
                                            aria-label="Remove @entry.Code"
                                            @onclick="() => RemoveCptCode(entry)">✕</button>
                                }
                            </div>

                            <div class="pt-card__cpt-detail-grid">
                                <div class="pt-card__cpt-units-row">
                                    <button type="button" class="pt-card__stepper"
                                            aria-label="Decrease units for @entry.Code"
                                            disabled="@(IsReadOnly || entry.Units <= 1)"
                                            @onclick="() => ChangeUnits(entry, -1)">−</button>
                                    <span class="pt-card__unit-value">@entry.Units</span>
                                    <button type="button" class="pt-card__stepper"
                                            aria-label="Increase units for @entry.Code"
                                            disabled="@IsReadOnly"
                                            @onclick="() => ChangeUnits(entry, 1)">+</button>
                                    <span class="pt-card__unit-label">units</span>
                                </div>

                                @if (IsTimedCode(entry.Code))
                                {
                                    <label class="pt-card__minutes-field">
                                        <span class="pt-card__unit-label">Minutes</span>
                                        <input type="number"
                                               min="0"
                                               step="1"
                                               class="pt-card__minutes-input"
                                               value="@(entry.Minutes?.ToString() ?? string.Empty)"
                                               disabled="@IsReadOnly"
                                               @onchange="e => UpdateMinutes(entry, e.Value)"
                                               data-testid="cpt-minutes-input" />
                                    </label>
                                }
                            </div>

                            @if (entry.ModifierOptions.Count > 0)
                            {
                                <div class="pt-card__modifier-section">
                                    <p class="pt-card__modifier-label">Modifiers</p>
                                    <div class="pt-card__modifier-chip-row">
                                        @foreach (var modifier in entry.ModifierOptions)
                                        {
                                            var isSelected = entry.Modifiers.Contains(modifier, StringComparer.OrdinalIgnoreCase);
                                            var isSuggested = entry.SuggestedModifiers.Contains(modifier, StringComparer.OrdinalIgnoreCase);
                                            <button type="button"
                                                    class="pt-card__modifier-chip @(isSelected ? "pt-card__modifier-chip--active" : "") @(isSuggested ? "pt-card__modifier-chip--suggested" : "")"
                                                    disabled="@IsReadOnly"
                                                    @onclick="() => ToggleModifier(entry, modifier)"
                                                    data-testid="modifier-chip">
                                                @modifier
                                            </button>
                                        }
                                    </div>
                                    @if (entry.SuggestedModifiers.Count > 0)
                                    {
                                        <p class="pt-card__modifier-hint">
                                            Suggested: @string.Join(", ", entry.SuggestedModifiers)
                                            @if (!string.IsNullOrWhiteSpace(entry.ModifierSource))
                                            {
                                                <span> · Source: @entry.ModifierSource</span>
                                            }
                                        </p>
                                    }
                                </div>
                            }
                        </div>
                    </li>
                }
            </ul>
        }
    </div>
    }

    <!-- 2. Treatment Plan -->
    <div class="pt-card" data-testid="treatment-plan-card">
        <div class="pt-card__header">
            <div class="pt-card__title-row">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <rect x="2" y="2" width="12" height="12" rx="1.5" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M5 8h6M8 5v6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
                <h3 class="pt-card__title">Treatment Plan</h3>
            </div>
        </div>

        <div class="pt-card__row-2col">
            <div class="pt-card__field">
                <label class="pt-card__field-label" for="treatment-frequency">
                    Treatment Frequency *
                </label>
                <select id="treatment-frequency" class="pt-card__select"
                        disabled="@IsReadOnly"
                        value="@Vm.TreatmentFrequency"
                        @onchange="e => SetAndNotify(vm => vm.TreatmentFrequency = e.Value?.ToString())"
                        aria-required="true"
                        data-note-field-key="plan-treatment-frequency">
                    <option value="">Select frequency ↓</option>
                    @foreach (var f in _frequencyOptions)
                    {
                        <option value="@f" selected="@(Vm.TreatmentFrequency == f)">@f</option>
                    }
                </select>
            </div>

            <div class="pt-card__field">
                <label class="pt-card__field-label" for="treatment-duration">
                    Treatment Duration *
                </label>
                <select id="treatment-duration" class="pt-card__select"
                        disabled="@IsReadOnly"
                        value="@Vm.TreatmentDuration"
                        @onchange="e => SetAndNotify(vm => vm.TreatmentDuration = e.Value?.ToString())"
                        aria-required="true"
                        data-note-field-key="plan-treatment-duration">
                    <option value="">Select duration ↓</option>
                    @foreach (var d in _durationOptions)
                    {
                        <option value="@d" selected="@(Vm.TreatmentDuration == d)">@d</option>
                    }
                </select>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Vm.TreatmentFrequency) && !string.IsNullOrWhiteSpace(Vm.TreatmentDuration))
        {
            <div class="pt-card__poc-hint" role="status" aria-live="polite">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <circle cx="7" cy="7" r="5.5" stroke="currentColor" stroke-width="1.3"/>
                    <path d="M7 4.5v3.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                    <circle cx="7" cy="10" r="0.65" fill="currentColor"/>
                </svg>
                Plan of Care: <strong>@Vm.TreatmentFrequency</strong> for <strong>@Vm.TreatmentDuration</strong>
            </div>
        }
        else
        {
            <p class="pt-card__poc-placeholder">
                Select treatment frequency and duration to calculate Plan of Care dates.
            </p>
        }
    </div>

    <!-- 3. Additional Planning -->
    <div class="pt-card" data-testid="additional-planning-card">
        <div class="pt-card__header">
            <h3 class="pt-card__title">Additional Planning</h3>
        </div>

        @if (ShowInterventionAuthoring)
        {
        <div class="pt-card__field">
            <label class="pt-card__field-label">Treatment Focuses</label>
            @if (!string.IsNullOrWhiteSpace(_catalogError))
            {
                <p class="pt-card__search-status pt-card__search-status--error" role="alert">@_catalogError</p>
            }
            else if (_isLoadingCatalog)
            {
                <p class="pt-card__search-status" role="status">Loading treatment-focus catalog…</p>
            }
            else if (TreatmentFocusOptions.Count == 0)
            {
                <p class="pt-card__poc-placeholder">Select a structured body part in Subjective or Objective to load source-backed treatment focuses.</p>
            }
            else
            {
                <div class="pt-card__modifier-chip-row" data-testid="plan-treatment-focuses">
                    @foreach (var focus in TreatmentFocusOptions)
                    {
                        var isSelected = Vm.TreatmentFocuses.Contains(focus);
                        <button type="button"
                                class="pt-card__modifier-chip @(isSelected ? "pt-card__modifier-chip--active" : "")"
                                disabled="@IsReadOnly"
                                @onclick="() => ToggleTreatmentFocus(focus)">
                            @focus
                        </button>
                    }
                </div>
            }
        </div>

        <div class="pt-card__field">
            <div class="pt-card__field-header">
                <p class="pt-card__field-label">General Interventions</p>
                @if (!IsReadOnly)
                {
                    <button type="button" class="pt-card__secondary-btn" @onclick="AddManualIntervention">+ Add Manual Intervention</button>
                }
            </div>

            @if (InterventionOptions.Count > 0)
            {
                <div class="pt-card__modifier-chip-row" data-testid="plan-general-intervention-options">
                    @foreach (var intervention in InterventionOptions)
                    {
                        var isSelected = Vm.GeneralInterventions.Any(entry => string.Equals(entry.Name, intervention, StringComparison.OrdinalIgnoreCase));
                        <button type="button"
                                class="pt-card__modifier-chip @(isSelected ? "pt-card__modifier-chip--active" : "")"
                                disabled="@IsReadOnly"
                                @onclick="() => ToggleGeneralIntervention(intervention)">
                            @intervention
                        </button>
                    }
                </div>
            }

            @if (Vm.GeneralInterventions.Count == 0)
            {
                <p class="pt-card__poc-placeholder">No structured interventions documented yet.</p>
            }
            else
            {
                <div class="pt-card__editor-list" data-testid="plan-general-interventions">
                    @foreach (var intervention in Vm.GeneralInterventions)
                    {
                        <div class="pt-card__editor-row">
                            <div class="pt-card__editor-row-header">
                                <strong>@intervention.Name</strong>
                                @if (!IsReadOnly)
                                {
                                    <button type="button" class="pt-card__remove-btn" @onclick="() => RemoveGeneralIntervention(intervention)">✕</button>
                                }
                            </div>
                            <div class="pt-card__row-2col">
                                <label class="pt-card__field">
                                    <span class="pt-card__field-label">Category</span>
                                    <input class="pt-card__search-input"
                                           value="@intervention.Category"
                                           disabled="@IsReadOnly"
                                           @onchange="e => UpdateGeneralIntervention(intervention, entry => entry.Category = e.Value?.ToString())" />
                                </label>
                                <label class="pt-card__field">
                                    <span class="pt-card__field-label">Notes</span>
                                    <input class="pt-card__search-input"
                                           value="@intervention.Notes"
                                           disabled="@IsReadOnly"
                                           @oninput="e => UpdateGeneralIntervention(intervention, entry => entry.Notes = e.Value?.ToString())" />
                                </label>
                                <label class="pt-card__field">
                                    <span class="pt-card__field-label">CPT for this intervention</span>
                                    <select class="pt-card__select"
                                            value="@NormalizeCode(intervention.CptCode)"
                                            disabled="@IsReadOnly"
                                            @onchange="e => UpdateInterventionCpt(intervention, e.Value?.ToString())"
                                            data-testid="plan-intervention-cpt">
                                        <option value="">Select CPT ↓</option>
                                        @foreach (var option in _quickPickCptCodes)
                                        {
                                            <option value="@option.Code" selected="@CodesMatch(intervention.CptCode, option.Code)">
                                                @option.Code - @option.ShortName
                                            </option>
                                        }
                                    </select>
                                </label>
                                <label class="pt-card__field">
                                    <span class="pt-card__field-label">Minutes</span>
                                    <input class="pt-card__search-input"
                                           type="number"
                                           min="0"
                                           step="1"
                                           value="@(intervention.TimeMinutes?.ToString() ?? string.Empty)"
                                           disabled="@IsReadOnly"
                                           @onchange="e => UpdateInterventionMinutes(intervention, e.Value)"
                                           data-testid="plan-intervention-minutes" />
                                </label>
                                <label class="pt-card__field">
                                    <span class="pt-card__field-label">Assistance</span>
                                    <select class="pt-card__select"
                                            value="@intervention.AssistanceLevel"
                                            disabled="@IsReadOnly"
                                            @onchange="e => UpdateGeneralIntervention(intervention, entry => entry.AssistanceLevel = e.Value?.ToString())"
                                            data-testid="plan-intervention-assistance">
                                        <option value="">None documented</option>
                                        @foreach (var option in AssistanceLevelOptions)
                                        {
                                            <option value="@option" selected="@string.Equals(intervention.AssistanceLevel, option, StringComparison.OrdinalIgnoreCase)">@option</option>
                                        }
                                    </select>
                                </label>
                                <label class="pt-card__field">
                                    <span class="pt-card__field-label">Cueing</span>
                                    <select class="pt-card__select"
                                            value="@intervention.Cueing"
                                            disabled="@IsReadOnly"
                                            @onchange="e => UpdateGeneralIntervention(intervention, entry => entry.Cueing = e.Value?.ToString())"
                                            data-testid="plan-intervention-cueing">
                                        <option value="">None documented</option>
                                        @foreach (var option in CueingOptions)
                                        {
                                            <option value="@option" selected="@string.Equals(intervention.Cueing, option, StringComparison.OrdinalIgnoreCase)">@option</option>
                                        }
                                    </select>
                                </label>
                                <label class="pt-card__field">
                                    <span class="pt-card__field-label">Response</span>
                                    <input class="pt-card__search-input"
                                           value="@intervention.Response"
                                           disabled="@IsReadOnly"
                                           @oninput="e => UpdateGeneralIntervention(intervention, entry => entry.Response = e.Value?.ToString())"
                                           data-testid="plan-intervention-response" />
                                </label>
                            </div>
                            <label class="pt-card__checkbox-row">
                                <input type="checkbox"
                                       checked="@intervention.IncludeInHomeExerciseProgram"
                                       disabled="@IsReadOnly"
                                       @onchange="e => UpdateGeneralIntervention(intervention, entry => entry.IncludeInHomeExerciseProgram = (bool)e.Value!)"
                                       data-testid="plan-intervention-hep-link" />
                                Link this intervention to HEP
                            </label>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Home Exercise Program -->
        <div class="pt-card__field">
            <label class="pt-card__field-label" for="hep-notes">Home Exercise Program (HEP)</label>
            @if (LinkedHepInterventions.Count > 0)
            {
                <div class="pt-card__advisory-list" role="status" aria-live="polite" data-testid="plan-hep-linked-interventions">
                    <p class="pt-card__advisory-item">Linked HEP activities: @string.Join("; ", LinkedHepInterventions)</p>
                </div>
            }
            <textarea id="hep-notes" class="pt-card__textarea" rows="3"
                      placeholder="Describe home exercises, frequency, precautions, and patient education..."
                      disabled="@IsReadOnly"
                      value="@Vm.HomeExerciseProgramNotes"
                      @oninput="e => SetAndNotify(vm => vm.HomeExerciseProgramNotes = e.Value?.ToString())"></textarea>
        </div>
        }

        <!-- Discharge Planning -->
        <div class="pt-card__field">
            <div class="pt-card__field-header">
                <p class="pt-card__field-label">Discharge Planning</p>
                @if (!IsReadOnly)
                {
                    <AiGenerateButton ButtonLabel="AI Suggest"
                                      IsGenerating="@_isGeneratingDischarge"
                                      IsDisabled="@IsPlanGenerationDisabled"
                                      DisabledReason="@PlanGenerationDisabledReason"
                                      OnGenerate="HandleAiSuggestDischargeAsync"
                                      TestId="ai-suggest-discharge-btn" />
                }
            </div>
            <EditableNarrativeBox ReviewContextKey="@_narrativeContextKey" @ref="_dischargePlanningBox"
                                  Label=""
                                  Placeholder="Long-term maintenance plan, self-management strategies, return-to-care criteria..."
                                  Value="@(Vm.DischargePlanningNotes ?? string.Empty)"
                                  ValueChanged="@(v => SetAndNotify(vm => vm.DischargePlanningNotes = v))"
                                  OnAccepted="HandleDischargeAcceptedAsync"
                                  OnDiscarded="HandleDischargeDiscardedAsync"
                                  IsReadOnly="@IsReadOnly"
                                  Rows="3"
                                  TestId="discharge-planning-box" />
        </div>

        <!-- Follow-up Instructions -->
        <div class="pt-card__field">
            <div class="pt-card__field-header">
                <p class="pt-card__field-label">Next Visit / Follow-up Plan</p>
                @if (!IsReadOnly)
                {
                    <AiGenerateButton ButtonLabel="AI Suggest"
                                      IsGenerating="@_isGeneratingFollowUp"
                                      IsDisabled="@IsPlanGenerationDisabled"
                                      DisabledReason="@PlanGenerationDisabledReason"
                                      OnGenerate="HandleAiSuggestFollowUpAsync"
                                      TestId="ai-suggest-followup-btn" />
                }
            </div>
            <EditableNarrativeBox ReviewContextKey="@_narrativeContextKey" @ref="_followUpBox"
                                  Label=""
                                  Placeholder="Next appointment recommendations, referrals, precautions after discharge..."
                                  Value="@(Vm.FollowUpInstructions ?? string.Empty)"
                                  ValueChanged="@(v => SetAndNotify(vm => vm.FollowUpInstructions = v))"
                                  OnAccepted="HandleFollowUpAcceptedAsync"
                                  OnDiscarded="HandleFollowUpDiscardedAsync"
                                  IsReadOnly="@IsReadOnly"
                                  Rows="3"
                                  TestId="followup-instructions-box" />
        </div>
    </div>

    <!-- 4. Clinical Summary (SOAP) -->
    <div class="pt-card" data-testid="clinical-summary-card">
        <div class="pt-card__header">
            <div>
                <h3 class="pt-card__title">Clinical Summary (SOAP)</h3>
                <p class="pt-card__subtitle">Separate Subjective, Objective, Assessment and Plan paragraphs from the saved note</p>
            </div>
            @if (!IsReadOnly)
            {
                <AiGenerateButton ButtonLabel="Generate Summary"
                                  IsGenerating="@_isGeneratingSummary"
                                  IsDisabled="@IsPlanGenerationDisabled"
                                  DisabledReason="@PlanGenerationDisabledReason"
                                  OnGenerate="HandleGenerateSummaryAsync"
                                  TestId="generate-summary-btn" />
            }
        </div>

        <EditableNarrativeBox ReviewContextKey="@_narrativeContextKey" @ref="_clinicalSummaryBox"
                              Label=""
                              Placeholder="Click 'Generate Summary' to create a comprehensive SOAP note summary, or type manually..."
                              Value="@(Vm.ClinicalSummary ?? string.Empty)"
                              ValueChanged="@(v => SetAndNotify(vm => vm.ClinicalSummary = v))"
                              OnAccepted="HandleClinicalSummaryAcceptedAsync"
                              OnDiscarded="HandleClinicalSummaryDiscardedAsync"
                              IsReadOnly="@IsReadOnly"
                              Rows="6"
                              TestId="clinical-summary-box" />
    </div>

</div>

@code {
    [Parameter, EditorRequired] public PlanVm Vm { get; set; } = new();
    [Parameter, EditorRequired] public EventCallback<PlanVm> VmChanged { get; set; }
    [Parameter] public bool IsReadOnly { get; set; }
    [Parameter] public bool IsNoteSigned { get; set; }
    [Parameter] public Guid NoteId { get; set; }
    [Parameter] public DateTime? SourceLastModifiedUtc { get; set; }
    [Parameter] public bool HasUnsavedChanges { get; set; }

    [Parameter] public string? SelectedBodyPart { get; set; }
    [Parameter] public string? DiagnosisSummary { get; set; }
    [Parameter] public string? AssessmentSummary { get; set; }
    [Parameter] public string? GoalsSummary { get; set; }
    [Parameter] public string? PrecautionsSummary { get; set; }
    [Parameter] public IReadOnlyList<AiStructuredInput> StructuredInputs { get; set; } = Array.Empty<AiStructuredInput>();
    [Parameter] public bool ShowInterventionAuthoring { get; set; } = true;

    internal bool TreatAiReviewBoxAsUnavailable { get; set; }

    private bool _isLoadingCatalog;
    private bool _isGeneratingDischarge;
    private bool _isGeneratingFollowUp;
    private bool _isGeneratingSummary;
    private bool _isSearchingCpt;
    private string? _errorMessage;
    private string? _catalogError;
    private string? _cptLookupError;
    private string _cptSearchQuery = string.Empty;
    private List<CodeLookupEntry> _cptResults = [];
    private BodyRegionCatalog? _catalog;
    private string? _loadedCatalogBodyPart;
    private CancellationTokenSource? _cptSearchCts;
    private EditableNarrativeBox? _dischargePlanningBox;
    private EditableNarrativeBox? _followUpBox;
    private EditableNarrativeBox? _clinicalSummaryBox;

    private string? _narrativeContextKey;
    private long _narrativeEpoch;
    private CancellationTokenSource? _narrativeCts;
    private readonly Dictionary<NoteNarrativePurpose, NoteNarrativeResult> _pendingNarratives = new();

    private bool IsPlanGenerationDisabled => HasUnsavedChanges || !SourceLastModifiedUtc.HasValue || _isGeneratingDischarge || _isGeneratingFollowUp || _isGeneratingSummary || IsNoteSigned || IsReadOnly || NoteId == Guid.Empty || !HasConcreteBodyPart(SelectedBodyPart);

    private string? PlanGenerationDisabledReason =>
        IsNoteSigned
            ? "AI generation is not available on signed notes."
            : IsReadOnly
                ? "AI generation is only available for editable draft notes."
            : NoteId == Guid.Empty
                ? "Save the note before generating AI plan content."
