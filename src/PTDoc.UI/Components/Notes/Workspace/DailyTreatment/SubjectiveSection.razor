@namespace PTDoc.UI.Components.Notes.Workspace.DailyTreatment
@using System.Text.Json
@using PTDoc.UI.Components.Notes.Models
@using PTDoc.Application.Notes.Workspace

<section class="daily-subjective @(IsDarkMode ? "daily-subjective--dark" : string.Empty)" data-testid="daily-subjective-section">
    <div class="daily-grid">
        <div class="daily-col-12">
            <FormSection Title="Pain and Body Region" Subtitle="Document today's patient-reported pain and symptoms">
                <fieldset class="daily-question-group">
                    <legend>Body regions (select all that apply)</legend>
                    <CheckboxGrid Options="@BodyPartOptions" Selected="_vm.Locations" SelectedChanged="UpdateLocations" IsReadOnly="@ReadOnly" Columns="2" />
                </fieldset>
                <label class="daily-subjective__label" for="daily-pain-location">Pain location details</label>
                <input id="daily-pain-location" class="daily-question-input" disabled="@ReadOnly"
                       @bind="_vm.OtherLocation" @bind:event="oninput" @bind:after="NotifySubjectiveAsync" />
                <label class="daily-subjective__label" for="daily-pain-description">Pain description</label>
                <textarea id="daily-pain-description" class="daily-question-input" rows="3" disabled="@ReadOnly"
                          @bind="_vm.KnownCause" @bind:event="oninput" @bind:after="NotifySubjectiveAsync"></textarea>
                <fieldset class="daily-question-group">
                    <legend>Associated symptoms (select all that apply)</legend>
                    <CheckboxGrid Options="@SymptomOptions" Selected="_dailyTreatment.AssociatedSymptoms" SelectedChanged="UpdateSymptoms" IsReadOnly="@ReadOnly" Columns="2" />
                </fieldset>
                <div data-question-id="current-pain" data-reference-number="3" class="daily-question-group">
                    <label class="daily-subjective__label" for="daily-current-pain">@DailyQuestionnaireDefinition.CurrentPain.Label</label>
                    <input id="daily-current-pain" class="daily-question-input" type="number" min="0" max="10" disabled="@ReadOnly"
                           value="@(_vm.IsPainScoreDocumented ? _vm.CurrentPainScore.ToString() : string.Empty)" @oninput="UpdateCurrentPain" />
                    <div class="daily-question-pain-range">
                        <label>Best<input class="daily-question-input" type="number" min="0" max="10" disabled="@ReadOnly" @bind="_vm.BestPainScore" @bind:after="NotifySubjectiveAsync" /></label>
                        <label>Worst<input class="daily-question-input" type="number" min="0" max="10" disabled="@ReadOnly" @bind="_vm.WorstPainScore" @bind:after="NotifySubjectiveAsync" /></label>
                    </div>
                </div>
            </FormSection>
        </div>
        @if (UnsupportedVersion)
        {
            <div class="daily-col-12" role="status">This saved Daily questionnaire uses another version and is read-only in this client.
                <p>@DailyQuestionnaireDefinition.Summarize(_answers)</p>
            </div>
        }
        else if (!IsReadOnly || _dailyTreatment.Questionnaire is not null)
        {
            @foreach (var question in DailyQuestionnaireDefinition.Questions.Where(q => q.Id != "current-pain"))
            {
                <div class="daily-col-12" data-question-id="@question.Id" data-reference-number="@question.ReferenceNumber">
                    <FormSection Title="@question.Label">
                        @if (question.Id == "activity-changes")
                        {
                            <CheckboxGrid Options="@DailyQuestionnaireDefinition.ActivityChanges.Options" Selected="_answers.ImprovedActivities" SelectedChanged="UpdateImproved" IsReadOnly="@ReadOnly" Columns="2" />
                            <fieldset class="daily-question-group"><legend>Which activities have stayed the same?</legend>
                                <CheckboxGrid Options="@DailyQuestionnaireDefinition.ActivityStateOptions" Selected="_answers.SameActivities" SelectedChanged="UpdateSame" IsReadOnly="@ReadOnly" Columns="2" />
                            </fieldset>
                            <fieldset class="daily-question-group"><legend>Which activities have gotten worse?</legend>
                                <CheckboxGrid Options="@DailyQuestionnaireDefinition.ActivityStateOptions" Selected="_answers.WorseActivities" SelectedChanged="UpdateWorse" IsReadOnly="@ReadOnly" Columns="2" />
                            </fieldset>
                            <fieldset class="daily-question-group"><legend>Which activities are newly difficult?</legend>
                                <CheckboxGrid Options="@DailyQuestionnaireDefinition.ActivityStateOptions" Selected="_answers.NewDifficultyActivities" SelectedChanged="UpdateNewDifficulty" IsReadOnly="@ReadOnly" Columns="2" />
                            </fieldset>
                        }
                        else
                        {
                            <label class="daily-question-label" for="@($"daily-{question.Id}")">@question.Label</label>
                            <select id="@($"daily-{question.Id}")" class="daily-question-input" disabled="@ReadOnly" value="@Answer(question.Id)" @onchange="e => UpdateAnswer(question.Id, e)">
                                <option value="">Select an answer</option>
                                @if (!string.IsNullOrEmpty(Answer(question.Id)) && !question.Options.Contains(Answer(question.Id)))
                                { <option value="@Answer(question.Id)">@Answer(question.Id) (saved value)</option> }
                                @foreach (var option in question.Options) { <option value="@option">@option</option> }
                            </select>
                        }
                    </FormSection>
                </div>
            }
            <div class="daily-col-12">
                <FormSection Title="Additional Information">
                    <label class="daily-subjective__label" for="daily-additional-information">Additional information for your therapist</label>
                    <textarea id="daily-additional-information" class="daily-question-input" rows="4" maxlength="2000" disabled="@ReadOnly"
                              @bind="_answers.AdditionalInformation" @bind:event="oninput" @bind:after="NotifyDailyAsync"></textarea>
                </FormSection>
            </div>
        }
        @if (LegacyEntries.Any())
        {
            <div class="daily-col-12">
                <details class="daily-legacy" open="@IsReadOnly" data-testid="daily-historical-values">
                    <summary>Previously recorded Daily information</summary>
                    <p>Saved historical values are retained separately from today's questionnaire.</p>
                    <dl>
                        @foreach (var entry in LegacyEntries)
                        { <dt>@entry.Label</dt><dd>@entry.Value</dd> }
                    </dl>
                </details>
            </div>
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired] public SubjectiveVm Vm { get; set; } = new();
    [Parameter] public DailyTreatmentVm DailyTreatment { get; set; } = new();
    [Parameter, EditorRequired] public EventCallback<SubjectiveVm> VmChanged { get; set; }
    [Parameter] public EventCallback<DailyTreatmentVm> DailyTreatmentChanged { get; set; }
    [Parameter] public bool IsReadOnly { get; set; }
    [Parameter] public bool IsDarkMode { get; set; }
    private SubjectiveVm _vm = new();
    private DailyTreatmentVm _dailyTreatment = new();
    private DailyQuestionnaireV1 _answers = new();
    private bool UnsupportedVersion => _answers.Version != DailyQuestionnaireDefinition.Version;
    private bool ReadOnly => IsReadOnly || UnsupportedVersion;
    private static readonly string[] BodyParts = ["Shoulder Pain", "Elbow Pain", "Wrist/Hand Pain", "Neck Pain", "Back Pain", "Hip Pain", "Knee Pain", "Ankle/Foot Pain"];
    private static readonly string[] Symptoms = ["Sharp Pain", "Dull Ache", "Stiffness", "Weakness", "Numbness", "Tingling", "Swelling", "Instability"];
    private IReadOnlyList<string> BodyPartOptions => BodyParts.Concat(_vm.Locations).Distinct(StringComparer.OrdinalIgnoreCase).ToArray();
    private IReadOnlyList<string> SymptomOptions => Symptoms.Concat(_dailyTreatment.AssociatedSymptoms).Distinct(StringComparer.OrdinalIgnoreCase).ToArray();
    protected override void OnParametersSet()
    {
        _vm = Clone(Vm);
        _dailyTreatment = Clone(DailyTreatment);
        _answers = DailyQuestionnaireDefinition.Clone(_dailyTreatment.Questionnaire) ?? new();
        _answers.ImprovedActivities ??= []; _answers.SameActivities ??= [];
        _answers.WorseActivities ??= []; _answers.NewDifficultyActivities ??= [];
        _vm.Locations ??= []; _dailyTreatment.AssociatedSymptoms ??= [];
    }
    private static T Clone<T>(T value) => JsonSerializer.Deserialize<T>(JsonSerializer.Serialize(value))!;
    private string Answer(string id) => id switch
    {
        "overall-condition" => _answers.OverallCondition, "pain-change" => _answers.PainChange,
        "pain-frequency" => _vm.PainFrequency, "daily-activity-ease" => _answers.DailyActivityEase,
        "hep-adherence" => _answers.HepAdherence, _ => string.Empty
    };
    private async Task UpdateAnswer(string id, ChangeEventArgs e)
    {
        if (ReadOnly) return;
        var value = e.Value?.ToString() ?? string.Empty;
        switch (id)
        {
            case "overall-condition": _answers.OverallCondition = value; break;
            case "pain-change": _answers.PainChange = value; break;
            case "pain-frequency": _vm.PainFrequency = value; await NotifySubjectiveAsync(); return;
            case "daily-activity-ease": _answers.DailyActivityEase = value; break;
            case "hep-adherence": _answers.HepAdherence = value; break;
        }
        await NotifyDailyAsync();
    }
    private Task UpdateCurrentPain(ChangeEventArgs e)
    {
        if (ReadOnly) return Task.CompletedTask;
        _vm.IsPainScoreDocumented = int.TryParse(e.Value?.ToString(), out var value) && value is >= 0 and <= 10;
        _vm.CurrentPainScore = _vm.IsPainScoreDocumented ? value : 0;
        return NotifySubjectiveAsync();
    }
    private Task UpdateLocations(HashSet<string> values) { _vm.Locations = values; return NotifySubjectiveAsync(); }
    private Task UpdateSymptoms(HashSet<string> values) { _dailyTreatment.AssociatedSymptoms = values; return NotifyDailyAsync(); }
    private Task UpdateImproved(HashSet<string> values)
    {
        if (values.Contains("None") && !_answers.ImprovedActivities.Contains("None")) values = ["None"];
        else if (values.Count > 1) values.Remove("None");
        _answers.ImprovedActivities = values; return NotifyDailyAsync();
    }
    private Task UpdateSame(HashSet<string> values) { _answers.SameActivities = values; return NotifyDailyAsync(); }
    private Task UpdateWorse(HashSet<string> values) { _answers.WorseActivities = values; return NotifyDailyAsync(); }
    private Task UpdateNewDifficulty(HashSet<string> values) { _answers.NewDifficultyActivities = values; return NotifyDailyAsync(); }
    private Task NotifySubjectiveAsync() => ReadOnly ? Task.CompletedTask : VmChanged.InvokeAsync(Clone(_vm));
    private Task NotifyDailyAsync()
    {
        if (ReadOnly) return Task.CompletedTask;
        _dailyTreatment.Questionnaire = DailyQuestionnaireDefinition.Clone(_answers);
        return DailyTreatmentChanged.InvokeAsync(Clone(_dailyTreatment));
    }
    private IEnumerable<(string Label, string? Value)> LegacyEntries => new (string, string?)[]
    {
        ("Historical complaint", string.Join("; ", _vm.Problems ?? [])), ("Historical complaint additions", _vm.OtherProblem),
        ("Visit changes", _dailyTreatment.ChangesSinceLastVisit), ("Pain level changes", _dailyTreatment.PainLevelChanges),
        ("Subjective update", _dailyTreatment.SubjectiveUpdate), ("HEP adherence", _dailyTreatment.HepAdherence),
        ("HEP update", _dailyTreatment.HepUpdateNotes), ("Functional improvements", _dailyTreatment.FunctionalImprovements),
        ("New or changed symptoms", _dailyTreatment.NewOrChangedSymptoms), ("Barriers to progress", _dailyTreatment.BarriersToProgress),
        ("Previous treatment", _dailyTreatment.PreviousTreatment), ("Response to treatment", _dailyTreatment.ResponseToTreatment),
        ("Functional limitations", _vm.AdditionalFunctionalLimitations)
    }.Where(e => !string.IsNullOrWhiteSpace(e.Item2));
}
