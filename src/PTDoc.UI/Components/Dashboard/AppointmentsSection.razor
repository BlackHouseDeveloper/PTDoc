@using PTDoc.Application.DTOs
@inject NavigationManager NavigationManager

<section class="appointments-section" aria-labelledby="today-appointments-title" data-testid="today-appointments">
    <div class="appointments-section__header">
        <h2 id="today-appointments-title">Today&apos;s Appointments</h2>
        <button type="button"
                class="appointments-section__add"
                @onclick="HandleAddAppointment"
                aria-label="Add appointment">
            <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d="M10 4V16M4 10H16" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
            </svg>
            <span>Add</span>
        </button>
    </div>

    @if (IsLoading && Appointments.Count == 0)
    {
        <div class="appointments-section__grid" role="status" aria-live="polite" aria-label="Loading today's appointments">
            <div class="appointments-section__skeleton"><LoadingSkeleton Variant="SkeletonVariant.Rectangle" Size="SkeletonSize.Large" /></div>
            <div class="appointments-section__skeleton"><LoadingSkeleton Variant="SkeletonVariant.Rectangle" Size="SkeletonSize.Large" /></div>
        </div>
    }
    else if (HasError && Appointments.Count == 0)
    {
        <div class="appointments-section__state appointments-section__state--error" role="alert">
            <h3>Unable to load today&apos;s appointments</h3>
            <p>@ErrorMessage</p>
            @if (OnRetry.HasDelegate)
            {
                <button type="button" class="appointments-section__retry" @onclick="OnRetry">Retry</button>
            }
        </div>
    }
    else if (Appointments.Count == 0)
    {
        <div class="appointments-section__state" data-testid="today-appointments-empty">
            <h3>No appointments scheduled today</h3>
            <p>New appointments will appear here once they are added to the schedule.</p>
        </div>
    }
    else
    {
        @if (HasError)
        {
            <div class="appointments-section__inline-error" role="alert">
                <span>@ErrorMessage</span>
                @if (OnRetry.HasDelegate)
                {
                    <button type="button" @onclick="OnRetry">Retry</button>
                }
            </div>
        }

        <div class="appointments-section__grid" aria-busy="@IsLoading">
            @foreach (var appointment in Appointments)
            {
                <DashboardAppointmentCard Appointment="@appointment"
                                          OnAction="@(action => HandleAppointmentAction(appointment, action))" />
            }
        </div>
    }
</section>

@code {
    [Parameter] public IReadOnlyList<AppointmentListItemResponse> Appointments { get; set; } = Array.Empty<AppointmentListItemResponse>();
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool HasError { get; set; }
    [Parameter] public string ErrorMessage { get; set; } = "Appointment data could not be refreshed. Please try again.";
    [Parameter] public EventCallback OnRetry { get; set; }

    private void HandleAddAppointment() =>
        NavigationManager.NavigateTo("/appointments?action=appointments.new");

    private void HandleAppointmentAction(
        AppointmentListItemResponse appointment,
        DashboardAppointmentAction action)
    {
        var routeAction = action switch
        {
            DashboardAppointmentAction.CheckIn => "appointments.check-in",
            DashboardAppointmentAction.StartNote => "appointments.start-note",
            DashboardAppointmentAction.Reschedule => "appointments.reschedule",
            _ => "appointments.details"
        };

        NavigationManager.NavigateTo(
            $"/appointments?dateRange=today&appointmentId={appointment.Id:D}&action={routeAction}");
    }
}
