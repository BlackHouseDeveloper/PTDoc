@using PTDoc.UI.Components.Intake.Models

<nav class="pain-progress" data-testid="pain-progress" aria-label="Intake progress">
    <div class="pain-progress__labels @(IsShortVisit ? "pain-progress__labels--short" : string.Empty)">
        @for (var index = 0; index < Steps.Length; index++)
        {
            var step = Steps[index];
            var isActive = step == CurrentStep || (IsShortVisit && index == 0 && CurrentStep != IntakeStep.Review);
            var isComplete = (int)step < (int)CurrentStep;
            <span class="@(isActive ? "is-active" : isComplete ? "is-complete" : string.Empty)"
                  aria-current="@(isActive ? "step" : null)"
                  data-step-label="@($"Step {index + 1} of {Steps.Length}: ")">@Labels[index]</span>
        }
    </div>
    <div class="pain-progress__track" aria-hidden="true">
        <div class="@GetFillClass()"></div>
    </div>
</nav>

@code {
    private readonly IntakeStep[] _steps =
    {
        IntakeStep.Demographics,
        IntakeStep.PainAssessment,
        IntakeStep.PainDetails,
        IntakeStep.OutcomeMeasures,
        IntakeStep.Review
    };

    private readonly string[] _labels =
    {
        "Demographics",
        "Medical History / Pain Assessment",
        "Pain Details",
        "Outcome Measures",
        "Review"
    };

    [Parameter, EditorRequired] public IntakeStep CurrentStep { get; set; }
    [Parameter] public bool IsShortVisit { get; set; }

    private static readonly IntakeStep[] ShortSteps = [IntakeStep.Demographics, IntakeStep.Review];
    private static readonly string[] ShortLabels = ["Visit questionnaire", "Review and consent"];
    private IntakeStep[] Steps => IsShortVisit ? ShortSteps : _steps;
    private string[] Labels => IsShortVisit ? ShortLabels : _labels;

    private string GetFillClass()
    {
        if (IsShortVisit)
            return CurrentStep == IntakeStep.Review ? "pain-progress__fill pain-progress__fill--5" : "pain-progress__fill pain-progress__fill--half";

        return CurrentStep switch
        {
            IntakeStep.Demographics => "pain-progress__fill pain-progress__fill--1",
            IntakeStep.PainAssessment => "pain-progress__fill pain-progress__fill--2",
            IntakeStep.PainDetails => "pain-progress__fill pain-progress__fill--3",
            IntakeStep.OutcomeMeasures => "pain-progress__fill pain-progress__fill--4",
            _ => "pain-progress__fill pain-progress__fill--5"
        };
    }
}
