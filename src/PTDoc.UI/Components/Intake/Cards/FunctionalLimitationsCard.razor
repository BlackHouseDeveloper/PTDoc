@using PTDoc.Application.Intake
@using PTDoc.Application.Notes.Workspace
@using PTDoc.Application.ReferenceData
@using PTDoc.Core.Models
@using PTDoc.UI.Components.Intake.Models
@inject IIntakeReferenceDataCatalogService IntakeReferenceData

<section class="intake-card" data-testid="intake-subjective-alignment">
    <div>
        <h2>Function &amp; Condition History</h2>
        <p class="intake-card__subtext">Your answers will be available for the clinician to review in the Evaluation Subjective section.</p>
    </div>

    <section class="intake-card__section">
        <fieldset class="intake-card__fieldset">
            <legend>Prior to this condition or injury, what was your level of function? <span>(Select all that apply)</span></legend>
            <div class="intake-card__choice-grid">
                @foreach (var level in PatientReportedSubjectiveCatalog.PriorFunctionalLevels)
                {
                    <label class="intake-card__choice">
                        <input type="checkbox"
                               checked="@Subjective.PriorFunctionalLevel.Contains(level, StringComparer.OrdinalIgnoreCase)"
                               @onchange="args => TogglePriorFunctionalLevelAsync(level, ToBool(args))" />
                        <span>@level</span>
                    </label>
                }
            </div>
        </fieldset>

        <label class="intake-card__notes" for="intake-current-level-of-function">Current Level of Function
            <textarea id="intake-current-level-of-function"
                      class="form-control"
                      value="@State.CurrentLevelOfFunction"
                      @oninput="OnCurrentLevelChangedAsync"
                      placeholder="Describe what you can currently do and where you need help, rest breaks, or equipment."></textarea>
        </label>
    </section>

    <section class="intake-card__section" aria-labelledby="functional-activities-title">
        <div class="intake-card__section-heading">
            <div>
                <h3 id="functional-activities-title">Functional Activities Limited</h3>
                <p>Choose every activity that is limited. Options are based on the selected body region.</p>
            </div>
            @if (SelectedBodyPart != BodyPart.Other)
            {
                <span class="intake-card__context-badge">@FormatBodyPart(SelectedBodyPart)</span>
            }
        </div>

        @if (SelectedBodyPart == BodyPart.Other)
        {
            <p class="intake-card__helper">Select an affected area above to load clinically relevant activities.</p>
        }
        else if (FunctionalLimitationCategories.Count == 0)
        {
            <p class="intake-card__helper">No structured activity catalog is available for this body region yet. Use the details field below.</p>
        }
        else
        {
            <div class="intake-card__accordion-list">
                @foreach (var category in FunctionalLimitationCategories)
                {
                    <details class="intake-card__accordion">
                        <summary>
                            <span>@category.Name</span>
                            @if (SelectedCount(category) > 0)
                            {
                                <span class="intake-card__selection-count">@SelectedCount(category) selected</span>
                            }
                        </summary>
                        <div class="intake-card__accordion-content">
                            @foreach (var activity in category.Items)
                            {
                                <label class="intake-card__choice intake-card__choice--activity">
                                    <input type="checkbox"
                                           checked="@IsFunctionalLimitationSelected(category.Name, activity)"
                                           @onchange="args => ToggleFunctionalLimitationAsync(category.Name, activity, ToBool(args))" />
                                    <span>@activity</span>
                                </label>
                            }
                        </div>
                    </details>
                }
            </div>
        }

        <label class="intake-card__notes" for="intake-functional-limitations">Additional functional limitations
            <textarea id="intake-functional-limitations"
                      class="form-control"
                      value="@State.FunctionalLimitations"
                      @oninput="OnAdditionalLimitationsChangedAsync"
                      placeholder="Describe any other activity limitations not listed above."></textarea>
        </label>
    </section>

    <section class="intake-card__section intake-card__history-grid">
        <div>
            <label class="intake-card__field-label" for="intake-onset-date">When did the issue begin?</label>
            <input id="intake-onset-date"
                   class="form-control"
                   type="date"
                   value="@(Subjective.OnsetDate?.ToString("yyyy-MM-dd") ?? string.Empty)"
                   @onchange="OnOnsetDateChangedAsync" />
            <label class="intake-card__choice intake-card__choice--inline">
                <input type="checkbox"
                       checked="@Subjective.OnsetOverAYearAgo"
                       @onchange="OnOnsetOverAYearChangedAsync" />
                <span>Over a year ago</span>
            </label>
        </div>

        <div>
            <label class="intake-card__field-label" for="intake-known-cause">What caused the issue?</label>
            <label class="intake-card__choice intake-card__choice--inline">
                <input type="checkbox"
                       checked="@Subjective.CauseUnknown"
                       @onchange="OnCauseUnknownChangedAsync" />
                <span>Unknown</span>
            </label>
            <textarea id="intake-known-cause"
                      class="form-control"
                      value="@Subjective.KnownCause"
                      disabled="@Subjective.CauseUnknown"
                      @oninput="OnKnownCauseChangedAsync"
                      placeholder="Describe the injury, event, or gradual onset."></textarea>
        </div>
    </section>

    <section class="intake-card__section">
        <fieldset class="intake-card__fieldset">
            <legend>Have you had imaging for this concern?</legend>
            <div class="intake-card__radio-row">
                <label class="intake-card__choice intake-card__choice--inline">
                    <input type="radio" name="intake-imaging" checked="@(Subjective.HasImaging == true)" @onchange="_ => SetHasImagingAsync(true)" />
                    <span>Yes</span>
                </label>
                <label class="intake-card__choice intake-card__choice--inline">
                    <input type="radio" name="intake-imaging" checked="@(Subjective.HasImaging == false)" @onchange="_ => SetHasImagingAsync(false)" />
                    <span>No</span>
                </label>
            </div>
        </fieldset>

        @if (Subjective.HasImaging == true)
        {
            <div class="intake-card__choice-grid intake-card__choice-grid--compact" data-testid="intake-imaging-details">
                @foreach (var modality in PatientReportedSubjectiveCatalog.ImagingModalities)
                {
                    <label class="intake-card__choice">
                        <input type="checkbox"
                               checked="@Subjective.ImagingModalities.Contains(modality, StringComparer.OrdinalIgnoreCase)"
                               @onchange="args => ToggleImagingModalityAsync(modality, ToBool(args))" />
                        <span>@modality</span>
                    </label>
                }
            </div>

            @if (Subjective.ImagingModalities.Contains("Other", StringComparer.OrdinalIgnoreCase))
            {
                <label for="intake-other-imaging">Other imaging type
                    <input id="intake-other-imaging" class="form-control" value="@Subjective.OtherImagingModality" @oninput="OnOtherImagingChangedAsync" />
                </label>
            }

            <label class="intake-card__notes" for="intake-imaging-findings">What were you told about the results?
                <textarea id="intake-imaging-findings" class="form-control" value="@Subjective.ImagingFindings" @oninput="OnImagingFindingsChangedAsync"></textarea>
            </label>
        }
    </section>
</section>

@code {
    [Parameter, EditorRequired] public IntakeWizardState State { get; set; } = new();
    [Parameter] public EventCallback StateChanged { get; set; }

    private IntakeStructuredDataDto StructuredData => State.EnsureStructuredData(IntakeReferenceData.GetCatalog().Version);
    private IntakeSubjectiveDataDto Subjective => StructuredData.Subjective;

    private BodyPart SelectedBodyPart
    {
        get
        {
            foreach (var region in (State.SelectedBodyRegion ?? string.Empty)
                         .Split('|', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
            {
                var mapped = IntakeBodyRegionMapper.Map(region);
                if (mapped != BodyPart.Other)
                {
                    return mapped;
                }
            }

            foreach (var region in State.SelectedBodyRegions.OrderBy(value => value.ToString(), StringComparer.Ordinal))
            {
                var mapped = IntakeBodyRegionMapper.Map(region);
                if (mapped != BodyPart.Other)
                {
                    return mapped;
                }
            }

            return BodyPart.Other;
        }
    }

    private IReadOnlyList<CatalogCategory> FunctionalLimitationCategories =>
        SelectedBodyPart == BodyPart.Other
            ? Array.Empty<CatalogCategory>()
            : IntakeReferenceData.GetFunctionalLimitationCategories(SelectedBodyPart);

    private bool IsFunctionalLimitationSelected(string category, string activity) =>
        StructuredData.FunctionalLimitations.Any(selection =>
            string.Equals(selection.BodyPart, SelectedBodyPart.ToString(), StringComparison.OrdinalIgnoreCase)
            && string.Equals(selection.Category, category, StringComparison.OrdinalIgnoreCase)
            && string.Equals(selection.Activity, activity, StringComparison.OrdinalIgnoreCase));

    private int SelectedCount(CatalogCategory category) =>
        category.Items.Count(activity => IsFunctionalLimitationSelected(category.Name, activity));

    private async Task ToggleFunctionalLimitationAsync(string category, string activity, bool selected)
    {
        StructuredData.FunctionalLimitations.RemoveAll(selection =>
            string.Equals(selection.BodyPart, SelectedBodyPart.ToString(), StringComparison.OrdinalIgnoreCase)
            && string.Equals(selection.Category, category, StringComparison.OrdinalIgnoreCase)
            && string.Equals(selection.Activity, activity, StringComparison.OrdinalIgnoreCase));

        if (selected)
        {
            StructuredData.FunctionalLimitations.Add(new IntakeFunctionalLimitationSelectionDto
            {
                Id = BuildSelectionId(SelectedBodyPart, category, activity),
                BodyPart = SelectedBodyPart.ToString(),
                Category = category,
                Activity = activity
            });
        }

        await NotifyChangedAsync();
    }

    private async Task TogglePriorFunctionalLevelAsync(string level, bool selected)
    {
        Subjective.PriorFunctionalLevel.RemoveAll(value => string.Equals(value, level, StringComparison.OrdinalIgnoreCase));
        if (selected)
        {
            Subjective.PriorFunctionalLevel.Add(level);
        }

        await NotifyChangedAsync();
    }

    private async Task ToggleImagingModalityAsync(string modality, bool selected)
    {
        Subjective.ImagingModalities.RemoveAll(value => string.Equals(value, modality, StringComparison.OrdinalIgnoreCase));
        if (selected)
        {
            Subjective.ImagingModalities.Add(modality);
        }

        if (!Subjective.ImagingModalities.Contains("Other", StringComparer.OrdinalIgnoreCase))
        {
            Subjective.OtherImagingModality = null;
        }

        await NotifyChangedAsync();
    }

    private Task OnCurrentLevelChangedAsync(ChangeEventArgs args) => UpdateAsync(() => State.CurrentLevelOfFunction = args.Value?.ToString());
    private Task OnAdditionalLimitationsChangedAsync(ChangeEventArgs args) => UpdateAsync(() => State.FunctionalLimitations = args.Value?.ToString());
    private Task OnOnsetOverAYearChangedAsync(ChangeEventArgs args) => UpdateAsync(() => Subjective.OnsetOverAYearAgo = ToBool(args));
    private Task OnKnownCauseChangedAsync(ChangeEventArgs args) => UpdateAsync(() => Subjective.KnownCause = args.Value?.ToString());
    private Task OnOtherImagingChangedAsync(ChangeEventArgs args) => UpdateAsync(() => Subjective.OtherImagingModality = args.Value?.ToString());
    private Task OnImagingFindingsChangedAsync(ChangeEventArgs args) => UpdateAsync(() => Subjective.ImagingFindings = args.Value?.ToString());

    private Task OnOnsetDateChangedAsync(ChangeEventArgs args) => UpdateAsync(() =>
    {
        Subjective.OnsetDate = DateTime.TryParse(args.Value?.ToString(), out var value) ? value.Date : null;
    });

    private Task OnCauseUnknownChangedAsync(ChangeEventArgs args) => UpdateAsync(() =>
    {
        Subjective.CauseUnknown = ToBool(args);
        if (Subjective.CauseUnknown)
        {
            Subjective.KnownCause = null;
        }
    });

    private Task SetHasImagingAsync(bool value) => UpdateAsync(() =>
    {
        Subjective.HasImaging = value;
        if (!value)
        {
            Subjective.ImagingModalities.Clear();
            Subjective.OtherImagingModality = null;
            Subjective.ImagingFindings = null;
        }
    });

    private async Task UpdateAsync(Action update)
    {
        update();
        await NotifyChangedAsync();
    }

    private async Task NotifyChangedAsync()
    {
        State.IsDirty = true;
        if (StateChanged.HasDelegate)
        {
            await StateChanged.InvokeAsync();
        }
    }

    private static bool ToBool(ChangeEventArgs args) => args.Value is bool value && value;

    private static string FormatBodyPart(BodyPart bodyPart) => bodyPart switch
    {
        BodyPart.PelvicFloor => "Pelvic floor",
        _ => bodyPart.ToString()
    };

    private static string BuildSelectionId(BodyPart bodyPart, string category, string activity) =>
        $"{bodyPart}-{category}-{activity}"
            .ToLowerInvariant()
            .Replace(" ", "-", StringComparison.Ordinal)
            .Replace("/", "-", StringComparison.Ordinal)
            .Replace("&", "and", StringComparison.Ordinal);
}
