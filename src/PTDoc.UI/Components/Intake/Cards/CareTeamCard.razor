@using PTDoc.Application.Providers
@using PTDoc.Core.Models
@inject IProviderDirectoryService ProviderDirectory

<section class="intake-card">
    <h2>Care Team</h2>
    <p class="intake-card__subtext">List the doctors involved in your care, if known.</p>

    <div class="intake-card__form-grid">
        <div class="intake-card__directory-search">
            <label for="intake-provider-directory-search">Find an approved provider
                <input id="intake-provider-directory-search" class="form-control" @bind="DirectoryQuery" @bind:event="oninput" placeholder="Search name, organization, or NPI" />
            </label>
            <button type="button" class="btn btn-outline" @onclick="SearchDirectoryAsync" disabled="@IsSearching">@(IsSearching ? "Searching…" : "Search directory")</button>
            @if (!string.IsNullOrWhiteSpace(DirectoryError))
            {
                <span class="intake-card__directory-error" role="alert">@DirectoryError</span>
            }
            @if (DirectoryMatches.Count > 0)
            {
                <div class="intake-card__directory-results" aria-label="Approved provider search results">
                    @foreach (var provider in DirectoryMatches)
                    {
                        <article>
                            <span><strong>@provider.DisplayName</strong><small>@string.Join(" · ", new[] { provider.OrganizationName, provider.Specialty, provider.Npi }.Where(value => !string.IsNullOrWhiteSpace(value)))</small></span>
                            <span><button type="button" class="btn btn-outline" @onclick="() => SelectProviderAsync(provider, false)">Use as primary</button><button type="button" class="btn btn-outline" @onclick="() => SelectProviderAsync(provider, true)">Use as referring</button></span>
                        </article>
                    }
                </div>
            }
            <p class="intake-card__directory-help">Provider not found? Enter their details below. They will remain linked only to your record until the clinic approves them.</p>
        </div>

        <label for="intake-primary-doctor-name">Primary Doctor
            <input id="intake-primary-doctor-name" class="form-control" value="@PrimaryDoctorName" @oninput="(args) => PrimaryDoctorNameChanged.InvokeAsync(args.Value?.ToString())" placeholder="Primary doctor name" />
        </label>

        <label for="intake-primary-doctor-phone">Primary Doctor Phone
            <input id="intake-primary-doctor-phone" class="form-control" type="tel" value="@PrimaryDoctorPhone" @oninput="(args) => PrimaryDoctorPhoneChanged.InvokeAsync(args.Value?.ToString())" placeholder="(555) 123-4567" />
        </label>

        <label class="intake-card__same-provider">
            <input type="checkbox"
                   class="form-check-input"
                   checked="@IsSamePhysician"
                   @onchange="OnSamePhysicianChangedAsync" />
            <span>Referring doctor is the same as primary doctor</span>
        </label>

        <label for="intake-referring-doctor-name">Referring Doctor
            <input id="intake-referring-doctor-name" class="form-control" value="@ReferringDoctorName" disabled="@IsSamePhysician" @oninput="(args) => ReferringDoctorNameChanged.InvokeAsync(args.Value?.ToString())" placeholder="Referring doctor name" />
        </label>

        <label for="intake-referring-doctor-npi">Referring Doctor NPI
            <input id="intake-referring-doctor-npi" class="form-control" value="@ReferringDoctorNpi" disabled="@IsSamePhysician" @oninput="(args) => ReferringDoctorNpiChanged.InvokeAsync(args.Value?.ToString())" placeholder="10-digit NPI" />
        </label>

        <label for="intake-referring-doctor-phone">Referring Doctor Phone
            <input id="intake-referring-doctor-phone" class="form-control" type="tel" value="@ReferringDoctorPhone" disabled="@IsSamePhysician" @oninput="(args) => ReferringDoctorPhoneChanged.InvokeAsync(args.Value?.ToString())" placeholder="(555) 123-4567" />
        </label>
    </div>
</section>

@code {
    [Parameter] public string? PrimaryDoctorName { get; set; }
    [Parameter] public string? PrimaryDoctorPhone { get; set; }
    [Parameter] public string? ReferringDoctorName { get; set; }
    [Parameter] public string? ReferringDoctorNpi { get; set; }
    [Parameter] public string? ReferringDoctorPhone { get; set; }

    [Parameter] public EventCallback<string?> PrimaryDoctorNameChanged { get; set; }
    [Parameter] public EventCallback<string?> PrimaryDoctorPhoneChanged { get; set; }
    [Parameter] public EventCallback<string?> ReferringDoctorNameChanged { get; set; }
    [Parameter] public EventCallback<string?> ReferringDoctorNpiChanged { get; set; }
    [Parameter] public EventCallback<string?> ReferringDoctorPhoneChanged { get; set; }

    private string DirectoryQuery { get; set; } = string.Empty;
    private List<ProviderDirectoryEntryDto> DirectoryMatches { get; set; } = [];
    private string? DirectoryError { get; set; }
    private bool IsSearching { get; set; }

    private bool IsSamePhysician =>
        !string.IsNullOrWhiteSpace(PrimaryDoctorName)
        && string.Equals(PrimaryDoctorName?.Trim(), ReferringDoctorName?.Trim(), StringComparison.OrdinalIgnoreCase)
        && string.Equals(PrimaryDoctorPhone?.Trim(), ReferringDoctorPhone?.Trim(), StringComparison.OrdinalIgnoreCase)
        && string.IsNullOrWhiteSpace(ReferringDoctorNpi);

    private async Task OnSamePhysicianChangedAsync(ChangeEventArgs args)
    {
        if (args.Value is not true)
        {
            return;
        }

        await ReferringDoctorNameChanged.InvokeAsync(PrimaryDoctorName);
        await ReferringDoctorPhoneChanged.InvokeAsync(PrimaryDoctorPhone);
        await ReferringDoctorNpiChanged.InvokeAsync(null);
    }

    private async Task SearchDirectoryAsync()
    {
        DirectoryError = null;
        if (DirectoryQuery.Trim().Length < 2)
        {
            DirectoryMatches = [];
            DirectoryError = "Enter at least two characters to search the provider directory.";
            return;
        }

        IsSearching = true;
        try
        {
            DirectoryMatches = [.. await ProviderDirectory.SearchAsync(DirectoryQuery, ProviderDirectoryStatus.Active, 10, default)];
            if (DirectoryMatches.Count == 0) DirectoryError = "No approved providers matched your search.";
        }
        catch
        {
            DirectoryMatches = [];
            DirectoryError = "The provider directory is temporarily unavailable. You can still enter the provider details below.";
        }
        finally
        {
            IsSearching = false;
        }
    }

    private async Task SelectProviderAsync(ProviderDirectoryEntryDto provider, bool referring)
    {
        var providerName = string.Join(" ", new[] { provider.FirstName, provider.LastName }.Where(value => !string.IsNullOrWhiteSpace(value)));
        if (referring)
        {
            await ReferringDoctorNameChanged.InvokeAsync(providerName);
            await ReferringDoctorNpiChanged.InvokeAsync(provider.Npi);
            await ReferringDoctorPhoneChanged.InvokeAsync(provider.Phone);
        }
        else
        {
            await PrimaryDoctorNameChanged.InvokeAsync(providerName);
            await PrimaryDoctorPhoneChanged.InvokeAsync(provider.Phone);
        }

        DirectoryMatches = [];
        DirectoryQuery = string.Empty;
    }
}
