@using PTDoc.Application.Insurance
@inject IInsurancePolicyService InsurancePolicies
@inject PTDoc.Application.ReferenceData.IIntakeReferenceDataCatalogService IntakeReferenceData
@inject IToastService ToastService

<PatientInfoSectionPanel Title="Insurance Policies">
    <div class="insurance-policies">
        <div class="insurance-policies__header"><p>Normalized primary, secondary, and tertiary coverage records. Historical policies remain available after archival.</p><button type="button" class="btn btn-outline" @onclick="BeginAdd">Add policy</button></div>
        @if(isLoading){<div class="insurance-policies__state" role="status">Loading insurance policies…</div>}
        else if(!string.IsNullOrWhiteSpace(error)){<div class="insurance-policies__state insurance-policies__state--error" role="alert">@error</div>}
        else if(policies.Count==0){<div class="insurance-policies__state">No normalized insurance policies are available yet. Legacy payer details remain visible during migration.</div>}
        else{<div class="insurance-policies__list">@foreach(var policy in policies){<article class="insurance-policies__card"><div><strong>@policy.CoveragePriority · @(policy.CarrierDisplayName??"Self Pay")</strong><span>@policy.PayerType · @(policy.MemberOrPolicyNumber??"No member ID")</span>@foreach(var authorization in policy.Authorizations){<span>@authorization.AuthorizationType · @authorization.Status · @(authorization.ReferenceNumber??"No reference") <button type="button" class="btn btn-outline" @onclick="()=>BeginAuthorizationEdit(policy.Id,authorization)">Edit</button> <button type="button" class="btn btn-outline" @onclick="()=>ArchiveAuthorizationAsync(policy.Id,authorization.Id)">Archive</button></span>}</div><div class="insurance-policies__actions"><button type="button" class="btn btn-outline" @onclick="()=>BeginAuthorization(policy.Id)">Add authorization</button><button type="button" class="btn btn-outline" @onclick="()=>BeginEdit(policy)">Edit</button><button type="button" class="btn btn-outline" @onclick="()=>ArchiveAsync(policy.Id)">Archive</button></div></article>}</div>}
        @if(editing){<section class="insurance-policies__editor" aria-labelledby="policy-editor-title"><h3 id="policy-editor-title">@(editingId.HasValue?"Edit insurance policy":"Add insurance policy")</h3><div class="insurance-policies__grid"><label><span>Priority</span><select class="form-select" @bind="draft.CoveragePriority">@foreach(var value in Enum.GetValues<InsuranceCoveragePriority>()){<option value="@value">@value</option>}</select></label><label><span>Status</span><select class="form-select" @bind="draft.Status">@foreach(var value in Enum.GetValues<InsurancePolicyStatus>()){<option value="@value">@value</option>}</select></label><label><span>Payer type</span><select class="form-select" @bind="draft.PayerType">@foreach(var value in Enum.GetValues<InsurancePayerType>()){<option value="@value">@value</option>}</select></label><label><span>Plan year</span><select class="form-select" @bind="draft.PlanYearType">@foreach(var value in Enum.GetValues<InsurancePlanYearType>()){<option value="@value">@value</option>}</select></label><label><span>Carrier</span><input class="form-control" list="insurance-carrier-options" autocomplete="off" @bind="draft.CarrierDisplayName" /><datalist id="insurance-carrier-options">@foreach(var carrier in IntakeReferenceData.SearchInsuranceCarriers(draft.CarrierDisplayName)){<option value="@carrier.Label"></option>}</datalist></label><label><span>Member / policy number</span><input class="form-control" @bind="draft.MemberOrPolicyNumber" /></label><label><span>Group number</span><input class="form-control" @bind="draft.GroupNumber" /></label><label><span>Effective start</span><input class="form-control" type="date" @bind="draft.EffectiveStartDate" @bind:format="yyyy-MM-dd" /></label><label><span>Effective end</span><input class="form-control" type="date" @bind="draft.EffectiveEndDate" @bind:format="yyyy-MM-dd" /></label><label><span>Deductible</span><input class="form-control" type="number" min="0" step="0.01" @bind="draft.DeductibleAmount" /></label><label><span>Deductible met</span><input class="form-control" type="number" min="0" step="0.01" @bind="draft.DeductibleMet" /></label><label><span>Out-of-pocket maximum</span><input class="form-control" type="number" min="0" step="0.01" @bind="draft.OutOfPocketMaximum" /></label><label><span>Out-of-pocket met</span><input class="form-control" type="number" min="0" step="0.01" @bind="draft.OutOfPocketMet" /></label><label><span>Copay</span><input class="form-control" type="number" min="0" step="0.01" @bind="draft.CopayAmount" /></label><label><span>Coinsurance %</span><input class="form-control" type="number" min="0" max="100" step="0.01" @bind="draft.CoinsurancePercent" /></label><label><span>Adjuster name</span><input class="form-control" @bind="draft.AdjusterName" /></label><label><span>Adjuster phone</span><input class="form-control" type="tel" @bind="draft.AdjusterPhone" /></label><label><span>Adjuster email</span><input class="form-control" type="email" @bind="draft.AdjusterEmail" /></label><label><span>Adjuster fax</span><input class="form-control" type="tel" @bind="draft.AdjusterFax" /></label></div><div class="insurance-policies__actions"><button type="button" class="btn btn-primary" @onclick="SaveAsync" disabled="@isSaving">Save policy</button><button type="button" class="btn btn-outline" @onclick="CancelEdit">Cancel</button></div></section>}
        @if(editingAuthorization){<section class="insurance-policies__editor" aria-labelledby="authorization-editor-title"><h3 id="authorization-editor-title">Add authorization or referral</h3><div class="insurance-policies__grid"><label><span>Record type</span><select class="form-select" @bind="authorizationDraft.AuthorizationType">@foreach(var value in Enum.GetValues<InsuranceAuthorizationType>()){<option value="@value">@value</option>}</select></label><label><span>Status</span><select class="form-select" @bind="authorizationDraft.Status">@foreach(var value in Enum.GetValues<InsuranceAuthorizationStatus>()){<option value="@value">@value</option>}</select></label><label><span>Reference number</span><input class="form-control" @bind="authorizationDraft.ReferenceNumber" /></label><label><span>Received date</span><input class="form-control" type="date" @bind="authorizationDraft.ReceivedDate" @bind:format="yyyy-MM-dd" /></label><label><span>Start date</span><input class="form-control" type="date" @bind="authorizationDraft.StartDate" @bind:format="yyyy-MM-dd" /></label><label><span>End date</span><input class="form-control" type="date" @bind="authorizationDraft.EndDate" @bind:format="yyyy-MM-dd" /></label><label><span>Authorized units</span><input class="form-control" type="number" min="0" step="1" @bind="authorizationDraft.AuthorizedUnits" /></label><label><span>Used units</span><input class="form-control" type="number" min="0" step="1" @bind="authorizationDraft.UsedUnits" /></label><label><span>Limit period</span><select class="form-select" @bind="authorizationDraft.VisitLimitPeriod">@foreach(var value in Enum.GetValues<InsuranceVisitLimitPeriod>()){<option value="@value">@value</option>}</select></label><label><span>Reauthorization due</span><input class="form-control" type="date" @bind="authorizationDraft.ReauthorizationDueDate" @bind:format="yyyy-MM-dd" /></label><label><span>Alert threshold</span><input class="form-control" type="number" min="0" @bind="authorizationDraft.VisitAlertThreshold" /></label><label class="insurance-policies__full"><span>Notes</span><textarea class="form-control" @bind="authorizationDraft.Notes"></textarea></label></div><div class="insurance-policies__actions"><button type="button" class="btn btn-primary" @onclick="SaveAuthorizationAsync" disabled="@isSaving">Save authorization</button><button type="button" class="btn btn-outline" @onclick="()=>editingAuthorization=false">Cancel</button></div></section>}
    </div>
</PatientInfoSectionPanel>

@code{
    [Parameter,EditorRequired]public Guid PatientId{get;set;}private List<InsurancePolicyDto> policies=[];private UpsertInsurancePolicyRequest draft=new();private UpsertInsuranceAuthorizationRequest authorizationDraft=new();private Guid loadedPatientId;private Guid? editingId;private Guid? authorizationPolicyId;private Guid? authorizationId;private bool editing;private bool editingAuthorization;private bool isLoading=true;private bool isSaving;private string? error;
    protected override Task OnParametersSetAsync(){if(PatientId==Guid.Empty||PatientId==loadedPatientId)return Task.CompletedTask;loadedPatientId=PatientId;return LoadAsync();}private async Task LoadAsync(){if(PatientId==Guid.Empty)return;isLoading=true;try{policies=[..await InsurancePolicies.ListAsync(PatientId,default)];error=null;}catch(Exception ex){error=ex.Message;}finally{isLoading=false;}}
    private void BeginAdd(){editingId=null;draft=new(){CoveragePriority=NextPriority(),PayerType=InsurancePayerType.Commercial,Status=InsurancePolicyStatus.Active};editing=true;}
    private void BeginEdit(InsurancePolicyDto p){editingId=p.Id;draft=new(){CoveragePriority=p.CoveragePriority,CarrierKey=p.CarrierKey,CarrierDisplayName=p.CarrierDisplayName,PayerType=p.PayerType,MemberOrPolicyNumber=p.MemberOrPolicyNumber,GroupNumber=p.GroupNumber,EffectiveStartDate=p.EffectiveStartDate,EffectiveEndDate=p.EffectiveEndDate,PlanYearType=p.PlanYearType,DeductibleAmount=p.DeductibleAmount,DeductibleMet=p.DeductibleMet,OutOfPocketMaximum=p.OutOfPocketMaximum,OutOfPocketMet=p.OutOfPocketMet,CopayAmount=p.CopayAmount,CoinsurancePercent=p.CoinsurancePercent,AdjusterName=p.AdjusterName,AdjusterPhone=p.AdjusterPhone,AdjusterEmail=p.AdjusterEmail,AdjusterFax=p.AdjusterFax,Status=p.Status,ExpectedLastModifiedUtc=p.LastModifiedUtc};editing=true;}
    private async Task SaveAsync(){isSaving=true;try{var match=IntakeReferenceData.SearchInsuranceCarriers(draft.CarrierDisplayName,20).FirstOrDefault(item=>string.Equals(item.Label,draft.CarrierDisplayName,StringComparison.OrdinalIgnoreCase));draft.CarrierKey=match?.Id;await InsurancePolicies.UpsertPolicyAsync(PatientId,editingId,draft,default);ToastService.ShowSuccess("Insurance policy saved.");editing=false;await LoadAsync();}catch(Exception ex){error=ex.Message;}finally{isSaving=false;}}
    private void BeginAuthorization(Guid policyId){authorizationPolicyId=policyId;authorizationId=null;authorizationDraft=new(){AuthorizationType=InsuranceAuthorizationType.Authorization,Status=InsuranceAuthorizationStatus.Pending};editingAuthorization=true;}
    private void BeginAuthorizationEdit(Guid policyId,InsuranceAuthorizationDto value){authorizationPolicyId=policyId;authorizationId=value.Id;authorizationDraft=new(){AuthorizationType=value.AuthorizationType,ReferenceNumber=value.ReferenceNumber,Status=value.Status,ReceivedDate=value.ReceivedDate,StartDate=value.StartDate,EndDate=value.EndDate,AuthorizedUnits=value.AuthorizedUnits,UsedUnits=value.UsedUnits,VisitLimitPeriod=value.VisitLimitPeriod,ReauthorizationDueDate=value.ReauthorizationDueDate,VisitAlertThreshold=value.VisitAlertThreshold,Notes=value.Notes,ExpectedLastModifiedUtc=value.LastModifiedUtc};editingAuthorization=true;}
    private async Task SaveAuthorizationAsync(){if(!authorizationPolicyId.HasValue)return;isSaving=true;try{await InsurancePolicies.UpsertAuthorizationAsync(PatientId,authorizationPolicyId.Value,authorizationId,authorizationDraft,default);ToastService.ShowSuccess("Insurance authorization saved.");editingAuthorization=false;await LoadAsync();}catch(Exception ex){error=ex.Message;}finally{isSaving=false;}}
    private async Task ArchiveAuthorizationAsync(Guid policyId,Guid id){try{await InsurancePolicies.ArchiveAuthorizationAsync(PatientId,policyId,id,default);ToastService.ShowSuccess("Insurance authorization archived.");await LoadAsync();}catch(Exception ex){error=ex.Message;}}
    private async Task ArchiveAsync(Guid id){try{await InsurancePolicies.ArchivePolicyAsync(PatientId,id,default);ToastService.ShowSuccess("Insurance policy archived.");await LoadAsync();}catch(Exception ex){error=ex.Message;}}
    private void CancelEdit()=>editing=false;private InsuranceCoveragePriority NextPriority()=>!policies.Any(p=>p.CoveragePriority==InsuranceCoveragePriority.Primary)?InsuranceCoveragePriority.Primary:!policies.Any(p=>p.CoveragePriority==InsuranceCoveragePriority.Secondary)?InsuranceCoveragePriority.Secondary:InsuranceCoveragePriority.Tertiary;
}
