@using PTDoc.Application.Insurance
@using System.Text.Json
@inject IInsurancePolicyService InsurancePolicies
@inject PTDoc.Application.ReferenceData.IIntakeReferenceDataCatalogService IntakeReferenceData
@inject IToastService ToastService
@inject NavigationManager Navigation
@implements IDisposable

<PatientInfoSectionPanel Title="Insurance Policies">
    <div class="insurance-policies">
        <div class="insurance-policies__header">
            <p>Manage each policy with its visit limits, authorizations and referrals. Archived records remain available in history.</p>
            <button type="button" class="btn btn-outline" @onclick="BeginAdd" disabled="@(isSaving || editing)">Add policy</button>
        </div>
        @if (!editing && !string.IsNullOrWhiteSpace(error))
        {
            <div class="insurance-policies__state insurance-policies__state--error" role="alert">@error</div>
        }
        @if (isLoading) { <div class="insurance-policies__state" role="status">Loading insurance policies…</div> }
        else
        {
            <section aria-labelledby="current-insurance-policies-title">
                <h3 id="current-insurance-policies-title">Current policies</h3>
                @if (CurrentPolicies.Count == 0) { <p>No current insurance policies.</p> }
                @foreach (var policy in CurrentPolicies)
                {
                    <article class="insurance-policies__card">
                        <div>
                            <strong>@policy.CoveragePriority · @(policy.CarrierDisplayName ?? "Self Pay")</strong>
                            <span>@policy.PayerType · @(policy.MemberOrPolicyNumber ?? "No member ID")</span>
                            <span>@FormatLimit(policy) · @policy.PlanYearType</span>
                            @foreach (var authorization in policy.Authorizations)
                            { <span>@authorization.AuthorizationType · @authorization.Status · @(authorization.ReferenceNumber ?? "No reference")</span> }
                        </div>
                        <div class="insurance-policies__actions">
                            <button type="button" class="btn btn-outline" @onclick="() => BeginEdit(policy)" disabled="@(editing || isSaving)">Edit policy and referrals</button>
                            <button type="button" class="btn btn-outline" @onclick="() => ArchiveAsync(policy.Id)" disabled="@(editing || isSaving)">Archive policy</button>
                        </div>
                    </article>
                }
            </section>
            @if (HistoricalPolicies.Count > 0)
            {
                <section aria-labelledby="insurance-policy-history-title">
                    <h3 id="insurance-policy-history-title">Policy history</h3>
                    @foreach (var policy in HistoricalPolicies)
                    {
                        <article class="insurance-policies__card insurance-policies__card--history">
                            <div>
                                <strong>@policy.CoveragePriority · @(policy.CarrierDisplayName ?? "Self Pay")</strong>
                                <span>@policy.Status · @FormatCoverageDates(policy)</span>
                                <span>@FormatLimit(policy) · @policy.PlanYearType</span>
                                @foreach (var authorization in policy.Authorizations)
                                { <span>@authorization.AuthorizationType · @authorization.Status · @(authorization.ReferenceNumber ?? "No reference") · @authorization.StartDate?.ToString("MMM d, yyyy") – @authorization.EndDate?.ToString("MMM d, yyyy")</span> }
                            </div>
                            @if (!policy.IsArchived)
                            { <button type="button" class="btn btn-outline" @onclick="() => BeginEdit(policy)" disabled="@(editing || isSaving)">Edit historical policy</button> }
                        </article>
                    }
                </section>
            }
        }
        @if (editing)
        {
            <section class="insurance-policies__editor" aria-labelledby="policy-editor-title">
                <h3 id="policy-editor-title">@(editingId.HasValue ? "Edit insurance policy" : "Add insurance policy")</h3>
                <fieldset disabled="@isSaving" class="insurance-policies__fieldset">
                    <legend>Policy and visit limits</legend>
                    <div class="insurance-policies__grid">
                        <label><span>Priority</span><select class="form-select" @bind="draft.CoveragePriority">@foreach (var value in Enum.GetValues<InsuranceCoveragePriority>()) { <option value="@value">@value</option> }</select></label>
                        <label><span>Policy status</span><select class="form-select" @bind="draft.Status">@foreach (var value in Enum.GetValues<InsurancePolicyStatus>()) { <option value="@value">@value</option> }</select></label>
                        <label><span>Payer type</span><select class="form-select" @bind="draft.PayerType">@foreach (var value in Enum.GetValues<InsurancePayerType>()) { <option value="@value">@value</option> }</select></label>
                        <label><span>Plan year</span><select class="form-select" @bind="draft.PlanYearType">@foreach (var value in Enum.GetValues<InsurancePlanYearType>()) { <option value="@value">@value</option> }</select></label>
                        <label><span>Visit limit type</span><select class="form-select" @bind="visitLimitType"><option value="">Unknown / verify</option><option value="visits">Visits</option><option value="units">Units</option><option value="combined">Combined visits / units</option><option value="none">No limit</option><option value="unknown">Unknown</option></select></label>
                        <label><span>Total visit limit</span><input class="form-control" type="number" min="0" step="0.01" @bind="totalVisitLimit" /></label>
                        <label><span>Carrier</span><input class="form-control" type="text" list="insurance-carrier-options" autocomplete="off" @bind="draft.CarrierDisplayName" @bind:event="oninput" /></label>
                        <datalist id="insurance-carrier-options">@foreach (var carrier in IntakeReferenceData.SearchInsuranceCarriers(draft.CarrierDisplayName)) { <option value="@carrier.Label"></option> }</datalist>
                        <label><span>Member / policy number</span><input class="form-control" type="text"  @bind="draft.MemberOrPolicyNumber" @bind:event="oninput" /></label>
                        <label><span>Group number</span><input class="form-control" type="text"  @bind="draft.GroupNumber" @bind:event="oninput" /></label>
                        <label><span>Effective start</span><input class="form-control" type="date"  @bind="draft.EffectiveStartDate" @bind:format="yyyy-MM-dd" /></label>
                        <label><span>Effective end</span><input class="form-control" type="date"  @bind="draft.EffectiveEndDate" @bind:format="yyyy-MM-dd" /></label>
                        <label><span>Deductible</span><input class="form-control" type="number" min="0" step="0.01" @bind="draft.DeductibleAmount" /></label>
                        <label><span>Deductible met</span><input class="form-control" type="number" min="0" step="0.01" @bind="draft.DeductibleMet" /></label>
                        <label><span>Out-of-pocket maximum</span><input class="form-control" type="number" min="0" step="0.01" @bind="draft.OutOfPocketMaximum" /></label>
                        <label><span>Out-of-pocket met</span><input class="form-control" type="number" min="0" step="0.01" @bind="draft.OutOfPocketMet" /></label>
                        <label><span>Copay</span><input class="form-control" type="number" min="0" step="0.01" @bind="draft.CopayAmount" /></label>
                        <label><span>Coinsurance %</span><input class="form-control" type="number" min="0" step="0.01" @bind="draft.CoinsurancePercent" /></label>
                        <label><span>Adjuster name</span><input class="form-control" type="text"  @bind="draft.AdjusterName" @bind:event="oninput" /></label>
                        <label><span>Adjuster phone</span><input class="form-control" type="tel"  @bind="draft.AdjusterPhone" @bind:event="oninput" /></label>
                        <label><span>Adjuster email</span><input class="form-control" type="email"  @bind="draft.AdjusterEmail" @bind:event="oninput" /></label>
                        <label><span>Adjuster fax</span><input class="form-control" type="tel"  @bind="draft.AdjusterFax" @bind:event="oninput" /></label>
                    </div>
                </fieldset>
                <fieldset disabled="@isSaving" class="insurance-policies__fieldset">
                    <legend>Authorizations / PCP referrals and history</legend>
                    <p>Each entry keeps its own dates, status and utilization. Only edited entries are saved.</p>
                    <button type="button" class="btn btn-outline" @onclick="AddAuthorization">Add authorization or referral</button>
                    @for (var index = 0; index < authorizationEdits.Count; index++)
                    {
                        var entry = authorizationEdits[index];
                        <section class="insurance-policies__authorization" @key="entry.Key" aria-label="@($"Authorization or referral {index + 1}")">
                            <h4>Entry @(index + 1)</h4>
                            <div class="insurance-policies__grid">
                        <label><span>Record type</span><select class="form-select" @bind="entry.Edit.Values.AuthorizationType">@foreach (var value in Enum.GetValues<InsuranceAuthorizationType>()) { <option value="@value">@value</option> }</select></label>
                        <label><span>Record status</span><select class="form-select" @bind="entry.Edit.Values.Status">@foreach (var value in Enum.GetValues<InsuranceAuthorizationStatus>()) { <option value="@value">@value</option> }</select></label>
                        <label><span>Reference number</span><input class="form-control" type="text"  @bind="entry.Edit.Values.ReferenceNumber" @bind:event="oninput" /></label>
                        <label><span>Received date</span><input class="form-control" type="date"  @bind="entry.Edit.Values.ReceivedDate" @bind:format="yyyy-MM-dd" /></label>
                        <label><span>Start date</span><input class="form-control" type="date"  @bind="entry.Edit.Values.StartDate" @bind:format="yyyy-MM-dd" /></label>
                        <label><span>End date</span><input class="form-control" type="date"  @bind="entry.Edit.Values.EndDate" @bind:format="yyyy-MM-dd" /></label>
                        <label><span>Authorized units</span><input class="form-control" type="number" min="0" step="0.01" @bind="entry.Edit.Values.AuthorizedUnits" /></label>
                        <label><span>Used units</span><input class="form-control" type="number" min="0" step="0.01" @bind="entry.Edit.Values.UsedUnits" /></label>
                        <label><span>Authorization limit period</span><select class="form-select" @bind="entry.Edit.Values.VisitLimitPeriod">@foreach (var value in Enum.GetValues<InsuranceVisitLimitPeriod>()) { <option value="@value">@value</option> }</select></label>
                        <label><span>Reauthorization due</span><input class="form-control" type="date"  @bind="entry.Edit.Values.ReauthorizationDueDate" @bind:format="yyyy-MM-dd" /></label>
                        <label><span>Alert threshold</span><input class="form-control" type="number" min="0" step="1" @bind="entry.Edit.Values.VisitAlertThreshold" /></label>
                                <label class="insurance-policies__full"><span>Notes</span><textarea class="form-control" maxlength="2000" @bind="entry.Edit.Values.Notes" @bind:event="oninput"></textarea></label>
                            </div>
                            @if (!entry.Edit.Id.HasValue) { <button type="button" class="btn btn-outline" @onclick="() => authorizationEdits.Remove(entry)">Remove unsaved entry</button> }
                        </section>
                    }
                </fieldset>
                @if (!string.IsNullOrWhiteSpace(error))
                {
                    <div class="insurance-policies__state insurance-policies__state--error" role="alert">@error</div>
                }
                <div class="insurance-policies__actions">
                    <button type="button" class="btn btn-primary" @onclick="SaveAsync" disabled="@isSaving">@(isSaving ? "Saving…" : "Save policy and referrals")</button>
                    <button type="button" class="btn btn-outline" @onclick="CancelEdit" disabled="@isSaving">Cancel</button>
                </div>
            </section>
        }
    </div>
</PatientInfoSectionPanel>

@code {
    [Parameter, EditorRequired] public Guid PatientId { get; set; }
    private IDisposable? navigationGuard;
    protected override void OnInitialized() => navigationGuard = Navigation.RegisterLocationChangingHandler(context =>
    {
        if (editing)
        {
            context.PreventNavigation();
            ToastService.ShowWarning("Save or cancel the policy editor before leaving.");
        }
        return ValueTask.CompletedTask;
    });
    public void Dispose() => navigationGuard?.Dispose();
    private List<InsurancePolicyDto> policies = [];
    private UpsertInsurancePolicyRequest draft = new();
    private List<AuthorizationEditor> authorizationEdits = [];
    private decimal? totalVisitLimit;
    private string? visitLimitType;
    private Guid loadedPatientId;
    private Guid? editingId;
    private bool editing;
    private bool isLoading = true;
    private bool isSaving;
    private string? error;
    private IReadOnlyList<InsurancePolicyDto> CurrentPolicies => policies.Where(p => !p.IsArchived && p.Status == InsurancePolicyStatus.Active).ToList();
    private IReadOnlyList<InsurancePolicyDto> HistoricalPolicies => policies.Where(p => p.IsArchived || p.Status != InsurancePolicyStatus.Active).OrderByDescending(p => p.EffectiveEndDate ?? p.LastModifiedUtc).ToList();

    protected override Task OnParametersSetAsync()
    {
        if (PatientId == Guid.Empty || PatientId == loadedPatientId) return Task.CompletedTask;
        loadedPatientId = PatientId;
        CancelEdit();
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        try { policies = [.. await InsurancePolicies.ListAsync(PatientId, true, default)]; error = null; }
        catch (Exception ex) { error = ex.Message; }
        finally { isLoading = false; }
    }

    private void BeginAdd()
    {
        editingId = null;
        draft = new() { CoveragePriority = NextPriority(), PayerType = InsurancePayerType.Commercial, Status = InsurancePolicyStatus.Active };
        totalVisitLimit = null;
        visitLimitType = null;
        authorizationEdits = [];
        editing = true;
        error = null;
    }

    private void BeginEdit(InsurancePolicyDto policy)
    {
        editingId = policy.Id;
        // Copy the complete policy so editing one field cannot erase unrelated fields.
        draft = JsonSerializer.Deserialize<UpsertInsurancePolicyRequest>(JsonSerializer.Serialize(policy))!;
        draft.ExpectedLastModifiedUtc = policy.LastModifiedUtc;
        totalVisitLimit = policy.TotalVisitLimit;
        visitLimitType = policy.VisitLimitType;
        authorizationEdits = policy.Authorizations.Select(value =>
        {
            var values = JsonSerializer.Deserialize<UpsertInsuranceAuthorizationRequest>(JsonSerializer.Serialize(value))!;
            values.ExpectedLastModifiedUtc = value.LastModifiedUtc;
            return new AuthorizationEditor(new() { Id = value.Id, Values = values });
        }).ToList();
        editing = true;
        error = null;
    }

    private void AddAuthorization() => authorizationEdits.Add(new(new()
    {
        Values = new() { AuthorizationType = InsuranceAuthorizationType.Authorization, Status = InsuranceAuthorizationStatus.Pending }
    }));

    private async Task SaveAsync()
    {
        if (isSaving) return;
        isSaving = true;
        error = null;
        try
        {
            var match = IntakeReferenceData.SearchInsuranceCarriers(draft.CarrierDisplayName, 20)
                .FirstOrDefault(item => string.Equals(item.Label, draft.CarrierDisplayName, StringComparison.OrdinalIgnoreCase));
            draft.CarrierKey = match?.Id;
            if (string.IsNullOrWhiteSpace(draft.AdjusterEmail)) draft.AdjusterEmail = null;
            var saved = await InsurancePolicies.SaveWorkflowAsync(PatientId, editingId, new()
            {
                Policy = draft, TotalVisitLimit = totalVisitLimit, VisitLimitType = visitLimitType,
                Authorizations = authorizationEdits.Where(entry => entry.IsChanged).Select(entry => entry.Edit).ToList()
            }, default);
            // Update from the successful response; a subsequent refresh failure must not
            // misrepresent an already committed save or encourage duplicate insertion.
            policies.RemoveAll(policy => policy.Id == saved.Id);
            policies.Add(saved);
            editing = false;
            ToastService.ShowSuccess("Policy and referral changes saved.");
        }
        catch (Exception ex) { error = ex.Message; }
        finally { isSaving = false; }
    }

    private async Task ArchiveAsync(Guid id)
    {
        if (isSaving) return;
        isSaving = true;
        try { await InsurancePolicies.ArchivePolicyAsync(PatientId, id, default); await LoadAsync(); }
        catch (Exception ex) { error = ex.Message; }
        finally { isSaving = false; }
    }

    private void CancelEdit() { editing = false; error = null; authorizationEdits = []; }
    private InsuranceCoveragePriority NextPriority() => !CurrentPolicies.Any(p => p.CoveragePriority == InsuranceCoveragePriority.Primary)
        ? InsuranceCoveragePriority.Primary : !CurrentPolicies.Any(p => p.CoveragePriority == InsuranceCoveragePriority.Secondary)
            ? InsuranceCoveragePriority.Secondary : InsuranceCoveragePriority.Tertiary;
    private static string FormatLimit(InsurancePolicyDto p) => p.VisitLimitType == "none" ? "No visit limit" : p.TotalVisitLimit.HasValue ? $"{p.TotalVisitLimit} {p.VisitLimitType ?? "(limit type unverified)"}" : "Visit limit unverified";
    private static string FormatCoverageDates(InsurancePolicyDto p) => $"{p.EffectiveStartDate?.ToString("MMM d, yyyy") ?? "Unknown start"} – {p.EffectiveEndDate?.ToString("MMM d, yyyy") ?? "No end date"}";
    private sealed class AuthorizationEditor(InsuranceAuthorizationEdit edit)
    {
        public Guid Key { get; } = edit.Id ?? Guid.NewGuid();
        public InsuranceAuthorizationEdit Edit { get; } = edit;
        private readonly string original = JsonSerializer.Serialize(edit.Values);
        public bool IsChanged => !Edit.Id.HasValue || original != JsonSerializer.Serialize(Edit.Values);
    }
}
