@using PTDoc.Application.Providers
@inject IProviderDirectoryService Providers
@inject IToastService ToastService

<PatientInfoSectionPanel Title="Care Team Directory">
    <div class="patient-providers">
        <p>Approved clinic providers are reusable across referral workflows. New entries remain patient-specific while awaiting approval.</p>

        @if (isLoading)
        {
            <div class="patient-providers__state" role="status">Loading care team…</div>
        }
        else if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="patient-providers__state patient-providers__state--error" role="alert">@error</div>
        }
        else
        {
            <div class="patient-providers__list">
                @foreach (var relationship in relationships)
                {
                    <article>
                        <div>
                            <strong>@relationship.Provider.DisplayName</strong>
                            <span>@relationship.Role · @relationship.Provider.Status</span>
                        </div>
                        <button type="button" class="btn btn-outline" @onclick="() => RemoveAsync(relationship.Id)">Remove</button>
                    </article>
                }
            </div>
        }

        <div class="patient-providers__search">
            <label>
                <span>Find approved provider</span>
                <input class="form-control" @bind="query" @bind:event="oninput" placeholder="Search name, organization, or NPI" />
            </label>
            <button type="button" class="btn btn-outline" @onclick="SearchAsync">Search</button>
        </div>

        @if (matches.Count > 0)
        {
            <div class="patient-providers__results">
                @foreach (var provider in matches)
                {
                    <button type="button" @onclick="() => LinkAsync(provider)">
                        <span>
                            <strong>@provider.DisplayName</strong>
                            <small>@provider.Specialty · @provider.OrganizationName</small>
                        </span>
                        <span>Add</span>
                    </button>
                }
            </div>
        }

        <details>
            <summary>Provider not found?</summary>
            <div class="patient-providers__candidate">
                <label>
                    <span>First name</span>
                    <input class="form-control" @bind="candidate.FirstName" />
                </label>
                <label>
                    <span>Last name</span>
                    <input class="form-control" @bind="candidate.LastName" />
                </label>
                <label>
                    <span>NPI</span>
                    <input class="form-control" maxlength="10" inputmode="numeric" @bind="candidate.Npi" />
                </label>
                <label>
                    <span>Role</span>
                    <select class="form-select" @bind="candidateRole">
                        <option value="@PatientProviderRole.PrimaryCare">Primary Care</option>
                        <option value="@PatientProviderRole.Referring">Referring</option>
                        <option value="@PatientProviderRole.Other">Other</option>
                    </select>
                </label>
                <button type="button" class="btn btn-primary" @onclick="SubmitCandidateAsync">Submit for approval</button>
            </div>
        </details>
    </div>
</PatientInfoSectionPanel>

@code {
    [Parameter, EditorRequired]
    public Guid PatientId { get; set; }

    private List<PatientProviderRelationshipDto> relationships = [];
    private List<ProviderDirectoryEntryDto> matches = [];
    private SubmitProviderCandidateRequest candidate = new();
    private PatientProviderRole candidateRole = PatientProviderRole.Referring;
    private Guid loadedPatientId;
    private string query = string.Empty;
    private bool isLoading = true;
    private string? error;

    protected override Task OnParametersSetAsync()
    {
        if (PatientId == Guid.Empty || PatientId == loadedPatientId)
        {
            return Task.CompletedTask;
        }

        loadedPatientId = PatientId;
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (PatientId == Guid.Empty)
        {
            return;
        }

        isLoading = true;

        try
        {
            relationships = [.. await Providers.ListPatientRelationshipsAsync(PatientId, default)];
            error = null;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SearchAsync()
    {
        try
        {
            matches = [.. await Providers.SearchAsync(query, ProviderDirectoryStatus.Active, 20, default)];
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private async Task LinkAsync(ProviderDirectoryEntryDto provider)
    {
        try
        {
            await Providers.UpsertPatientRelationshipAsync(
                PatientId,
                null,
                new()
                {
                    ProviderId = provider.Id,
                    Role = candidateRole,
                    IsPrimary = true
                },
                default);

            matches = [];
            ToastService.ShowSuccess("Provider added to the care team.");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private async Task SubmitCandidateAsync()
    {
        candidate.PatientId = PatientId;
        candidate.PatientRole = candidateRole;

        try
        {
            await Providers.SubmitAsync(candidate, default);
            candidate = new();
            ToastService.ShowSuccess("Provider submitted for approval and linked to this patient.");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private async Task RemoveAsync(Guid id)
    {
        try
        {
            await Providers.ArchivePatientRelationshipAsync(PatientId, id, default);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }
}
