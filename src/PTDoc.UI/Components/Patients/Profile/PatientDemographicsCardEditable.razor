@* Patient Demographics Card - Editable patient information *@
@using PTDoc.Application.Services
@using PTDoc.Application.DTOs
@using System.Net
@using System.ComponentModel.DataAnnotations
@inject IPatientService PatientService
@inject IToastService ToastService

<div class="patient-demographics-card" data-testid="patient-demographics-card">
    <div class="patient-demographics-card-header">
        <h2 class="patient-demographics-card-title">Patient Information</h2>
        <button type="button" 
                class="patient-demographics-card-edit-btn @(isEditing ? "editing" : "")" 
                @onclick="ToggleEdit"
                disabled="@isSaving"
                aria-label="@(isEditing ? "Cancel editing" : "Edit patient information")">
            @if (isEditing)
            {
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 4L4 12M4 4L12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
                <span>Cancel</span>
            }
            else
            {
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M11.3333 2.00004C11.5084 1.82494 11.716 1.68605 11.9447 1.59129C12.1735 1.49653 12.419 1.44775 12.6667 1.44775C12.9143 1.44775 13.1598 1.49653 13.3886 1.59129C13.6174 1.68605 13.8249 1.82494 14 2.00004C14.1751 2.17513 14.314 2.38268 14.4088 2.61149C14.5035 2.8403 14.5523 3.08579 14.5523 3.33337C14.5523 3.58096 14.5035 3.82645 14.4088 4.05526C14.314 4.28407 14.1751 4.49162 14 4.66671L5.00001 13.6667L1.33334 14.6667L2.33334 11L11.3333 2.00004Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>Edit</span>
            }
        </button>
    </div>

    <div class="patient-demographics-card-body">
        @if (!isEditing)
        {
            <!-- View Mode -->
            <div class="patient-demographics-fields">
                <div class="patient-demographics-field">
                    <label class="patient-demographics-label">Full Name</label>
                    <div class="patient-demographics-value-display">@Patient.DisplayName</div>
                </div>
                <div class="patient-demographics-field">
                    <label class="patient-demographics-label">Date of Birth</label>
                    <div class="patient-demographics-value-display">@Patient.DateOfBirth</div>
                </div>
            </div>
            <div class="patient-demographics-fields">
                <div class="patient-demographics-field patient-demographics-field-full">
                    <label class="patient-demographics-label">Email Address</label>
                    <div class="patient-demographics-value-display">@Patient.Email</div>
                </div>
            </div>
            <div class="patient-demographics-fields">
                <div class="patient-demographics-field">
                    <span class="patient-demographics-label">Phone Number</span>
                    <div class="patient-demographics-value-display">@Patient.PhoneNumber</div>
                </div>
                <div class="patient-demographics-field">
                    <span class="patient-demographics-label">Address Line 1</span>
                    <div class="patient-demographics-value-display">@Patient.AddressLine1</div>
                </div>
                <div class="patient-demographics-field">
                    <span class="patient-demographics-label">Address Line 2</span>
                    <div class="patient-demographics-value-display">@Patient.AddressLine2</div>
                </div>
                <div class="patient-demographics-field">
                    <span class="patient-demographics-label">City</span>
                    <div class="patient-demographics-value-display">@Patient.City</div>
                </div>
                <div class="patient-demographics-field">
                    <span class="patient-demographics-label">State / Province</span>
                    <div class="patient-demographics-value-display">@Patient.State</div>
                </div>
                <div class="patient-demographics-field">
                    <span class="patient-demographics-label">Postal Code</span>
                    <div class="patient-demographics-value-display">@Patient.ZipCode</div>
                </div>
                <div class="patient-demographics-field">
                    <span class="patient-demographics-label">Emergency Contact Name</span>
                    <div class="patient-demographics-value-display">@Patient.EmergencyContactName</div>
                </div>
                <div class="patient-demographics-field">
                    <span class="patient-demographics-label">Emergency Contact Phone</span>
                    <div class="patient-demographics-value-display">@Patient.EmergencyContactPhone</div>
                </div>
            </div>
        }
        else
        {
            <!-- Edit Mode -->
            <div class="patient-demographics-fields">
                <div class="patient-demographics-field">
                    <label class="patient-demographics-label" for="edit-name">Full Name</label>
                    <input id="edit-name" type="text" class="patient-demographics-input" @bind="editName" disabled="@isSaving" />
                </div>
                <div class="patient-demographics-field">
                    <label class="patient-demographics-label" for="edit-dob">Date of Birth</label>
                    <input id="edit-dob" type="text" class="patient-demographics-input" @bind="editDateOfBirth" disabled="@isSaving" />
                </div>
            </div>
            <div class="patient-demographics-fields">
                <div class="patient-demographics-field patient-demographics-field-full">
                    <label class="patient-demographics-label" for="edit-email">Email Address</label>
                    <input id="edit-email" type="email" class="patient-demographics-input" @bind="editEmail" maxlength="255" disabled="@isSaving" />
                </div>
            </div>

            <div class="patient-demographics-fields">
                <div class="patient-demographics-field">
                    <label class="patient-demographics-label" for="edit-phone">Phone Number</label>
                    <input id="edit-phone" type="tel" maxlength="20" class="patient-demographics-input" @bind="editPhoneNumber" disabled="@isSaving" />
                </div>
                <div class="patient-demographics-field">
                    <label class="patient-demographics-label" for="edit-address1">Address Line 1</label>
                    <input id="edit-address1" type="text" maxlength="200" class="patient-demographics-input" @bind="editAddressLine1" disabled="@isSaving" />
                </div>
                <div class="patient-demographics-field">
                    <label class="patient-demographics-label" for="edit-address2">Address Line 2</label>
                    <input id="edit-address2" type="text" maxlength="200" class="patient-demographics-input" @bind="editAddressLine2" disabled="@isSaving" />
                </div>
                <div class="patient-demographics-field">
                    <label class="patient-demographics-label" for="edit-city">City</label>
                    <input id="edit-city" type="text" maxlength="100" class="patient-demographics-input" @bind="editCity" disabled="@isSaving" />
                </div>
                <div class="patient-demographics-field">
                    <label class="patient-demographics-label" for="edit-state">State / Province</label>
                    <input id="edit-state" type="text" maxlength="100" class="patient-demographics-input" @bind="editState" disabled="@isSaving" />
                </div>
                <div class="patient-demographics-field">
                    <label class="patient-demographics-label" for="edit-postal">Postal Code</label>
                    <input id="edit-postal" type="text" maxlength="20" class="patient-demographics-input" @bind="editZipCode" disabled="@isSaving" />
                </div>
                <div class="patient-demographics-field">
                    <label class="patient-demographics-label" for="edit-emergency-name">Emergency Contact Name</label>
                    <input id="edit-emergency-name" type="text" maxlength="200" class="patient-demographics-input" @bind="editEmergencyContactName" disabled="@isSaving" />
                </div>
                <div class="patient-demographics-field">
                    <label class="patient-demographics-label" for="edit-emergency-phone">Emergency Contact Phone</label>
                    <input id="edit-emergency-phone" type="tel" maxlength="20" class="patient-demographics-input" @bind="editEmergencyContactPhone" disabled="@isSaving" />
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(saveError))
            {
                <p role="alert">@saveError</p>
            }

            <div class="patient-demographics-edit-actions">
                <button type="button" class="patient-demographics-save-btn" @onclick="HandleSave" disabled="@isSaving">
                    @(isSaving ? "Saving..." : "Save Changes")
                </button>
            </div>
        }

        <div class="patient-demographics-divider"></div>

        <div class="patient-demographics-section">
            <label class="patient-demographics-label">Flags & Comorbidities</label>
            <div class="patient-demographics-badges">
                @foreach (var flag in Patient.FlagsAndComorbidities)
                {
                    <span class="patient-demographics-badge">@flag</span>
                }
            </div>
        </div>

        <div class="patient-demographics-divider"></div>

        <a class="patient-demographics-insurance-btn"
           href="@InsuranceAuthorizationHref"
           aria-label="Open Insurance and Authorization page">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M10 6H14L8 14V8H4L10 2V6Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>Insurance & Authorization</span>
        </a>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public PatientProfileVm Patient { get; set; } = null!;
    [Parameter] public EventCallback OnPatientUpdated { get; set; }

    private bool isEditing = false;
    private bool isSaving = false;
    private string editName = string.Empty;
    private string editDateOfBirth = string.Empty;
    private string editEmail = string.Empty;
    private string? saveError;
    private DateTime? editVersion;
    private string editPhoneNumber = string.Empty;
    private string editAddressLine1 = string.Empty;
    private string editAddressLine2 = string.Empty;
    private string editCity = string.Empty;
    private string editState = string.Empty;
    private string editZipCode = string.Empty;
    private string editEmergencyContactName = string.Empty;
    private string editEmergencyContactPhone = string.Empty;


    private void ToggleEdit()
    {
        if (isSaving) return;
        saveError = null;
        if (isEditing)
        {
            // Cancel - reset values
            isEditing = false;
        }
        else
        {
            // Start editing - load current values
            editName = Patient.DisplayName;
            editDateOfBirth = Patient.DateOfBirth ?? string.Empty;
            editEmail = Patient.Email ?? string.Empty;
            editVersion = Patient.LastModifiedUtc;
            editPhoneNumber = Patient.PhoneNumber ?? string.Empty;
            editAddressLine1 = Patient.AddressLine1 ?? string.Empty;
            editAddressLine2 = Patient.AddressLine2 ?? string.Empty;
            editCity = Patient.City ?? string.Empty;
            editState = Patient.State ?? string.Empty;
            editZipCode = Patient.ZipCode ?? string.Empty;
            editEmergencyContactName = Patient.EmergencyContactName ?? string.Empty;
            editEmergencyContactPhone = Patient.EmergencyContactPhone ?? string.Empty;

            isEditing = true;
        }
    }

    private async Task HandleSave()
    {
        await SaveAsync();
    }

    private async Task SaveAsync()
    {
        if (!Guid.TryParse(Patient.Id, out var patientId))
        {
            ToastService.ShowError("Invalid patient ID.");
            return;
        }

        if (isSaving) return;
        saveError = null;
        if (string.IsNullOrWhiteSpace(editName))
        {
            saveError = "Patient name is required.";
            return;
        }

        var nameParts = editName.Trim().Split(' ', 2, StringSplitOptions.RemoveEmptyEntries);
        if (nameParts.Length < 2 || string.IsNullOrWhiteSpace(nameParts[1]))
        {
            saveError = "First and last name are required.";
            return;
        }
        if (!DateTime.TryParse(editDateOfBirth, out var dob) || dob == default)
        {
            saveError = "Enter a valid date of birth.";
            return;
        }
        if (!string.IsNullOrWhiteSpace(editEmail) && !new EmailAddressAttribute().IsValid(editEmail.Trim()))
        {
            saveError = "Enter a valid email address.";
            return;
        }

        isSaving = true;
        try
        {
            var firstName = nameParts[0];
            var lastName = nameParts.Length > 1 ? nameParts[1] : string.Empty;

            var request = new UpdatePatientRequest
            {
                FirstName = firstName,
                LastName = lastName,
                DateOfBirth = dob,
                ExpectedLastModifiedUtc = editVersion,
                Email = editEmail.Trim(),
                Phone = editPhoneNumber.Trim(),
                AddressLine1 = editAddressLine1.Trim(),
                AddressLine2 = editAddressLine2.Trim(),
                City = editCity.Trim(),
                State = editState.Trim(),
                ZipCode = editZipCode.Trim(),
                EmergencyContactName = editEmergencyContactName.Trim(),
                EmergencyContactPhone = editEmergencyContactPhone.Trim()
            };

            var updated = await PatientService.UpdateAsync(patientId, request);
            if (updated is not null)
            {
                isEditing = false;
                ToastService.ShowSuccess("Patient information saved.");
                if (OnPatientUpdated.HasDelegate)
                {
                    await OnPatientUpdated.InvokeAsync();
                }
            }
            else
            {
                saveError = "Patient not found. Your edits are retained; refresh to check the record.";
            }
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Conflict)
        {
            saveError = "Patient information changed since you opened it. Your edits are retained. Copy them before refreshing and reviewing the latest record.";
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.BadRequest)
        {
            saveError = "Review the entered patient details. Your edits are retained.";
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Forbidden)
        {
            saveError = "You do not have permission to update this patient. Your edits are retained.";
        }
        catch (Exception)
        {
            saveError = "Failed to save patient information. Your edits are retained; please try again.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private string InsuranceAuthorizationHref
    {
        get
        {
            if (string.IsNullOrWhiteSpace(Patient.Id))
            {
                return "/patient/info";
            }

            return $"/patient/{Uri.EscapeDataString(Patient.Id)}/info";
        }
    }

}
