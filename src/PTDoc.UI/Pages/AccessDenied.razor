@page "/denied"
@layout PTDoc.UI.Components.Layout.AuthLayout

<PageTitle>Access Denied - PTDoc</PageTitle>

<div class="access-denied">
    <div class="access-denied__card">
        <h1 class="access-denied__title">Access Denied</h1>
        <p class="access-denied__message">
            You do not have permission to view this page.
            Please contact your administrator if you believe this is an error.
        </p>
        <AuthorizeView Policy="@AuthorizationPolicies.PatientHepAccess">
            <a href="/my-hep" class="access-denied__home-link">My Home Exercise Program</a>
        </AuthorizeView>
        <AuthorizeView Policy="@AuthorizationPolicies.ClinicalStaff">
            <a href="/" class="access-denied__home-link">Return to Dashboard</a>
        </AuthorizeView>
        <a href="/logout" class="access-denied__home-link">Sign out</a>
    </div>
</div>
