@namespace PTDoc.Maui.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using PTDoc.Application.Services
@using PTDoc.UI.Components.Auth
@using PTDoc.UI.Components.Layout
@using PTDoc.UI.Pages
@using PTDoc.UI.Pages.Intake
@using PTDoc.UI.Services
@inject NavigationManager Navigation

<Router AppAssembly="@typeof(MauiRoutes).Assembly" AdditionalAssemblies="@SharedPageAssemblies">
    <Found Context="routeData">
        @if (routeData.PageType == typeof(KioskCheckIn))
        {
            <RouteView RouteData="@routeData" />
        }
        else
        {
            <CascadingAuthenticationState>
                @if (routeData.PageType == typeof(IntakeWizardPage))
                {
                    <AuthorizeView>
                        <Authorized Context="auth">
                            @if (auth.User.IsInRole(Roles.Patient) || StandaloneIntakeLink.IsPatientMode(new Uri(Navigation.Uri), out _))
                            {
                                <MauiStandaloneIntakeRoute RouteData="@routeData" />
                            }
                            else
                            {
                                @AuthorizedRoute(routeData)
                            }
                        </Authorized>
                        <NotAuthorized><MauiStandaloneIntakeRoute RouteData="@routeData" /></NotAuthorized>
                        <Authorizing><p>Loading...</p></Authorizing>
                    </AuthorizeView>
                }
                else
                {
                    @AuthorizedRoute(routeData)
                }
            </CascadingAuthenticationState>
        }
    </Found>

    <NotFound>
        <CascadingAuthenticationState>
            <LayoutView Layout="@typeof(MainLayout)">
                <p>Sorry, there's nothing at this address.</p>
            </LayoutView>
        </CascadingAuthenticationState>
    </NotFound>
</Router>

@code {
    private static readonly System.Reflection.Assembly[] SharedPageAssemblies = [typeof(Dashboard).Assembly];

    private static RenderFragment AuthorizedRoute(RouteData routeData) =>
        @<AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
            <Authorizing><p>Loading...</p></Authorizing>
            <NotAuthorized Context="auth">
                @if (auth.User.Identity?.IsAuthenticated == true)
                {
                    <RedirectToAccessDenied />
                }
                else
                {
                    <RedirectToLogin />
                }
            </NotAuthorized>
        </AuthorizeRouteView>;
}
