@page "/logout"
@layout AuthLayout
@rendermode InteractiveServer
@using PTDoc.UI.Services
@inject IIntakeSessionStore IntakeSessions
@inject IntakeInviteRenewal Renewal
@inject NavigationManager Navigation
@inject ILogger<WebLogout> Logger

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <h3>Logging out...</h3>
            <p>Please wait while we securely end your session.</p>
        </div>
    </div>
</div>

@code {
    protected override Task OnAfterRenderAsync(bool firstRender) =>
        firstRender ? SignOutAsync() : Task.CompletedTask;

    private async Task SignOutAsync()
    {
        Renewal.Clear();
        try
        {
            await IntakeSessions.ClearAsync();
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or OperationCanceledException)
        {
            Logger.LogWarning(ex, "Could not clear the intake session during Web sign-out.");
        }

        Logger.LogInformation("Web user initiated logout");
        Navigation.NavigateTo("/auth/logout", forceLoad: true, replace: true);
    }
}
