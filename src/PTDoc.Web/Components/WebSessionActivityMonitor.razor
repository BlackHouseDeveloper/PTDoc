@using Microsoft.AspNetCore.Components.Authorization
@using PTDoc.Web.Auth
@implements IAsyncDisposable
@inject AuthenticationStateProvider Authentication
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject WebCircuitSessionState SessionState

@if (_endedReason is not null)
{
    <div class="alert alert-warning" role="alert">
        @if (_endedReason == "SessionChanged")
        {
            <p>Sign-in changed in another tab. Reload to continue with that session.</p>
        }
        else
        {
            <p>Your session ended. Sign in again to continue.</p>
        }
        <button type="button" class="btn btn--secondary" @onclick="ContinueWithSession">@(_endedReason == "SessionChanged" ? "Reload session" : "Sign in")</button>
    </div>
}

@code {
    private IJSObjectReference? _module;
    private DotNetObjectReference<WebSessionActivityMonitor>? _reference;
    private string? _endedReason;
    private bool _disposed;

    protected override void OnInitialized()
    {
        _endedReason = SessionState.EndedReason;
        SessionState.Changed += OnSessionChanged;
    }

    private void OnSessionChanged() => _ = InvokeAsync(() =>
    {
        if (_disposed) return;
        _endedReason = SessionState.EndedReason;
        StateHasChanged();
    });

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var user = (await Authentication.GetAuthenticationStateAsync()).User;
        var sessionId = user.FindFirst(WebSessionActivity.SessionIdClaim)?.Value;
        if (_disposed || user.Identity?.IsAuthenticated != true || !WebSessionActivity.IsLocal(user) || string.IsNullOrEmpty(sessionId)) return;
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/sessionActivity.js");
            if (_disposed) { await _module.DisposeAsync(); return; }
            _reference = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("start", sessionId, _reference);
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
    }

    [JSInvokable]
    public Task SessionEnded(string reason) => InvokeAsync(() =>
    {
        if (_disposed) return;
        SessionState.End(reason);
    });

    private void ContinueWithSession() => Navigation.NavigateTo(
        _endedReason == "SessionChanged" ? Navigation.Uri : "/login?session_expired=1", forceLoad: true);

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        SessionState.Changed -= OnSessionChanged;
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("stop"); await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
            catch (TaskCanceledException) { }
        }
        _reference?.Dispose();
    }
}
