# Copy this file to .env, replace every placeholder, then load it with:
# set -a; source .env; set +a

PTDOC_UI_QA_REQUIRE_FULL_FIXTURES=true
PTDOC_WEB_BASE_URL=https://ptdoc.bhdevsites.com
PTDOC_UI_QA_API_BASE_URL=https://api-ptdoc.bhdevsites.com
PTDOC_UI_QA_CHROME_CHANNEL=chrome

PTDOC_UI_QA_PIN=REPLACE_WITH_CURRENT_BETA_PIN
PTDOC_UI_QA_USERNAME=REPLACE_WITH_GENERAL_BETA_USERNAME
PTDOC_UI_QA_ADMIN_USERNAME=REPLACE_WITH_ADMIN_BETA_USERNAME
PTDOC_UI_QA_PT_USERNAME=REPLACE_WITH_PT_BETA_USERNAME
PTDOC_UI_QA_PTA_USERNAME=REPLACE_WITH_PTA_BETA_USERNAME
PTDOC_UI_QA_PATIENT_USERNAME=REPLACE_WITH_PATIENT_BETA_USERNAME

PTDOC_UI_QA_PATIENT_CHART_PATH=/patient/REPLACE_WITH_DISPOSABLE_PATIENT_ID
PTDOC_UI_QA_INTAKE_PATH=/intake/REPLACE_WITH_SAFE_EDITABLE_INTAKE_ID
PTDOC_UI_QA_NOTE_WORKSPACE_PATH=/patient/REPLACE_WITH_PATIENT_ID/notes/REPLACE_WITH_NOTE_ID
PTDOC_UI_QA_WRITABLE_NOTE_WORKSPACE_PATH=/patient/REPLACE_WITH_PATIENT_ID/notes/REPLACE_WITH_SAFE_DRAFT_NOTE_ID
PTDOC_UI_QA_EVALUATION_DRAFT_PATH=/patient/REPLACE_WITH_PATIENT_ID/note/REPLACE_WITH_REVERSIBLE_EVALUATION_ID
